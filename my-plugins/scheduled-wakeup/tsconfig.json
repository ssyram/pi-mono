{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
