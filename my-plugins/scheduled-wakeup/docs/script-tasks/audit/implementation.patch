@@ -0,0 +1,6 @@
+import type { TaskRun } from "./task-spec.js";
+
+export function renderTaskRun(run: TaskRun, expanded: boolean): string {
+	const label = `Loop · 唤醒 ID: ${run.wakeUpId} · 成功 ${run.successCount}/${run.results.length} · ${run.shouldWake ? "触发唤醒" : "不触发唤醒"}`;
+	return expanded ? `${label}\n${run.content}` : label;
+}
diff --git a/my-plugins/scheduled-wakeup/src/script-tasks/run-script.ts b/my-plugins/scheduled-wakeup/src/script-tasks/run-script.ts
new file mode 100644
index 000000000..3b6882d49
--- /dev/null
+++ b/my-plugins/scheduled-wakeup/src/script-tasks/run-script.ts
@@ -0,0 +1,92 @@
+import { type ChildProcessByStdio, spawn } from "node:child_process";
+import type { Readable } from "node:stream";
+import { killScriptGroup } from "./kill-script-group.js";
+import { armScriptTimeout } from "./script-timeout.js";
+import type { ScriptResult, ScriptSpec } from "./task-spec.js";
+
+export function runScript(script: ScriptSpec): Promise<ScriptResult> {
+	if (process.platform === "win32")
+		return Promise.resolve(
+			startFailure(script, "POSIX process groups are required."),
+		);
+	return new Promise((resolve) => {
+		let child: ChildProcessByStdio<null, Readable, Readable>;
+		try {
+			child = spawn(script.path, [...script.params], {
+				cwd: script.cwd,
+				shell: false,
+				detached: true,
+				stdio: ["ignore", "pipe", "pipe"],
+			});
+		} catch (error) {
+			resolve(
+				startFailure(
+					script,
+					error instanceof Error ? error.message : String(error),
+				),
+			);
+			return;
+		}
+		let stdout = "";
+		let stderr = "";
+		let settled = false;
+		let timedOut = false;
+		let terminationError: string | null = null;
+		let cancelTimeout: (() => void) | undefined;
+		const finish = (
+			status: ScriptResult["status"],
+			exitCode: number | null,
+			signal: string | null,
+			error: string | null,
+		): void => {
+			if (settled) return;
+			settled = true;
+			cancelTimeout?.();
+			child.stdout.destroy();
+			child.stderr.destroy();
+			resolve({ script, status, exitCode, signal, stdout, stderr, error });
+		};
+		child.stdout.setEncoding("utf8").on("data", (chunk: string) => {
+			stdout += chunk;
+		});
+		child.stderr.setEncoding("utf8").on("data", (chunk: string) => {
+			stderr += chunk;
+		});
+		child.once("spawn", () => {
+			cancelTimeout = armScriptTimeout(script.timeoutSeconds, () => {
+				timedOut = true;
+				terminationError = killScriptGroup(child.pid);
+			});
+		});
+		child.once("error", (error) => {
+			const cleanupError = killScriptGroup(child.pid);
+			const message =
+				cleanupError === null
+					? error.message
+					: `${error.message}; cleanup: ${cleanupError}`;
+			finish(timedOut ? "timeout" : "start-failed", null, null, message);
+		});
+		child.once("close", (code, signal) => {
+			if (settled) return;
+			const error = timedOut ? terminationError : killScriptGroup(child.pid);
+			const status = timedOut
+				? "timeout"
+				: code === 0 && signal === null && error === null
+					? "success"
+					: "failed";
+			finish(status, code, signal, error);
+		});
+	});
+}
+
+function startFailure(script: ScriptSpec, error: string): ScriptResult {
+	return {
+		script,
+		status: "start-failed",
+		exitCode: null,
+		signal: null,
+		stdout: "",
+		stderr: "",
+		error,
+	};
+}
diff --git a/my-plugins/scheduled-wakeup/src/script-tasks/script-timeout.ts b/my-plugins/scheduled-wakeup/src/script-tasks/script-timeout.ts
new file mode 100644
index 000000000..93695459c
--- /dev/null
+++ b/my-plugins/scheduled-wakeup/src/script-tasks/script-timeout.ts
@@ -0,0 +1,25 @@
+const MAX_TIMEOUT_MS = 2_147_483_647;
+
+export function armScriptTimeout(
+	seconds: number | null,
+	onTimeout: () => void,
+): () => void {
+	if (seconds === null) return () => {};
+	let remaining = seconds * 1000;
+	let cancelled = false;
+	let timer: ReturnType<typeof setTimeout>;
+	const arm = (): void => {
+		const slice = Math.min(remaining, MAX_TIMEOUT_MS);
+		timer = setTimeout(() => {
+			if (cancelled) return;
+			remaining -= slice;
+			if (remaining > 0) arm();
+			else onTimeout();
+		}, slice);
+	};
+	arm();
+	return () => {
+		cancelled = true;
+		clearTimeout(timer);
+	};
+}
diff --git a/my-plugins/scheduled-wakeup/src/script-tasks/task-spec.ts b/my-plugins/scheduled-wakeup/src/script-tasks/task-spec.ts
new file mode 100644
