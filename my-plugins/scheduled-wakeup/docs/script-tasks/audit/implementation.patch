@@ -0,0 +1,42 @@
+export const DEFAULT_SCRIPT_TIMEOUT_SECONDS = 1800;
+
+export type WakeUpSetting =
+	| { kind: "never" }
+	| { kind: "always"; prompt: string }
+	| { kind: "on-error"; aggregation: "and" | "or"; prompt: string };
+
+export type ScriptSpec = {
+	cwd: string;
+	path: string;
+	params: readonly string[];
+	timeoutSeconds: number | null;
+};
+
+export type ScriptTask = {
+	wakeUp: WakeUpSetting;
+	scripts: readonly ScriptSpec[];
+};
+
+export type PreparationResult =
+	| { ok: true; task: ScriptTask }
+	| { ok: false; error: string };
+
+export type ScriptResult = {
+	script: ScriptSpec;
+	status: "success" | "failed" | "timeout" | "start-failed";
+	exitCode: number | null;
+	signal: string | null;
+	stdout: string;
+	stderr: string;
+	error: string | null;
+};
+
+export type ScriptRunner = (script: ScriptSpec) => Promise<ScriptResult>;
+
+export type TaskRun = {
+	wakeUpId: string;
+	results: readonly ScriptResult[];
+	successCount: number;
+	shouldWake: boolean;
+	content: string;
+};
diff --git a/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-content.ts b/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-content.ts
new file mode 100644
index 000000000..a9ffb4342
--- /dev/null
+++ b/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-content.ts
@@ -0,0 +1,39 @@
+import type { ScriptResult, ScriptTask } from "./task-spec.js";
+
+export function buildWakeUpContent(
+	task: ScriptTask,
+	results: readonly ScriptResult[],
+): string {
+	const prompt = task.wakeUp.kind === "never" ? "" : task.wakeUp.prompt;
+	const blocks = results.map((result) =>
+		[
+			`<script="${escapeMarkup(result.script.path)}", exit-code="${result.exitCode ?? "unavailable"}">`,
+			...(result.status === "success" ? [] : ["*** FAILED ***"]),
+			`status: ${result.status}`,
+			`cwd: ${escapeMarkup(result.script.cwd)}`,
+			`params: ${escapeMarkup(JSON.stringify(result.script.params))}`,
+			`signal: ${escapeMarkup(result.signal ?? "none")}`,
+			`error: ${escapeMarkup(result.error ?? "none")}`,
+			`stdout:\n${escapeMarkup(result.stdout)}`,
+			`stderr:\n${escapeMarkup(result.stderr)}`,
+			"</script>",
+		].join("\n"),
+	);
+	return [
+		"<SYSTEM:loop-wakeup>",
+		"This reminder was generated automatically by the system, NOT sent by the user.",
+		"<prompts>",
+		escapeMarkup(prompt),
+		"</prompts>",
+		...blocks,
+		"</SYSTEM:loop-wakeup>",
+	].join("\n");
+}
+
+function escapeMarkup(text: string): string {
+	return text
+		.replaceAll("&", "&amp;")
+		.replaceAll("<", "&lt;")
+		.replaceAll(">", "&gt;")
+		.replaceAll('"', "&quot;");
+}
diff --git a/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-policy.ts b/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-policy.ts
new file mode 100644
index 000000000..b42de4230
--- /dev/null
+++ b/my-plugins/scheduled-wakeup/src/script-tasks/wake-up-policy.ts
@@ -0,0 +1,13 @@
+import type { ScriptResult, WakeUpSetting } from "./task-spec.js";
+
+export function shouldWakeUp(
+	setting: WakeUpSetting,
+	results: readonly ScriptResult[],
+): boolean {
+	if (setting.kind === "never") return false;
+	if (setting.kind === "always") return true;
+	if (results.length === 0) return false;
+	return setting.aggregation === "or"
+		? results.some((result) => result.status !== "success")
+		: results.every((result) => result.status !== "success");
+}
