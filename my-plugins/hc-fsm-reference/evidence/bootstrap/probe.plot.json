        {"tool":"fsm_fsm_get_var_pending","arguments":{"key":"increment"},"json":true,"capture":["toolCallId","toolName","content","isError"],"expect":[{"path":"/isError","equals":false},{"path":"/json/value","equals":"7","regex":"(7)","bind":"increment"}]},
