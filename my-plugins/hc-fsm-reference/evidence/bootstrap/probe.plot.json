        {"tool":"fsm_fsm_try_transition","arguments":{"target":"_fsm_exit"},"capture":["toolCallId","toolName","content","isError"],"expect":[{"path":"/isError","equals":false},{"path":"/text","contains":"accept"}]}
      ]
