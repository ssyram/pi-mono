new file mode 100644
index 000000000..962cab2e8
--- /dev/null
+++ b/src/binding/parent-chain.ts
@@ -0,0 +1,24 @@
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import type { BindingRecords } from "./actor-binding.ts";
+
+export function parentDepth(rootSessionId: string, sessionId: string, records: BindingRecords): AdmissionResult<number> {
+	const seen = new Set<string>();
+	let current = sessionId;
+	let depth = 0;
+	for (;;) {
+		if (seen.has(current)) return rejected("parent-cycle");
+		seen.add(current);
+		const record = records.find(current);
+		if (!record) return rejected("parent-not-found");
+		const binding = record.binding;
+		if (binding.sessionId !== current || binding.rootSessionId !== rootSessionId) return rejected("binding-mismatch");
+		if (binding.kind === "execution-root") {
+			return current === rootSessionId && binding.agentId === "main" && binding.parentSessionId === null
+				? admitted(depth)
+				: rejected("binding-mismatch");
+		}
+		if (binding.agentId !== current || binding.agentId === "main" || current === rootSessionId) return rejected("binding-mismatch");
+		current = binding.parentSessionId;
+		depth++;
+	}
+}
diff --git a/src/binding/read-persisted-binding.ts b/src/binding/read-persisted-binding.ts
new file mode 100644
index 000000000..d08bce8cb
--- /dev/null
+++ b/src/binding/read-persisted-binding.ts
@@ -0,0 +1,64 @@
+import { isAbsolute } from "node:path";
+import { FSM_COMPATIBLE_EXTENSION_ID, MAX_REQUIRED_EXTENSIONS, REQUIRED_EXTENSION_ID_PATTERN } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { isAdmissionIdentifier, isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { isDataArray } from "../admission/data-array.ts";
+import { BINDING_CUSTOM_TYPE, type BindingEntry, type PersistedBinding } from "./actor-binding.ts";
+
+export function readPersistedBinding(
+	entries: readonly BindingEntry[],
+	actualSessionId: string,
+): AdmissionResult<PersistedBinding | null> {
+	// Step P7: absence and corruption are distinct, including the original mandatory baseline.
+	let found = false;
+	let data: unknown;
+	for (const entry of entries) {
+		if (entry.type === "custom" && entry.customType === BINDING_CUSTOM_TYPE) {
+			found = true;
+			data = entry.data;
+		}
+	}
+	if (!found) return admitted(null);
+	if (!isAdmissionObject(data)) return rejected("binding-mismatch");
+	const keys = ["version", "rootSessionId", "sessionId", "parentSessionId", "agentId", "kind", "agentName", "bootstrapRef", "requiredExtensions"];
+	if (Object.keys(data).some((key) => !keys.includes(key)) || data.version !== 1) return rejected("binding-mismatch");
+	if (!isAdmissionIdentifier(data.rootSessionId) || !isAdmissionIdentifier(data.sessionId) || !isAdmissionIdentifier(data.agentId)) {
+		return rejected("binding-mismatch");
+	}
+	if (data.sessionId !== actualSessionId || !isDataArray(data.requiredExtensions)
+		|| data.requiredExtensions.length < 1 || data.requiredExtensions.length > MAX_REQUIRED_EXTENSIONS) return rejected("binding-mismatch");
+	const extensions: { readonly id: string; readonly path: string }[] = [];
+	const ids = new Set<string>();
+	const paths = new Set<string>();
+	for (const item of data.requiredExtensions) {
+		if (!isAdmissionObject(item) || Object.keys(item).some((key) => key !== "id" && key !== "path")) return rejected("binding-mismatch");
+		if (!isAdmissionIdentifier(item.id) || !REQUIRED_EXTENSION_ID_PATTERN.test(item.id)
+			|| !isAdmissionIdentifier(item.path) || !isAbsolute(item.path) || ids.has(item.id) || paths.has(item.path)) return rejected("binding-mismatch");
+		ids.add(item.id);
+		paths.add(item.path);
+		extensions.push(Object.freeze({ id: item.id, path: item.path }));
+	}
+	if (!ids.has(FSM_COMPATIBLE_EXTENSION_ID)) return rejected("binding-mismatch");
+	const identity = {
+		version: 1 as const,
+		rootSessionId: data.rootSessionId,
+		sessionId: data.sessionId,
+		agentId: data.agentId,
+		requiredExtensions: Object.freeze(extensions),
+	};
+	if (data.kind === "execution-root") {
+		if (data.sessionId !== data.rootSessionId || data.agentId !== "main" || data.parentSessionId !== null
+			|| data.agentName !== null || data.bootstrapRef !== null) return rejected("binding-mismatch");
+		return admitted(Object.freeze({ ...identity, kind: "execution-root", parentSessionId: null, agentName: null, bootstrapRef: null }));
+	}
+	if (data.kind !== "execution-child" || data.agentId !== data.sessionId || data.agentId === "main" || data.sessionId === data.rootSessionId
+		|| !isAdmissionIdentifier(data.parentSessionId) || data.parentSessionId === data.sessionId
+		|| !isAdmissionIdentifier(data.agentName) || !isAdmissionIdentifier(data.bootstrapRef)) return rejected("binding-mismatch");
+	return admitted(Object.freeze({
+		...identity,
+		kind: "execution-child",
+		parentSessionId: data.parentSessionId,
+		agentName: data.agentName,
+		bootstrapRef: data.bootstrapRef,
+	}));
+}
diff --git a/src/binding/restore-actor-binding.ts b/src/binding/restore-actor-binding.ts
new file mode 100644
index 000000000..34f9b1be1
--- /dev/null
+++ b/src/binding/restore-actor-binding.ts
@@ -0,0 +1,33 @@
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { BINDING_CUSTOM_TYPE, type BindingRecords, type PersistedBinding } from "./actor-binding.ts";
+import { parentDepth } from "./parent-chain.ts";
+import { readPersistedBinding } from "./read-persisted-binding.ts";
+
+export function restoreActorBinding(
+	policy: AdmissionPolicy,
+	saved: PersistedBinding,
+	actualSessionId: string,
+	callerRoot: string,
+	records: BindingRecords,
+): AdmissionResult<PersistedBinding> {
+	// Step P7: validate the saved baseline, never derive it from the current policy.
+	const checked = readPersistedBinding([{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: saved }], actualSessionId);
+	if (!checked.ok || !checked.value || checked.value.rootSessionId !== callerRoot) return rejected("restore-conflict");
+	const binding = checked.value;
+	for (const original of binding.requiredExtensions) {
+		if (!policy.requiredExtensions.some((item) => item.id === original.id && item.path === original.path && item.requireForAllRunners === true)) {
+			return rejected("restore-conflict");
+		}
+	}
+	if (binding.kind === "execution-child") {
+		if (!policy.agents.some((agent) => agent.canonicalName === binding.agentName)) return rejected("restore-conflict");
+		const depth = parentDepth(callerRoot, binding.parentSessionId, records);
+		if (!depth.ok || depth.value >= policy.maxDepth) return rejected("restore-conflict");
+	}
+	// Root does not have a child agentName or parent; its identity was checked above.
+	return admitted(Object.freeze({
+		...binding,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+	}));
+}
diff --git a/test/actor-binding.test.ts b/test/actor-binding.test.ts
new file mode 100644
index 000000000..d9ec6c121
--- /dev/null
+++ b/test/actor-binding.test.ts
@@ -0,0 +1,132 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { BINDING_CUSTOM_TYPE, type BindingEntry } from "../src/binding/actor-binding.ts";
+import { bindNewChild } from "../src/binding/bind-new-child.ts";
+import { createRootBinding } from "../src/binding/create-root-binding.ts";
+import { parentDepth } from "../src/binding/parent-chain.ts";
+import { readPersistedBinding } from "../src/binding/read-persisted-binding.ts";
+import { restoreActorBinding } from "../src/binding/restore-actor-binding.ts";
+import { child, expectCode, extraExtension, pending, policy, records, root, selfExtension, unwrap } from "./admission-fixtures.ts";
+
+function entries(data: unknown): BindingEntry[] {
+	return [{ type: "custom", customType: BINDING_CUSTOM_TYPE, data }];
+}
+
+test("root binding includes the original non-secret mandatory baseline", () => {
+	const source = policy([], [selfExtension, extraExtension]);
+	const binding = createRootBinding("r", source);
+	assert.equal(binding.agentId, "main");
+	assert.equal(binding.parentSessionId, null);
+	assert.equal(binding.agentName, null);
+	assert.deepEqual(binding.requiredExtensions, [{ id: "fsm-compatible", path: "/plugin/index.ts" }, { id: "extra", path: "/plugin/extra.ts" }]);
+	assert.ok(Object.isFrozen(binding) && Object.isFrozen(binding.requiredExtensions));
+	assert.throws(() => createRootBinding(" r", source));
+});
+
+test("missing and damaged saved bindings are never conflated", () => {
+	assert.equal(unwrap(readPersistedBinding([], "r")), null);
+	assert.equal(unwrap(readPersistedBinding([{ type: "custom_message", customType: BINDING_CUSTOM_TYPE }], "r")), null);
+	const binding = root();
+	for (const key of Object.keys(binding)) {
+		const damaged: Record<string, unknown> = { ...binding };
+		delete damaged[key];
+		expectCode(readPersistedBinding(entries(damaged), "r"), "binding-mismatch");
+	}
+	for (const damaged of [null, { ...binding, version: 2 }, { ...binding, sessionId: "other" },
+		{ ...binding, requiredExtensions: [] }, { ...binding, token: "not-allowed" },
+		{ ...binding, requiredExtensions: [{ id: "fsm-compatible", path: "relative.ts" }] },
+		{ ...binding, requiredExtensions: [{ id: "fsm-compatible", path: "/a" }, { id: "fsm-compatible", path: "/b" }] }]) {
+		expectCode(readPersistedBinding(entries(damaged), "r"), "binding-mismatch");
+	}
+	assert.deepEqual(unwrap(readPersistedBinding(entries(binding), "r")), binding);
+	assert.deepEqual(unwrap(readPersistedBinding(entries(child()), "c")), child());
+	expectCode(readPersistedBinding(entries(child("r", "main")), "main"), "binding-mismatch");
+});
+
+test("only latest binding on the provided real branch is considered", () => {
+	const binding = root();
+	expectCode(readPersistedBinding([...entries(binding), ...entries({})], "r"), "binding-mismatch");
+	assert.deepEqual(unwrap(readPersistedBinding([...entries({}), ...entries(binding)], "r")), binding);
+});
+
+test("B2: legitimate root restores without child allowlist or parent lookup", () => {
+	const source = policy([], [selfExtension, extraExtension]);
+	const saved = root(source);
+	let lookups = 0;
+	const empty = { find: () => { lookups++; return undefined; } };
+	assert.deepEqual(unwrap(restoreActorBinding(source, saved, "r", "r", empty)), saved);
+	assert.equal(lookups, 0);
+	expectCode(restoreActorBinding(source, saved, "r", "other", empty), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "other", "r", empty), "restore-conflict");
+});
+
+test("B1: original mandatory deletion/replacement is rejected; additions become the next baseline", () => {
+	const original = policy([], [selfExtension, extraExtension]);
+	const saved = root(original);
+	const empty = records();
+	expectCode(restoreActorBinding(policy([]), saved, "r", "r", empty), "restore-conflict");
+	const replaced = { ...extraExtension, path: "/plugin/replaced.ts" };
+	expectCode(restoreActorBinding(policy([], [selfExtension, replaced]), saved, "r", "r", empty), "restore-conflict");
+	const added = { id: "added", path: "/plugin/added.ts", requireForAllRunners: true as const };
+	const expanded = policy([], [selfExtension, extraExtension, added]);
+	const next = unwrap(restoreActorBinding(expanded, saved, "r", "r", empty));
+	assert.equal(saved.requiredExtensions.length, 2);
+	assert.equal(next.requiredExtensions.length, 3);
+	expectCode(restoreActorBinding(original, next, "r", "r", empty), "restore-conflict");
+	const savedChild = child("r", "c", policy(["a"], [selfExtension, extraExtension]));
+	expectCode(restoreActorBinding(policy(), savedChild, "c", "r", records(root())), "restore-conflict");
+});
+
+test("child restore retains every identity field and validates actual parent/agent/depth", () => {
+	const source = policy();
+	const saved = child();
+	const tree = records(root());
+	assert.deepEqual(unwrap(restoreActorBinding(source, saved, "c", "r", tree)), saved);
+	expectCode(restoreActorBinding(policy([]), saved, "c", "r", tree), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "c", "r", records()), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "c", "other", tree), "restore-conflict");
+	expectCode(restoreActorBinding(source, { ...saved, agentId: "new-run-id" }, "c", "r", tree), "restore-conflict");
+	const deep = child("c", "d");
+	expectCode(restoreActorBinding(policy(["a"], [selfExtension], 1), deep, "d", "r", records(root(), saved)), "restore-conflict");
+});
+
+test("new launch binds one actual self and failure has no registration mutation", () => {
+	const source = policy();
+	const launch = pending(source);
+	const tree = records(root(source));
+	const reserved = pending(source);
+	expectCode(bindNewChild(source, reserved, "main", [], tree), "binding-mismatch");
+	assert.equal(reserved.state, "allocated");
+	const bound = unwrap(bindNewChild(source, launch, "c", [], tree));
+	assert.equal(launch.state, "registered");
+	assert.equal(launch.registeredSessionId, "c");
+	assert.equal(bound.agentId, "c");
+	assert.deepEqual(unwrap(bindNewChild(source, launch, "c", [], tree)), bound);
+	expectCode(bindNewChild(source, launch, "d", [], tree), "binding-mismatch");
+	assert.equal(launch.registeredSessionId, "c");
+	for (const run of [pending(source), { ...pending(source), state: "cancelled" as const }]) {
+		const before = { ...run };
+		const result = bindNewChild(source, run, "c", entries({}), tree);
+		assert.equal(result.ok, false);
+		assert.deepEqual(run, before);
+	}
+});
+
+test("existing saved binding goes through restore, never new fallback", () => {
+	const source = policy();
+	const launch = pending(source);
+	const saved = child();
+	assert.deepEqual(unwrap(bindNewChild(source, launch, "c", entries(saved), records(root()))), saved);
+	const different = pending(source);
+	expectCode(bindNewChild(source, different, "c", entries({ ...saved, parentSessionId: "missing" }), records(root())), "binding-mismatch");
+	assert.equal(different.state, "allocated");
+});
+
+test("finite parent chains terminate on missing, cross-root and cycles", () => {
+	assert.equal(unwrap(parentDepth("r", "r", records(root()))), 0);
+	assert.equal(unwrap(parentDepth("r", "d", records(root(), child(), child("c", "d")))), 2);
+	expectCode(parentDepth("r", "missing", records(root())), "parent-not-found");
+	expectCode(parentDepth("other", "c", records(root(), child())), "binding-mismatch");
+	expectCode(parentDepth("r", "main", records(root(), child("r", "main"))), "binding-mismatch");
+	expectCode(parentDepth("r", "c", records(child("d", "c"), child("c", "d"))), "parent-cycle");
+});
