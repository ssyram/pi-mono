+++ b/src/admission/admission-policy.ts
@@ -0,0 +1,44 @@
+export const FSM_COMPATIBLE_EXTENSION_ID = "fsm-compatible";
+export const MAX_REQUIRED_EXTENSIONS = 32;
+export const REQUIRED_EXTENSION_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/;
+
+export interface RequiredExtensionInput {
+	readonly id: string;
+	readonly path: string;
+}
+
+export interface RequiredExtension extends RequiredExtensionInput {
+	readonly requireForAllRunners: true;
+}
+
+export interface PolicyInput {
+	readonly allowedAgentNames: readonly string[];
+	readonly requiredExtensions: readonly RequiredExtensionInput[];
+	readonly maxDepth: number;
+}
+
+export type JsonValue = null | boolean | number | string | readonly JsonValue[] | JsonObject;
+export interface JsonObject {
+	readonly [key: string]: JsonValue;
+}
+
+export interface ResolvedAgent {
+	readonly canonicalName: string;
+	readonly runtimeName: string;
+	readonly runnerType?: string;
+	readonly machine?: string;
+	readonly definitionSnapshot: JsonObject;
+	readonly declaredToolCeiling: readonly string[] | null;
+}
+
+export interface AdmissionPolicy {
+	readonly agents: readonly ResolvedAgent[];
+	readonly requiredExtensions: readonly RequiredExtension[];
+	readonly maxDepth: number;
+}
+
+export interface LaunchRequest {
+	readonly agentName: string;
+	readonly executionMode: "sync" | "async";
+	readonly resumeSessionFile?: string;
+}
diff --git a/src/admission/admission-result.ts b/src/admission/admission-result.ts
new file mode 100644
index 000000000..80f4ce4b7
--- /dev/null
+++ b/src/admission/admission-result.ts
@@ -0,0 +1,25 @@
+export const ADMISSION_ERROR_CODES = [
+	"invalid-input",
+	"agent-not-admitted",
+	"runner-not-admitted",
+	"required-extension-mismatch",
+	"policy-widened",
+	"binding-mismatch",
+	"parent-not-found",
+	"parent-cycle",
+	"depth-exceeded",
+	"restore-conflict",
+] as const;
+
+export type AdmissionErrorCode = (typeof ADMISSION_ERROR_CODES)[number];
+export type AdmissionResult<T> =
+	| { readonly ok: true; readonly value: T }
+	| { readonly ok: false; readonly code: AdmissionErrorCode };
+
+export function admitted<T>(value: T): AdmissionResult<T> {
+	return Object.freeze({ ok: true, value });
+}
+
+export function rejected(code: AdmissionErrorCode): AdmissionResult<never> {
+	return Object.freeze({ ok: false, code });
+}
diff --git a/src/admission/admit-child-launch.ts b/src/admission/admit-child-launch.ts
new file mode 100644
index 000000000..0d37ba746
--- /dev/null
+++ b/src/admission/admit-child-launch.ts
@@ -0,0 +1,78 @@
+import type { AuthenticatedCaller, BindingRecords, PersistedBinding } from "../binding/actor-binding.ts";
+import { parentDepth } from "../binding/parent-chain.ts";
+import { restoreActorBinding } from "../binding/restore-actor-binding.ts";
+import type { AdmissionPolicy, LaunchRequest, RequiredExtension } from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+import { isAdmissionIdentifier, isAdmissionObject } from "./parse-policy-input.ts";
+
+export interface ChildToolLoadout {
+	readonly availableToolNames: readonly string[];
+	readonly requiredToolNames: readonly string[];
+}
+
+export interface ResumeAdmission {
+	readonly saved: PersistedBinding;
+	readonly actualSessionId: string;
+}
+
+export interface AdmittedChildLaunch {
+	readonly rootSessionId: string;
+	readonly callerSessionId: string;
+	readonly agentName: string;
+	readonly runtimeName: string;
+	readonly bootstrapRef: null;
+	readonly executionMode: "sync" | "async";
+	readonly resumeSessionFile: string | null;
+	readonly requiredExtensions: readonly RequiredExtension[];
+	readonly allowedToolNames: readonly string[];
+}
+
+export function admitChildLaunch(
+	policy: AdmissionPolicy,
+	caller: AuthenticatedCaller,
+	value: unknown,
+	records: BindingRecords,
+	tools: ChildToolLoadout,
+	resume?: ResumeAdmission,
+): AdmissionResult<AdmittedChildLaunch> {
+	// Step P5: request fields cannot carry identity, policy, or an internal bypass.
+	if (!isAdmissionObject(value) || Object.keys(value).some((key) => !["agentName", "executionMode", "resumeSessionFile"].includes(key))) {
+		return rejected("invalid-input");
+	}
+	if (!isAdmissionIdentifier(value.agentName) || (value.executionMode !== "sync" && value.executionMode !== "async")
+		|| ("resumeSessionFile" in value && !isAdmissionIdentifier(value.resumeSessionFile))) return rejected("invalid-input");
+	const request: LaunchRequest = {
+		agentName: value.agentName,
+		executionMode: value.executionMode,
+		...(typeof value.resumeSessionFile === "string" ? { resumeSessionFile: value.resumeSessionFile } : {}),
+	};
+	const depth = parentDepth(caller.rootSessionId, caller.sessionId, records);
+	if (!depth.ok) return depth;
+	if (depth.value >= policy.maxDepth) return rejected("depth-exceeded");
+	const agent = policy.agents.find((item) => item.canonicalName === request.agentName);
+	if (!agent) return rejected("agent-not-admitted");
+	if (agent.runnerType !== "pi" || agent.machine !== undefined) return rejected("runner-not-admitted");
+	if (tools.requiredToolNames.some((name) => !tools.availableToolNames.includes(name))) return rejected("invalid-input");
+	if (agent.declaredToolCeiling !== null && tools.requiredToolNames.some((name) => !agent.declaredToolCeiling?.includes(name))) {
+		return rejected("policy-widened");
+	}
+	if (request.resumeSessionFile !== undefined) {
+		if (!resume || resume.saved.kind !== "execution-child" || resume.saved.agentName !== agent.canonicalName) return rejected("restore-conflict");
+		const restored = restoreActorBinding(policy, resume.saved, resume.actualSessionId, caller.rootSessionId, records);
+		if (!restored.ok) return restored;
+	} else if (resume) {
+		return rejected("invalid-input");
+	}
+	const allowedToolNames = tools.availableToolNames.filter((name) => agent.declaredToolCeiling === null || agent.declaredToolCeiling.includes(name));
+	return admitted(Object.freeze({
+		rootSessionId: caller.rootSessionId,
+		callerSessionId: caller.sessionId,
+		agentName: agent.canonicalName,
+		runtimeName: agent.runtimeName,
+		bootstrapRef: null,
+		executionMode: request.executionMode,
+		resumeSessionFile: request.resumeSessionFile ?? null,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map((item) => Object.freeze({ ...item }))),
+		allowedToolNames: Object.freeze([...new Set(allowedToolNames)]),
+	}));
+}
diff --git a/src/admission/build-admission-policy.ts b/src/admission/build-admission-policy.ts
new file mode 100644
index 000000000..1932d1da1
--- /dev/null
+++ b/src/admission/build-admission-policy.ts
@@ -0,0 +1,44 @@
+import type { AdmissionPolicy, PolicyInput, RequiredExtension, ResolvedAgent } from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+import { isAdmissionIdentifier, isAdmissionObject } from "./parse-policy-input.ts";
+import { snapshotAgentDefinition } from "./snapshot-agent-definition.ts";
+import { isDataArray } from "./data-array.ts";
+
+export function buildAdmissionPolicy(
+	input: PolicyInput,
+	agents: readonly ResolvedAgent[],
+	extensions: readonly RequiredExtension[],
+): AdmissionResult<AdmissionPolicy> {
+	// Step P3: only the explicit canonical list selects definitions.
+	const selected: ResolvedAgent[] = [];
+	for (const name of input.allowedAgentNames) {
+		const matches = agents.filter((agent) => agent.canonicalName === name);
+		if (matches.length !== 1) return rejected("agent-not-admitted");
+		const candidate = matches[0];
+		if (!candidate || !isAdmissionIdentifier(candidate.runtimeName)) return rejected("invalid-input");
+		if ((candidate.runnerType !== undefined && candidate.runnerType !== "pi") || candidate.machine !== undefined) {
+			return rejected("runner-not-admitted");
+		}
+		const snapshot = snapshotAgentDefinition(candidate.definitionSnapshot);
+		if (!snapshot.ok) return snapshot;
+		const runner = snapshot.value.runner;
+		if (snapshot.value.machine !== undefined || (runner !== undefined && (
+			!isAdmissionObject(runner) || runner.type !== "pi" || Object.keys(runner).some((key) => key !== "type")
+		))) return rejected("runner-not-admitted");
+		if (candidate.declaredToolCeiling !== null && (!isDataArray(candidate.declaredToolCeiling) || !candidate.declaredToolCeiling.every(isAdmissionIdentifier))) {
+			return rejected("invalid-input");
+		}
+		selected.push(Object.freeze({
+			canonicalName: name,
+			runtimeName: candidate.runtimeName,
+			runnerType: "pi",
+			definitionSnapshot: snapshot.value,
+			declaredToolCeiling: candidate.declaredToolCeiling === null ? null : Object.freeze([...candidate.declaredToolCeiling]),
+		}));
+	}
+	return admitted(Object.freeze({
+		agents: Object.freeze(selected),
+		requiredExtensions: Object.freeze(extensions.map((extension) => Object.freeze({ ...extension }))),
+		maxDepth: input.maxDepth,
+	}));
+}
diff --git a/src/admission/canonicalize-required-extensions.ts b/src/admission/canonicalize-required-extensions.ts
new file mode 100644
index 000000000..6ebd6984f
--- /dev/null
+++ b/src/admission/canonicalize-required-extensions.ts
@@ -0,0 +1,55 @@
+import { realpathSync, statSync } from "node:fs";
+import { isAbsolute } from "node:path";
+import {
+	FSM_COMPATIBLE_EXTENSION_ID,
+	MAX_REQUIRED_EXTENSIONS,
+	REQUIRED_EXTENSION_ID_PATTERN,
+	type RequiredExtension,
+	type RequiredExtensionInput,
+} from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+import { isAdmissionIdentifier } from "./parse-policy-input.ts";
+
+export interface ExtensionFiles {
+	realpath(path: string): string;
+	isFile(path: string): boolean;
+}
+
+export const localExtensionFiles: ExtensionFiles = Object.freeze({
+	realpath: realpathSync,
+	isFile: (path: string) => statSync(path).isFile(),
+});
+
+export function canonicalizeRequiredExtensions(
+	input: readonly RequiredExtensionInput[],
+	selfPath: string,
+	files: ExtensionFiles = localExtensionFiles,
+): AdmissionResult<readonly RequiredExtension[]> {
+	// Step P2: inspect files without importing or executing any extension.
+	try {
+		const self = files.realpath(selfPath);
+		if (!isAdmissionIdentifier(self) || !isAbsolute(self) || !files.isFile(self)) return rejected("required-extension-mismatch");
+		const ids = new Set<string>();
+		const paths = new Set<string>();
+		const result: RequiredExtension[] = [];
+		for (const entry of input) {
+			if (!REQUIRED_EXTENSION_ID_PATTERN.test(entry.id) || !isAdmissionIdentifier(entry.path)) return rejected("required-extension-mismatch");
+			const path = files.realpath(entry.path);
+			if (!isAdmissionIdentifier(path) || !isAbsolute(path) || !files.isFile(path) || ids.has(entry.id) || paths.has(path)) {
+				return rejected("required-extension-mismatch");
+			}
+			if (entry.id === FSM_COMPATIBLE_EXTENSION_ID && path !== self) return rejected("required-extension-mismatch");
+			ids.add(entry.id);
+			paths.add(path);
+			result.push(Object.freeze({ id: entry.id, path, requireForAllRunners: true }));
+		}
+		if (!ids.has(FSM_COMPATIBLE_EXTENSION_ID)) {
+			if (paths.has(self)) return rejected("required-extension-mismatch");
+			result.push(Object.freeze({ id: FSM_COMPATIBLE_EXTENSION_ID, path: self, requireForAllRunners: true }));
+		}
+		if (result.length > MAX_REQUIRED_EXTENSIONS) return rejected("required-extension-mismatch");
+		return admitted(Object.freeze(result));
+	} catch {
+		return rejected("required-extension-mismatch");
+	}
+}
diff --git a/src/admission/data-array.ts b/src/admission/data-array.ts
new file mode 100644
index 000000000..1d0ced2db
--- /dev/null
+++ b/src/admission/data-array.ts
@@ -0,0 +1,8 @@
+export function isDataArray(value: unknown): value is unknown[] {
+	if (!Array.isArray(value) || Reflect.ownKeys(value).length !== value.length + 1) return false;
+	for (let index = 0; index < value.length; index++) {
+		const descriptor = Object.getOwnPropertyDescriptor(value, String(index));
+		if (!descriptor || descriptor.enumerable !== true || !("value" in descriptor)) return false;
+	}
+	return true;
+}
diff --git a/src/admission/narrow-admission-policy.ts b/src/admission/narrow-admission-policy.ts
new file mode 100644
index 000000000..11a9030d1
--- /dev/null
+++ b/src/admission/narrow-admission-policy.ts
@@ -0,0 +1,27 @@
+import type { AdmissionPolicy, PolicyInput, RequiredExtension } from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+
+export function narrowAdmissionPolicy(
+	parent: AdmissionPolicy,
+	requested: PolicyInput,
+	extensions: readonly RequiredExtension[],
+): AdmissionResult<AdmissionPolicy> {
+	// Step P4: retain parent definitions and all mandatory paths.
+	if (requested.maxDepth > parent.maxDepth) return rejected("policy-widened");
+	for (const extension of parent.requiredExtensions) {
+		if (!extensions.some((item) => item.id === extension.id && item.path === extension.path && item.requireForAllRunners === true)) {
+			return rejected("policy-widened");
+		}
+	}
+	const selected = [];
+	for (const name of requested.allowedAgentNames) {
+		const agent = parent.agents.find((item) => item.canonicalName === name);
+		if (!agent) return rejected("policy-widened");
+		selected.push(agent);
+	}
+	return admitted(Object.freeze({
+		agents: Object.freeze(selected),
+		requiredExtensions: Object.freeze(extensions.map((item) => Object.freeze({ ...item }))),
+		maxDepth: requested.maxDepth,
+	}));
+}
diff --git a/src/admission/parse-policy-input.ts b/src/admission/parse-policy-input.ts
new file mode 100644
index 000000000..ae5f91263
--- /dev/null
+++ b/src/admission/parse-policy-input.ts
@@ -0,0 +1,45 @@
+import { MAX_REQUIRED_EXTENSIONS, REQUIRED_EXTENSION_ID_PATTERN, type PolicyInput } from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+import { isDataArray } from "./data-array.ts";
+
+export function isAdmissionIdentifier(value: unknown): value is string {
+	return typeof value === "string" && /^\S(?:.*\S)?$/.test(value) && !value.includes("\0");
+}
+
+export function isAdmissionObject(value: unknown): value is Record<string, unknown> {
+	if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+	if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) return false;
+	return Reflect.ownKeys(value).every((key) => {
+		const descriptor = Object.getOwnPropertyDescriptor(value, key);
+		return typeof key === "string" && descriptor?.enumerable === true && "value" in descriptor;
+	});
+}
+
+export function parsePolicyInput(value: unknown): AdmissionResult<PolicyInput> {
+	// Step P1: reject unknown or non-JSON-shaped authority inputs.
+	if (!isAdmissionObject(value)) return rejected("invalid-input");
+	if (Object.keys(value).some((key) => !["allowedAgentNames", "requiredExtensions", "maxDepth"].includes(key))) {
+		return rejected("invalid-input");
+	}
+	const { allowedAgentNames, requiredExtensions, maxDepth } = value;
+	if (!isDataArray(allowedAgentNames) || !allowedAgentNames.every(isAdmissionIdentifier)) return rejected("invalid-input");
+	if (new Set(allowedAgentNames).size !== allowedAgentNames.length) return rejected("invalid-input");
+	if (!isDataArray(requiredExtensions) || requiredExtensions.length > MAX_REQUIRED_EXTENSIONS) return rejected("invalid-input");
+	if (typeof maxDepth !== "number" || !Number.isInteger(maxDepth) || maxDepth < 1) return rejected("invalid-input");
+	const extensions: { readonly id: string; readonly path: string }[] = [];
+	const ids = new Set<string>();
+	for (const entry of requiredExtensions) {
+		if (!isAdmissionObject(entry) || Object.keys(entry).some((key) => key !== "id" && key !== "path")) return rejected("invalid-input");
+		if (!isAdmissionIdentifier(entry.id) || !REQUIRED_EXTENSION_ID_PATTERN.test(entry.id) || !isAdmissionIdentifier(entry.path)) {
+			return rejected("invalid-input");
+		}
+		if (ids.has(entry.id)) return rejected("invalid-input");
+		ids.add(entry.id);
+		extensions.push(Object.freeze({ id: entry.id, path: entry.path }));
+	}
+	return admitted(Object.freeze({
+		allowedAgentNames: Object.freeze([...allowedAgentNames]),
+		requiredExtensions: Object.freeze(extensions),
+		maxDepth,
+	}));
+}
diff --git a/src/admission/snapshot-agent-definition.ts b/src/admission/snapshot-agent-definition.ts
new file mode 100644
index 000000000..103a1f180
--- /dev/null
+++ b/src/admission/snapshot-agent-definition.ts
@@ -0,0 +1,43 @@
+import type { JsonObject, JsonValue } from "./admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "./admission-result.ts";
+import { isAdmissionObject } from "./parse-policy-input.ts";
+import { isDataArray } from "./data-array.ts";
+
+function freezeValue(value: unknown, ancestors: Set<object>): AdmissionResult<JsonValue> {
+	if (value === null || typeof value === "string" || typeof value === "boolean") return admitted(value);
+	if (typeof value === "number") return Number.isFinite(value) ? admitted(value) : rejected("invalid-input");
+	if (typeof value !== "object" || ancestors.has(value)) return rejected("invalid-input");
+	ancestors.add(value);
+	try {
+		if (Array.isArray(value)) {
+			if (!isDataArray(value)) return rejected("invalid-input");
+			const result: JsonValue[] = [];
+			for (let i = 0; i < value.length; i++) {
+				const descriptor = Object.getOwnPropertyDescriptor(value, String(i));
+				if (!descriptor || !("value" in descriptor)) return rejected("invalid-input");
+				const frozen = freezeValue(descriptor.value, ancestors);
+				if (!frozen.ok) return frozen;
+				result.push(frozen.value);
+			}
+			return admitted(Object.freeze(result));
+		}
+		if (!isAdmissionObject(value)) return rejected("invalid-input");
+		const entries: [string, JsonValue][] = [];
+		for (const key of Object.keys(value)) {
+			const frozen = freezeValue(value[key], ancestors);
+			if (!frozen.ok) return frozen;
+			entries.push([key, frozen.value]);
+		}
+		return admitted(Object.freeze(Object.fromEntries(entries)));
+	} finally {
+		ancestors.delete(value);
+	}
+}
+
+export function snapshotAgentDefinition(value: unknown): AdmissionResult<JsonObject> {
+	if (!isAdmissionObject(value)) return rejected("invalid-input");
+	const frozen = freezeValue(value, new Set());
+	if (!frozen.ok) return frozen;
+	if (!isAdmissionObject(frozen.value)) return rejected("invalid-input");
+	return admitted(frozen.value as JsonObject);
+}
diff --git a/src/binding/actor-binding.ts b/src/binding/actor-binding.ts
new file mode 100644
index 000000000..be51912b8
--- /dev/null
+++ b/src/binding/actor-binding.ts
@@ -0,0 +1,55 @@
+import type { AdmissionPolicy, RequiredExtensionInput } from "../admission/admission-policy.ts";
+
+export interface BindingIdentity {
+	readonly version: 1;
+	readonly rootSessionId: string;
+	readonly sessionId: string;
+	readonly agentId: string;
+	readonly requiredExtensions: readonly RequiredExtensionInput[];
+}
+
+export interface RootBinding extends BindingIdentity {
+	readonly kind: "execution-root";
+	readonly parentSessionId: null;
+	readonly agentName: null;
+	readonly bootstrapRef: null;
+}
+
+export interface ChildBinding extends BindingIdentity {
+	readonly kind: "execution-child";
+	readonly parentSessionId: string;
+	readonly agentName: string;
+	readonly bootstrapRef: string;
+}
+
+export type PersistedBinding = RootBinding | ChildBinding;
+export const BINDING_CUSTOM_TYPE = "fsm-compatible:binding";
+
+export interface BindingRecord {
+	readonly binding: PersistedBinding;
+}
+
+export interface BindingRecords {
+	find(sessionId: string): BindingRecord | undefined;
+}
+
+export interface AuthenticatedCaller {
+	readonly rootSessionId: string;
+	readonly sessionId: string;
+}
+
+export interface PendingLaunch {
+	readonly rootSessionId: string;
+	readonly callerSessionId: string;
+	readonly agentName: string;
+	readonly bootstrapRef: string;
+	readonly policy: AdmissionPolicy;
+	state: "allocated" | "registered" | "acquired" | "failed" | "cancelled";
+	registeredSessionId: string | null;
+}
+
+export interface BindingEntry {
+	readonly type: string;
+	readonly customType?: string;
+	readonly data?: unknown;
+}
diff --git a/src/binding/bind-new-child.ts b/src/binding/bind-new-child.ts
new file mode 100644
index 000000000..72f59bd3b
--- /dev/null
+++ b/src/binding/bind-new-child.ts
@@ -0,0 +1,57 @@
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { isAdmissionIdentifier } from "../admission/parse-policy-input.ts";
+import type { BindingEntry, BindingRecords, PendingLaunch, PersistedBinding } from "./actor-binding.ts";
+import { parentDepth } from "./parent-chain.ts";
+import { readPersistedBinding } from "./read-persisted-binding.ts";
+import { restoreActorBinding } from "./restore-actor-binding.ts";
+
+export function bindNewChild(
+	policy: AdmissionPolicy,
+	pending: PendingLaunch,
+	actualSessionId: string,
+	entries: readonly BindingEntry[],
+	records: BindingRecords,
+): AdmissionResult<PersistedBinding> {
+	// Step P6: check everything before changing the launch's single actual identity.
+	if (pending.state === "failed" || pending.state === "cancelled" || !isAdmissionIdentifier(actualSessionId)
+		|| actualSessionId === pending.rootSessionId || actualSessionId === "main" || !isAdmissionIdentifier(pending.bootstrapRef)) return rejected("binding-mismatch");
+	if (pending.registeredSessionId !== null && pending.registeredSessionId !== actualSessionId) return rejected("binding-mismatch");
+	if (!policy.agents.some((agent) => agent.canonicalName === pending.agentName)) return rejected("agent-not-admitted");
+	for (const extension of pending.policy.requiredExtensions) {
+		if (!policy.requiredExtensions.some((item) => item.id === extension.id && item.path === extension.path && item.requireForAllRunners === true)) {
+			return rejected("required-extension-mismatch");
+		}
+	}
+	const depth = parentDepth(pending.rootSessionId, pending.callerSessionId, records);
+	if (!depth.ok) return depth;
+	if (depth.value >= policy.maxDepth) return rejected("depth-exceeded");
+	const saved = readPersistedBinding(entries, actualSessionId);
+	if (!saved.ok) return saved;
+	const existing = records.find(actualSessionId)?.binding;
+	if (existing && (existing.kind !== "execution-child" || existing.rootSessionId !== pending.rootSessionId
+		|| existing.parentSessionId !== pending.callerSessionId || existing.agentName !== pending.agentName
+		|| existing.bootstrapRef !== pending.bootstrapRef)) return rejected("binding-mismatch");
+	let result: AdmissionResult<PersistedBinding>;
+	if (saved.value) {
+		if (saved.value.kind !== "execution-child" || saved.value.parentSessionId !== pending.callerSessionId
+			|| saved.value.agentName !== pending.agentName || saved.value.bootstrapRef !== pending.bootstrapRef) return rejected("binding-mismatch");
+		result = restoreActorBinding(policy, saved.value, actualSessionId, pending.rootSessionId, records);
+	} else {
+		result = admitted(Object.freeze({
+			version: 1,
+			rootSessionId: pending.rootSessionId,
+			sessionId: actualSessionId,
+			agentId: actualSessionId,
+			kind: "execution-child",
+			parentSessionId: pending.callerSessionId,
+			agentName: pending.agentName,
+			bootstrapRef: pending.bootstrapRef,
+			requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+		}));
+	}
+	if (!result.ok) return result;
+	pending.registeredSessionId = actualSessionId;
+	if (pending.state === "allocated") pending.state = "registered";
+	return result;
+}
