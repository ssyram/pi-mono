index 000000000..ce6bf0a29
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts
@@ -0,0 +1,44 @@
+import { Ajv, type ValidateFunction } from "ajv";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { isDataArray } from "../admission/data-array.ts";
+import { isAdmissionObject, isAdmissionIdentifier } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { McpTransport, RpcOptions } from "./mcp-transport.ts";
+
+export interface FsmTool {
+	readonly name: string;
+	readonly description: string;
+	readonly inputSchema: Record<string, unknown>;
+	readonly validate: ValidateFunction;
+}
+
+export async function discoverFsmTools(transport: McpTransport, options: RpcOptions): Promise<ReadonlyMap<string, FsmTool>> {
+	const tools = new Map<string, FsmTool>();
+	const cursors = new Set<string>();
+	let cursor: string | undefined;
+	for (;;) {
+		const value = await transport.call("tools/list", cursor === undefined ? {} : { cursor }, options);
+		if (!isAdmissionObject(value) || !isDataArray(value.tools)) throw new RuntimeError("protocol-invalid");
+		for (const tool of value.tools) {
+			if (!isAdmissionObject(tool) || !isAdmissionIdentifier(tool.name) || tools.has(tool.name)
+				|| !isAdmissionObject(tool.inputSchema)) throw new RuntimeError("protocol-invalid");
+			const schema = tool.inputSchema;
+			const schemaVersion = schema.$schema;
+			if (schemaVersion !== undefined && typeof schemaVersion !== "string") throw new RuntimeError("protocol-invalid");
+			const engine = typeof schemaVersion === "string" && schemaVersion.includes("2020-12")
+				? new Ajv2020({ strict: false, allErrors: true, validateFormats: false })
+				: new Ajv({ strict: false, allErrors: true, validateFormats: false });
+			let validate: ValidateFunction;
+			try { validate = engine.compile(schema); } catch { throw new RuntimeError("protocol-invalid"); }
+			tools.set(tool.name, Object.freeze({ name: tool.name,
+				description: typeof tool.description === "string" ? tool.description : "FSM tool",
+				inputSchema: structuredClone(schema), validate }));
+		}
+		if (value.nextCursor === undefined) break;
+		if (typeof value.nextCursor !== "string" || !value.nextCursor || cursors.has(value.nextCursor)) throw new RuntimeError("protocol-invalid");
+		cursor = value.nextCursor;
+		cursors.add(cursor);
+	}
+	if (!tools.size) throw new RuntimeError("protocol-invalid");
+	return tools;
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-tools.ts b/my-plugins/fsm-compatible/src/broker/fsm-tools.ts
new file mode 100644
index 000000000..c5e74d7ee
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-tools.ts
@@ -0,0 +1,39 @@
+import type { ExtensionAPI, ExtensionToolContext } from "@earendil-works/pi-coding-agent";
+import type { PersistedBinding } from "../binding/actor-binding.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { FsmBroker } from "./fsm-broker.ts";
+import type { FsmTool } from "./fsm-catalog.ts";
+import { projectMcpToolResult } from "./mcp-tool-result.ts";
+
+export interface ProjectedToolOwner {
+	readonly broker: FsmBroker;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly timeoutMs: number;
+	ready(): boolean;
+	binding(ctx: ExtensionToolContext): PersistedBinding;
+}
+
+export function registerProjectedTools(pi: ExtensionAPI, owner: ProjectedToolOwner): () => void {
+	const existing = pi.getAllTools();
+	for (const name of owner.catalog.keys()) {
+		if (existing.some((tool) => tool.name === name || tool.name.endsWith(`__${name}`))) throw new RuntimeError("not-ready");
+	}
+	let active = true;
+	// Step P3: published tools can only call the broker with their actual session binding.
+	for (const tool of owner.catalog.values()) {
+		pi.registerTool({ name: `mcp__fsm__${tool.name}`, label: tool.name, description: tool.description,
+			parameters: structuredClone(tool.inputSchema),
+			async execute(_id, params, signal, onUpdate, ctx) {
+				if (!active || !owner.ready()) throw new RuntimeError("not-ready");
+				const binding = owner.binding(ctx);
+				if (binding.sessionId !== ctx.sessionManager.getSessionId()) throw new RuntimeError("owner-unavailable");
+				const result = await owner.broker.invoke(binding, tool.name, params, {
+					deadline: Date.now() + owner.timeoutMs, ...(signal ? { signal } : {}),
+					...(onUpdate ? { onProgress: (progress: unknown) => onUpdate({ content: [], details: { progress } }) } : {}),
+				});
+				return projectMcpToolResult(result);
+			},
+		});
+	}
+	return () => { active = false; };
+}
diff --git a/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts b/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts
new file mode 100644
index 000000000..5c10125fa
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts
@@ -0,0 +1,36 @@
+import type { AgentToolResult } from "@earendil-works/pi-coding-agent";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+type Json = NonNullable<AgentToolResult<unknown>["structuredContent"]>;
+function isJson(value: unknown): value is Json {
+	if (value === null || typeof value === "string" || typeof value === "boolean") return true;
+	if (typeof value === "number") return Number.isFinite(value);
+	if (Array.isArray(value)) return value.every(isJson);
+	return isAdmissionObject(value) && Object.values(value).every(isJson);
+}
+
+export function projectMcpToolResult(result: Record<string, unknown>): AgentToolResult<Record<string, unknown>> {
+	if (!Array.isArray(result.content) || (result.isError !== undefined && typeof result.isError !== "boolean")) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	const content: AgentToolResult<unknown>["content"] = [];
+	for (const block of result.content) {
+		if (!isAdmissionObject(block) || typeof block.type !== "string") throw new RuntimeError("protocol-invalid");
+		if (block.type === "text") {
+			if (typeof block.text !== "string") throw new RuntimeError("protocol-invalid");
+			content.push({ type: "text", text: block.text });
+		} else if (block.type === "image") {
+			if (typeof block.data !== "string" || typeof block.mimeType !== "string") throw new RuntimeError("protocol-invalid");
+			content.push({ type: "image", data: block.data, mimeType: block.mimeType });
+		} else {
+			content.push({ type: "text", text: JSON.stringify(block) });
+		}
+	}
+	if (result.structuredContent !== undefined && (!isAdmissionObject(result.structuredContent) || !isJson(result.structuredContent))) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	return { content, details: structuredClone(result),
+		...(result.structuredContent !== undefined ? { structuredContent: structuredClone(result.structuredContent) } : {}),
+		...(typeof result.isError === "boolean" ? { isError: result.isError } : {}) };
+}
diff --git a/my-plugins/fsm-compatible/src/broker/mcp-transport.ts b/my-plugins/fsm-compatible/src/broker/mcp-transport.ts
new file mode 100644
index 000000000..c4b5a2139
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/mcp-transport.ts
@@ -0,0 +1,123 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { startOwnedProcess, type OwnedProcess } from "../process/owned-process.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+interface PendingRpc {
+	readonly onProgress?: (params: unknown) => void;
+	resolve(value: unknown): void;
+	reject(error: RuntimeError): void;
+	cleanup(): void;
+}
+export interface RpcOptions {
+	readonly deadline: number;
+	readonly signal?: AbortSignal;
+	readonly onProgress?: (params: unknown) => void;
+}
+
+export class McpTransport {
+	private readonly process: OwnedProcess;
+	private readonly pending = new Map<number, PendingRpc>();
+	private buffer = "";
+	private nextId = 0;
+	private usable = true;
+	private readonly capacity: number;
+
+	constructor(command: string, args: readonly string[], env: NodeJS.ProcessEnv, capacity = 64) {
+		if (!Number.isInteger(capacity) || capacity < 1) throw new RuntimeError("protocol-invalid");
+		this.capacity = capacity;
+		this.process = startOwnedProcess(command, args, env);
+		this.process.child.stdout.setEncoding("utf8");
+		this.process.child.stdout.on("data", (chunk: string) => this.consume(chunk));
+		this.process.child.stderr.resume();
+		this.process.child.stdin.on("error", () => this.fail());
+		void this.process.closed.then(() => this.fail());
+	}
+
+	private fail(): void {
+		this.usable = false;
+		for (const entry of this.pending.values()) { entry.cleanup(); entry.reject(new RuntimeError("delivery-unknown")); }
+		this.pending.clear();
+	}
+
+	private consume(chunk: string): void {
+		this.buffer += chunk;
+		if (Buffer.byteLength(this.buffer) > 2 * 1024 * 1024) { this.fail(); return; }
+		for (;;) {
+			const newline = this.buffer.indexOf("\n");
+			if (newline < 0) return;
+			const line = this.buffer.slice(0, newline).trim();
+			this.buffer = this.buffer.slice(newline + 1);
+			if (!line) continue;
+			let value: unknown;
+			try { value = JSON.parse(line); } catch { this.fail(); return; }
+			if (!isAdmissionObject(value) || value.jsonrpc !== "2.0") { this.fail(); return; }
+			if (typeof value.method === "string") {
+				if (value.method === "notifications/progress" && isAdmissionObject(value.params)
+					&& typeof value.params.progressToken === "number") {
+					const entry = this.pending.get(value.params.progressToken);
+					try { entry?.onProgress?.(value.params); } catch { this.fail(); return; }
+				}
+				if (value.method === "ping" && (typeof value.id === "number" || typeof value.id === "string")) {
+					this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id: value.id, result: {} })}\n`);
+				}
+				continue;
+			}
+			if (typeof value.id !== "number") { this.fail(); return; }
+			const entry = this.pending.get(value.id);
+			if (!entry) { this.fail(); return; }
+			this.pending.delete(value.id);
+			entry.cleanup();
+			if ("error" in value) entry.reject(new RuntimeError("transport-failed"));
+			else if ("result" in value) entry.resolve(value.result);
+			else { entry.reject(new RuntimeError("protocol-invalid")); this.fail(); return; }
+		}
+	}
+
+	async initialize(options: RpcOptions): Promise<void> {
+		const reply = await this.call("initialize", {
+			protocolVersion: "2025-11-25", capabilities: {}, clientInfo: { name: "fsm-compatible", version: "0.1.0" },
+		}, options);
+		if (!isAdmissionObject(reply) || !["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"].includes(String(reply.protocolVersion))) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		this.notify("notifications/initialized", {});
+	}
+
+	call(method: string, params: unknown, options: RpcOptions): Promise<unknown> {
+		if (!this.usable) return Promise.reject(new RuntimeError("not-ready"));
+		if (options.signal?.aborted) return Promise.reject(new RuntimeError("cancelled"));
+		if (Date.now() >= options.deadline) return Promise.reject(new RuntimeError("deadline-exceeded"));
+		if (this.pending.size >= this.capacity) return Promise.reject(new RuntimeError("queue-full"));
+		const id = ++this.nextId;
+		return new Promise((resolve, reject) => {
+			const abort = () => {
+				const entry = this.pending.get(id);
+				if (!entry) return;
+				this.pending.delete(id);
+				entry.cleanup();
+				this.usable = false;
+				reject(new RuntimeError("delivery-unknown"));
+			};
+			const timer = setTimeout(abort, Math.max(0, options.deadline - Date.now()));
+			timer.unref();
+			const cleanup = () => { clearTimeout(timer); options.signal?.removeEventListener("abort", abort); };
+			options.signal?.addEventListener("abort", abort, { once: true });
+			this.pending.set(id, { resolve, reject, cleanup, ...(options.onProgress ? { onProgress: options.onProgress } : {}) });
+			const requestParams = options.onProgress && isAdmissionObject(params)
+				? { ...params, _meta: { ...(isAdmissionObject(params._meta) ? params._meta : {}), progressToken: id } }
+				: params;
+			try { this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params: requestParams })}\n`); }
+			catch { abort(); }
+		});
+	}
+
+	notify(method: string, params: unknown): void {
+		if (!this.usable) throw new RuntimeError("not-ready");
+		this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", method, params })}\n`);
+	}
+
+	async close(deadline: number): Promise<boolean> {
+		this.fail();
+		return this.process.close(deadline);
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/register-source.ts b/my-plugins/fsm-compatible/src/broker/register-source.ts
new file mode 100644
index 000000000..a1bb27f4e
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/register-source.ts
@@ -0,0 +1,31 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requestMutation, type DaemonRequester } from "./daemon-request.ts";
+
+export interface SourceOwner {
+	readonly rootSessionId: string;
+	readonly pid: number;
+	readonly cwd: string;
+	readonly serverUrl: string;
+}
+
+export async function registerAndConfirmSource(
+	request: DaemonRequester,
+	owner: SourceOwner,
+	deadline: number,
+	signal?: AbortSignal,
+): Promise<void> {
+	const attempted = await requestMutation(request, {
+		method: "POST", path: "/session/register", deadline, ...(signal ? { signal } : {}),
+		body: { session_id: owner.rootSessionId, cwd: owner.cwd, transcript_path: null, opencode_server_url: owner.serverUrl },
+	});
+	if (attempted.status < 200 || attempted.status >= 300) throw new RuntimeError("transport-failed");
+	if (attempted.body !== null) throw new RuntimeError("protocol-invalid");
+	const reply = await request({ method: "GET", path: `/session/source?session=${encodeURIComponent(owner.rootSessionId)}`,
+		deadline, ...(signal ? { signal } : {}) });
+	if (reply.status !== 200) throw new RuntimeError("not-ready");
+	const source = reply.body;
+	if (!isAdmissionObject(source) || source.session_id !== owner.rootSessionId || source.agent_pid !== owner.pid
+		|| source.kind !== "opencode" || source.cwd !== owner.cwd || source.opencode_server_url !== owner.serverUrl
+		|| source.transcript_path !== null) throw new RuntimeError("not-ready");
+}
diff --git a/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts b/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts
new file mode 100644
index 000000000..47f6c3746
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts
@@ -0,0 +1,81 @@
+import { randomUUID, createHash } from "node:crypto";
+import { lstat, mkdir, readFile, rmdir, unlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { HostIdentity } from "../runtime/host-identity.ts";
+
+export interface CanonicalLease {
+	readonly path: string;
+	release(): Promise<void>;
+}
+
+export function coordinationScope(): string {
+	if (!process.getuid) throw new RuntimeError("not-ready");
+	return join(tmpdir(), `pi-fsm-compatible-${process.getuid()}`, "coord");
+}
+
+async function waitForLease(signal: AbortSignal | undefined, deadline: number): Promise<void> {
+	if (signal?.aborted) throw new RuntimeError("cancelled");
+	const remaining = deadline - Date.now();
+	if (remaining <= 0) throw new RuntimeError("deadline-exceeded");
+	await new Promise<void>((resolve, reject) => {
+		const finish = () => { signal?.removeEventListener("abort", abort); resolve(); };
+		const abort = () => { clearTimeout(timer); reject(new RuntimeError("cancelled")); };
+		const timer = setTimeout(finish, Math.min(20, remaining));
+		timer.unref();
+		signal?.addEventListener("abort", abort, { once: true });
+	});
+}
+
+export async function acquireCanonicalLease(
+	scope: string,
+	host: HostIdentity,
+	tool: string,
+	rootSessionId: string,
+	deadline: number,
+	signal?: AbortSignal,
+): Promise<CanonicalLease> {
+	// Step P2: a physical-host key, never an independent per-root mutex.
+	if (!tool || !rootSessionId || !Number.isInteger(host.pid) || host.pid <= 1 || !/^[1-9][0-9]*$/.test(host.startId)) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	await mkdir(scope, { recursive: true, mode: 0o700 });
+	const info = await lstat(scope);
+	if (!info.isDirectory() || info.isSymbolicLink() || (process.getuid && info.uid !== process.getuid()) || (info.mode & 0o077) !== 0) {
+		throw new RuntimeError("not-ready");
+	}
+	const digest = createHash("sha256").update(tool).digest("hex");
+	const path = join(scope, `${host.pid}-${host.startId}-${digest}`);
+	const token = randomUUID();
+	for (;;) {
+		if (signal?.aborted) throw new RuntimeError("cancelled");
+		if (Date.now() >= deadline) throw new RuntimeError("deadline-exceeded");
+		try {
+			await mkdir(path, { mode: 0o700 });
+			break;
+		} catch (error) {
+			if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw new RuntimeError("transport-failed");
+			await waitForLease(signal, deadline);
+		}
+	}
+	const ownerFile = join(path, "owner.json");
+	const ownerText = JSON.stringify({ token, pid: host.pid, startId: host.startId, rootSessionId });
+	try {
+		await writeFile(ownerFile, ownerText, { flag: "wx", mode: 0o600 });
+	} catch {
+		await rmdir(path).catch(() => undefined);
+		throw new RuntimeError("transport-failed");
+	}
+	let released = false;
+	return Object.freeze({
+		path,
+		async release() {
+			if (released) return;
+			if (await readFile(ownerFile, "utf8") !== ownerText) throw new RuntimeError("protocol-invalid");
+			await unlink(ownerFile);
+			await rmdir(path);
+			released = true;
+		},
+	});
+}
diff --git a/my-plugins/fsm-compatible/src/process/owned-process.ts b/my-plugins/fsm-compatible/src/process/owned-process.ts
new file mode 100644
index 000000000..3f920fec1
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/process/owned-process.ts
@@ -0,0 +1,53 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+
+export interface ProcessExit {
+	readonly code: number | null;
+	readonly signal: NodeJS.Signals | null;
+	readonly spawnFailed: boolean;
+}
+export interface OwnedProcess {
+	readonly child: ChildProcessWithoutNullStreams;
+	readonly closed: Promise<ProcessExit>;
+	close(deadline: number): Promise<boolean>;
+}
+
+export function startOwnedProcess(command: string, args: readonly string[], env: NodeJS.ProcessEnv, cwd?: string): OwnedProcess {
+	const child = spawn(command, [...args], { env, ...(cwd ? { cwd } : {}), stdio: ["pipe", "pipe", "pipe"], shell: false });
+	let ended = false;
+	let spawnFailed = false;
+	child.on("error", () => { spawnFailed = true; });
+	const closed = new Promise<ProcessExit>((resolve) => {
+		child.once("close", (code, signal) => {
+			ended = true;
+			resolve(Object.freeze({ code, signal, spawnFailed }));
+		});
+	});
+	let closing: Promise<boolean> | undefined;
+	return {
+		child,
+		closed,
+		close(deadline) {
+			if (ended) return Promise.resolve(true);
+			if (closing) return closing;
+			closing = new Promise<boolean>((resolve) => {
+				let complete = false;
+				const finish = (value: boolean) => {
+					if (complete) return;
+					complete = true;
+					clearTimeout(killTimer);
+					clearTimeout(limitTimer);
+					resolve(value);
+				};
+				child.stdin.end();
+				child.kill("SIGTERM");
+				const remaining = Math.max(0, deadline - Date.now());
+				const killTimer = setTimeout(() => { if (!ended) child.kill("SIGKILL"); }, Math.min(250, remaining));
+				const limitTimer = setTimeout(() => finish(false), remaining);
+				killTimer.unref();
+				limitTimer.unref();
+				void closed.then(() => finish(true));
+			});
+			return closing;
+		},
+	};
+}
diff --git a/my-plugins/fsm-compatible/src/process/read-json-process.ts b/my-plugins/fsm-compatible/src/process/read-json-process.ts
new file mode 100644
index 000000000..9a8e22521
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/process/read-json-process.ts
@@ -0,0 +1,52 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { startOwnedProcess } from "./owned-process.ts";
+
+export interface JsonProcessOptions {
+	readonly command: string;
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly cwd?: string;
+	readonly deadline: number;
+	readonly input?: unknown;
+	readonly signal?: AbortSignal;
+	readonly maxBytes?: number;
+}
+
+export async function readJsonProcess(options: JsonProcessOptions): Promise<unknown> {
+	if (options.signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= options.deadline) throw new RuntimeError("deadline-exceeded");
+	const owned = startOwnedProcess(options.command, options.args, options.env, options.cwd);
+	const chunks: Buffer[] = [];
+	let bytes = 0;
+	let failure: RuntimeError | undefined;
+	const abort = (code: "cancelled" | "deadline-exceeded" | "protocol-invalid") => {
+		failure ??= new RuntimeError(code);
+		owned.child.kill("SIGKILL");
+	};
+	const onAbort = () => abort("cancelled");
+	const timeout = setTimeout(() => abort("deadline-exceeded"), Math.max(0, options.deadline - Date.now()));
+	timeout.unref();
+	options.signal?.addEventListener("abort", onAbort, { once: true });
+	owned.child.stdout.on("data", (chunk: Buffer) => {
+		bytes += chunk.length;
+		if (bytes > (options.maxBytes ?? 1024 * 1024)) abort("protocol-invalid");
+		else chunks.push(chunk);
+	});
+	owned.child.stderr.resume();
+	owned.child.stdin.on("error", () => { failure ??= new RuntimeError("transport-failed"); });
+	try {
+		owned.child.stdin.end(options.input === undefined ? undefined : JSON.stringify(options.input));
+		const exit = await owned.closed;
+		if (failure) throw failure;
+		if (exit.spawnFailed || exit.code !== 0 || exit.signal !== null) throw new RuntimeError("transport-failed");
+		try {
+			return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+		} catch {
+			throw new RuntimeError("protocol-invalid");
+		}
+	} finally {
+		clearTimeout(timeout);
+		options.signal?.removeEventListener("abort", onAbort);
+		if (!(await owned.close(Date.now() + 10000))) throw new RuntimeError("transport-failed");
+	}
+}
