+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { isAdmissionIdentifier } from "../admission/parse-policy-input.ts";
+import type { RootBinding } from "./actor-binding.ts";
+
+export function createRootBinding(sessionId: string, policy: AdmissionPolicy): RootBinding {
+	// Step P6: root has no child allowlist or parent requirement.
+	if (!isAdmissionIdentifier(sessionId)) throw new Error("Invalid root session identifier");
+	return Object.freeze({
+		version: 1,
+		rootSessionId: sessionId,
+		sessionId,
+		agentId: "main",
+		kind: "execution-root",
+		parentSessionId: null,
+		agentName: null,
+		bootstrapRef: null,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+	});
+}
diff --git a/my-plugins/fsm-compatible/src/binding/parent-chain.ts b/my-plugins/fsm-compatible/src/binding/parent-chain.ts
new file mode 100644
index 000000000..2a3176326
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/parent-chain.ts
@@ -0,0 +1,29 @@
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import type { BindingRecords } from "./actor-binding.ts";
+
+export function parentDepth(
+	rootSessionId: string,
+	sessionId: string,
+	records: BindingRecords,
+	forbiddenSessionId?: string,
+): AdmissionResult<number> {
+	const seen = new Set<string>(forbiddenSessionId === undefined ? [] : [forbiddenSessionId]);
+	let current = sessionId;
+	let depth = 0;
+	for (;;) {
+		if (seen.has(current)) return rejected("parent-cycle");
+		seen.add(current);
+		const record = records.find(current);
+		if (!record) return rejected("parent-not-found");
+		const binding = record.binding;
+		if (binding.sessionId !== current || binding.rootSessionId !== rootSessionId) return rejected("binding-mismatch");
+		if (binding.kind === "execution-root") {
+			return current === rootSessionId && binding.agentId === "main" && binding.parentSessionId === null
+				? admitted(depth)
+				: rejected("binding-mismatch");
+		}
+		if (binding.agentId !== current || binding.agentId === "main" || current === rootSessionId) return rejected("binding-mismatch");
+		current = binding.parentSessionId;
+		depth++;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts b/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts
new file mode 100644
index 000000000..d08bce8cb
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts
@@ -0,0 +1,64 @@
+import { isAbsolute } from "node:path";
+import { FSM_COMPATIBLE_EXTENSION_ID, MAX_REQUIRED_EXTENSIONS, REQUIRED_EXTENSION_ID_PATTERN } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { isAdmissionIdentifier, isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { isDataArray } from "../admission/data-array.ts";
+import { BINDING_CUSTOM_TYPE, type BindingEntry, type PersistedBinding } from "./actor-binding.ts";
+
+export function readPersistedBinding(
+	entries: readonly BindingEntry[],
+	actualSessionId: string,
+): AdmissionResult<PersistedBinding | null> {
+	// Step P7: absence and corruption are distinct, including the original mandatory baseline.
+	let found = false;
+	let data: unknown;
+	for (const entry of entries) {
+		if (entry.type === "custom" && entry.customType === BINDING_CUSTOM_TYPE) {
+			found = true;
+			data = entry.data;
+		}
+	}
+	if (!found) return admitted(null);
+	if (!isAdmissionObject(data)) return rejected("binding-mismatch");
+	const keys = ["version", "rootSessionId", "sessionId", "parentSessionId", "agentId", "kind", "agentName", "bootstrapRef", "requiredExtensions"];
+	if (Object.keys(data).some((key) => !keys.includes(key)) || data.version !== 1) return rejected("binding-mismatch");
+	if (!isAdmissionIdentifier(data.rootSessionId) || !isAdmissionIdentifier(data.sessionId) || !isAdmissionIdentifier(data.agentId)) {
+		return rejected("binding-mismatch");
+	}
+	if (data.sessionId !== actualSessionId || !isDataArray(data.requiredExtensions)
+		|| data.requiredExtensions.length < 1 || data.requiredExtensions.length > MAX_REQUIRED_EXTENSIONS) return rejected("binding-mismatch");
+	const extensions: { readonly id: string; readonly path: string }[] = [];
+	const ids = new Set<string>();
+	const paths = new Set<string>();
+	for (const item of data.requiredExtensions) {
+		if (!isAdmissionObject(item) || Object.keys(item).some((key) => key !== "id" && key !== "path")) return rejected("binding-mismatch");
+		if (!isAdmissionIdentifier(item.id) || !REQUIRED_EXTENSION_ID_PATTERN.test(item.id)
+			|| !isAdmissionIdentifier(item.path) || !isAbsolute(item.path) || ids.has(item.id) || paths.has(item.path)) return rejected("binding-mismatch");
+		ids.add(item.id);
+		paths.add(item.path);
+		extensions.push(Object.freeze({ id: item.id, path: item.path }));
+	}
+	if (!ids.has(FSM_COMPATIBLE_EXTENSION_ID)) return rejected("binding-mismatch");
+	const identity = {
+		version: 1 as const,
+		rootSessionId: data.rootSessionId,
+		sessionId: data.sessionId,
+		agentId: data.agentId,
+		requiredExtensions: Object.freeze(extensions),
+	};
+	if (data.kind === "execution-root") {
+		if (data.sessionId !== data.rootSessionId || data.agentId !== "main" || data.parentSessionId !== null
+			|| data.agentName !== null || data.bootstrapRef !== null) return rejected("binding-mismatch");
+		return admitted(Object.freeze({ ...identity, kind: "execution-root", parentSessionId: null, agentName: null, bootstrapRef: null }));
+	}
+	if (data.kind !== "execution-child" || data.agentId !== data.sessionId || data.agentId === "main" || data.sessionId === data.rootSessionId
+		|| !isAdmissionIdentifier(data.parentSessionId) || data.parentSessionId === data.sessionId
+		|| !isAdmissionIdentifier(data.agentName) || !isAdmissionIdentifier(data.bootstrapRef)) return rejected("binding-mismatch");
+	return admitted(Object.freeze({
+		...identity,
+		kind: "execution-child",
+		parentSessionId: data.parentSessionId,
+		agentName: data.agentName,
+		bootstrapRef: data.bootstrapRef,
+	}));
+}
diff --git a/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts b/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts
new file mode 100644
index 000000000..fe0ed05cf
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts
@@ -0,0 +1,33 @@
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { BINDING_CUSTOM_TYPE, type BindingRecords, type PersistedBinding } from "./actor-binding.ts";
+import { parentDepth } from "./parent-chain.ts";
+import { readPersistedBinding } from "./read-persisted-binding.ts";
+
+export function restoreActorBinding(
+	policy: AdmissionPolicy,
+	saved: PersistedBinding,
+	actualSessionId: string,
+	callerRoot: string,
+	records: BindingRecords,
+): AdmissionResult<PersistedBinding> {
+	// Step P7: validate the saved baseline, never derive it from the current policy.
+	const checked = readPersistedBinding([{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: saved }], actualSessionId);
+	if (!checked.ok || !checked.value || checked.value.rootSessionId !== callerRoot) return rejected("restore-conflict");
+	const binding = checked.value;
+	for (const original of binding.requiredExtensions) {
+		if (!policy.requiredExtensions.some((item) => item.id === original.id && item.path === original.path && item.requireForAllRunners === true)) {
+			return rejected("restore-conflict");
+		}
+	}
+	if (binding.kind === "execution-child") {
+		if (!policy.agents.some((agent) => agent.canonicalName === binding.agentName)) return rejected("restore-conflict");
+		const depth = parentDepth(callerRoot, binding.parentSessionId, records, actualSessionId);
+		if (!depth.ok || depth.value >= policy.maxDepth) return rejected("restore-conflict");
+	}
+	// Root does not have a child agentName or parent; its identity was checked above.
+	return admitted(Object.freeze({
+		...binding,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+	}));
+}
diff --git a/my-plugins/fsm-compatible/src/broker/broker-channel.ts b/my-plugins/fsm-compatible/src/broker/broker-channel.ts
new file mode 100644
index 000000000..83ad6a06a
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/broker-channel.ts
@@ -0,0 +1,65 @@
+import { RuntimeResources } from "../runtime/runtime-resources.ts";
+import { readHostIdentity } from "../runtime/host-identity.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requireDaemonCapabilities, type DaemonCapabilities } from "./daemon-capabilities.ts";
+import { createDaemonRequester, type DaemonRequester } from "./daemon-request.ts";
+import { FsmBroker } from "./fsm-broker.ts";
+import { discoverFsmTools, type FsmTool } from "./fsm-catalog.ts";
+import { McpTransport } from "./mcp-transport.ts";
+import { registerAndConfirmSource } from "./register-source.ts";
+
+export interface BrokerChannelConfig {
+	readonly rootSessionId: string;
+	readonly cwd: string;
+	readonly serverUrl: string;
+	readonly dataDir: string;
+	readonly clientCommand: string;
+	readonly clientArgs: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly capacity: number;
+	readonly scope?: string;
+}
+export interface BrokerChannel {
+	readonly broker: FsmBroker;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly capabilities: DaemonCapabilities;
+	readonly signal: AbortSignal;
+	close(deadline: number): Promise<void>;
+}
+
+export async function prepareBrokerChannel(
+	config: BrokerChannelConfig,
+	deadline: number,
+	signal?: AbortSignal,
+	request: DaemonRequester = createDaemonRequester(config.dataDir),
+): Promise<BrokerChannel> {
+	if (!config.rootSessionId || !config.cwd || !config.clientCommand || !config.dataDir
+		|| !Number.isInteger(config.capacity) || config.capacity < 1) throw new RuntimeError("protocol-invalid");
+	if (signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= deadline) throw new RuntimeError("deadline-exceeded");
+	const resources = new RuntimeResources();
+	const cancel = () => { void resources.close(Date.now() + 10000).catch(() => undefined); };
+	signal?.addEventListener("abort", cancel, { once: true });
+	resources.own(() => { signal?.removeEventListener("abort", cancel); });
+	const call = { deadline, signal: resources.signal };
+	try {
+		const capabilities = requireDaemonCapabilities(await request({ method: "GET", path: "/capabilities", ...call }));
+		const host = await readHostIdentity(deadline, resources.signal);
+		const source = { rootSessionId: config.rootSessionId, pid: host.pid, cwd: config.cwd, serverUrl: config.serverUrl };
+		await registerAndConfirmSource(request, source, deadline, resources.signal);
+		if (!resources.open) throw new RuntimeError("cancelled");
+		const transport = new McpTransport(config.clientCommand, config.clientArgs, { ...config.env, FSM_DATA_DIR: config.dataDir }, config.capacity);
+		resources.own(async (limit) => { if (!(await transport.close(limit))) throw new RuntimeError("delivery-unknown"); });
+		await transport.initialize(call);
+		const catalog = await discoverFsmTools(transport, call);
+		const broker = new FsmBroker({ host, source, request, transport, catalog, capacity: config.capacity,
+			...(config.scope ? { scope: config.scope } : {}) });
+		resources.own(async (limit) => { if (!(await broker.close(limit))) throw new RuntimeError("delivery-unknown"); });
+		if (!resources.open) throw new RuntimeError("cancelled");
+		return Object.freeze({ broker, catalog, capabilities, signal: resources.signal,
+			close: (limit: number) => resources.close(limit) });
+	} catch (error) {
+		await resources.close(Date.now() + 10000);
+		throw error;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts b/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts
new file mode 100644
index 000000000..b7e6595f9
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts
@@ -0,0 +1,26 @@
+import { isDataArray } from "../admission/data-array.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { DaemonReply } from "./daemon-request.ts";
+
+export interface DaemonCapabilities {
+	readonly serverVersion: string;
+	readonly wireContractVersion: 2;
+	readonly skillSchemaVersion: 2;
+	readonly features: readonly string[];
+}
+
+export function requireDaemonCapabilities(reply: DaemonReply): DaemonCapabilities {
+	const body = reply.body;
+	if (reply.status !== 200 || !isAdmissionObject(body) || typeof body.server_version !== "string"
+		|| !body.server_version || body.wire_contract_version !== 2 || body.skill_schema_version !== 2
+		|| !isDataArray(body.features)) throw new RuntimeError("not-ready");
+	const features = body.features;
+	if (!features.every((item): item is string => typeof item === "string" && item.length > 0)
+		|| new Set(features).size !== features.length) throw new RuntimeError("not-ready");
+	if (!["dispatch_state_admission_v1", "typed_input_exact_v1"].every((name) => features.includes(name))) {
+		throw new RuntimeError("not-ready");
+	}
+	return Object.freeze({ serverVersion: body.server_version, wireContractVersion: 2, skillSchemaVersion: 2,
+		features: Object.freeze([...features]) });
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-request.mjs b/my-plugins/fsm-compatible/src/broker/daemon-request.mjs
new file mode 100644
index 000000000..c3384a7c5
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-request.mjs
@@ -0,0 +1,56 @@
+import { readFile } from 'node:fs/promises';
+import { request } from 'node:http';
+import { resolve } from 'node:path';
+
+const limit = 1024 * 1024;
+try {
+  let input = '';
+  for await (const chunk of process.stdin) {
+    input += chunk.toString();
+    if (Buffer.byteLength(input) > limit) throw new Error('input-limit');
+  }
+  const payload = JSON.parse(input);
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) throw new Error('bad-input');
+  const allowed = new Map([
+    ['/health', 'GET'], ['/capabilities', 'GET'], ['/session/source', 'GET'],
+    ['/session/register', 'POST'], ['/identity/acquire', 'POST'], ['/actor/acquire', 'POST'], ['/evidence/source-auth', 'POST'],
+  ]);
+  if (typeof payload.dataDir !== 'string' || typeof payload.path !== 'string' || typeof payload.method !== 'string'
+      || !Number.isFinite(payload.deadline) || payload.deadline <= Date.now()) throw new Error('bad-input');
+  const url = new URL(payload.path, 'http://localhost');
+  if (url.origin !== 'http://localhost' || allowed.get(url.pathname) !== payload.method || url.hash) throw new Error('bad-route');
+  if (url.pathname === '/session/source') {
+    if ([...url.searchParams.keys()].length !== 1 || !url.searchParams.get('session')) throw new Error('bad-query');
+  } else if (url.search) throw new Error('bad-query');
+  const dataDir = resolve(payload.dataDir);
+  const token = (await readFile(resolve(dataDir, 'auth.token'), 'utf8')).trim();
+  const body = payload.method === 'POST' ? JSON.stringify(payload.body) : '';
+  if (body === undefined || Buffer.byteLength(body) > limit || !token) throw new Error('bad-input');
+  const response = await new Promise((accept, reject) => {
+    const req = request({ socketPath: resolve(dataDir, 'server.sock'), path: `${url.pathname}${url.search}`,
+      method: payload.method, headers: { 'x-fsm-auth': token, 'content-type': 'application/json' } });
+    const timer = setTimeout(() => req.destroy(new Error('deadline')), payload.deadline - Date.now());
+    timer.unref();
+    req.on('error', reject);
+    req.on('close', () => clearTimeout(timer));
+    req.on('response', (res) => {
+      const chunks = [];
+      let bytes = 0;
+      res.on('data', (chunk) => {
+        bytes += chunk.length;
+        if (bytes > limit) { req.destroy(new Error('body-limit')); res.destroy(); }
+        else chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('aborted', () => reject(new Error('aborted')));
+      res.on('end', () => {
+        try { accept({ status: res.statusCode, body: JSON.parse(Buffer.concat(chunks).toString('utf8')) }); }
+        catch { reject(new Error('bad-json')); }
+      });
+    });
+    req.end(body);
+  });
+  process.stdout.write(`${JSON.stringify(response)}\n`);
+} catch {
+  process.exitCode = 1;
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-request.ts b/my-plugins/fsm-compatible/src/broker/daemon-request.ts
new file mode 100644
index 000000000..c283db006
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-request.ts
@@ -0,0 +1,46 @@
+import { fileURLToPath } from "node:url";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { readJsonProcess } from "../process/read-json-process.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface DaemonRequest {
+	readonly method: "GET" | "POST";
+	readonly path: string;
+	readonly body?: unknown;
+	readonly deadline: number;
+	readonly signal?: AbortSignal;
+}
+export interface DaemonReply { readonly status: number; readonly body: unknown }
+export type DaemonRequester = (request: DaemonRequest) => Promise<DaemonReply>;
+
+export function createDaemonRequester(dataDir: string): DaemonRequester {
+	const helper = fileURLToPath(new URL("./daemon-request.mjs", import.meta.url));
+	return async (request) => {
+		const value = await readJsonProcess({
+			command: process.execPath,
+			args: [helper],
+			env: { ...process.env, FSM_DATA_DIR: dataDir },
+			deadline: request.deadline,
+			...(request.signal ? { signal: request.signal } : {}),
+			input: { dataDir, method: request.method, path: request.path, body: request.body, deadline: request.deadline },
+		});
+		if (!isAdmissionObject(value) || typeof value.status !== "number" || !Number.isInteger(value.status)
+			|| value.status < 100 || value.status > 599 || !("body" in value)) throw new RuntimeError("protocol-invalid");
+		return Object.freeze({ status: value.status, body: value.body });
+	};
+}
+
+export async function requestMutation(request: DaemonRequester, input: DaemonRequest): Promise<DaemonReply> {
+	if (input.signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= input.deadline) throw new RuntimeError("deadline-exceeded");
+	try {
+		return await request(input);
+	} catch {
+		throw new RuntimeError("delivery-unknown");
+	}
+}
+
+export function requireDaemonOk(reply: DaemonReply): void {
+	if (reply.status < 200 || reply.status >= 300) throw new RuntimeError("transport-failed");
+	if (!isAdmissionObject(reply.body) || reply.body.ok !== true) throw new RuntimeError("protocol-invalid");
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-broker.ts b/my-plugins/fsm-compatible/src/broker/fsm-broker.ts
new file mode 100644
index 000000000..a8cfc8436
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-broker.ts
@@ -0,0 +1,99 @@
+import type { PersistedBinding } from "../binding/actor-binding.ts";
+import { acquireCanonicalLease, coordinationScope } from "../coordination/canonical-lease.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import type { HostIdentity } from "../runtime/host-identity.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requestMutation, requireDaemonOk, type DaemonRequester } from "./daemon-request.ts";
+import type { FsmTool } from "./fsm-catalog.ts";
+import type { McpTransport, RpcOptions } from "./mcp-transport.ts";
+import { registerAndConfirmSource, type SourceOwner } from "./register-source.ts";
+
+export interface FsmBrokerOptions {
+	readonly host: HostIdentity;
+	readonly source: SourceOwner;
+	readonly request: DaemonRequester;
+	readonly transport: McpTransport;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly scope?: string;
+	readonly capacity?: number;
+}
+
+export class FsmBroker {
+	private readonly options: FsmBrokerOptions;
+	private usable = true;
+	private pending = 0;
+	private readonly controller = new AbortController();
+	private readonly capacity: number;
+
+	constructor(options: FsmBrokerOptions) {
+		this.capacity = options.capacity ?? 64;
+		if (options.source.pid !== options.host.pid || !Number.isInteger(this.capacity) || this.capacity < 1) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		this.options = options;
+	}
+
+	async invoke(binding: PersistedBinding, name: string, input: unknown, call: RpcOptions): Promise<Record<string, unknown>> {
+		if (!this.usable) throw new RuntimeError("not-ready");
+		if (this.pending >= this.capacity) throw new RuntimeError("queue-full");
+		this.pending++;
+		const signal = call.signal ? AbortSignal.any([call.signal, this.controller.signal]) : this.controller.signal;
+		try { return await this.invokeAdmitted(binding, name, input, { ...call, signal }); } finally { this.pending--; }
+	}
+
+	private async invokeAdmitted(binding: PersistedBinding, name: string, input: unknown, call: RpcOptions): Promise<Record<string, unknown>> {
+		// Step P3: acquire and invocation share one physical-host/canonical lease.
+		if (!this.usable || binding.rootSessionId !== this.options.source.rootSessionId) throw new RuntimeError("not-ready");
+		if ((binding.kind === "execution-root" && binding.agentId !== "main")
+			|| (binding.kind === "execution-child" && (binding.agentId !== binding.sessionId || binding.agentId === "main"))) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		const tool = this.options.catalog.get(name);
+		if (!tool || !isAdmissionObject(input) || !tool.validate(input)) throw new RuntimeError("protocol-invalid");
+		const lease = await acquireCanonicalLease(this.options.scope ?? coordinationScope(), this.options.host, name,
+			binding.rootSessionId, call.deadline, call.signal);
+		let sent = false;
+		let safeToRelease = true;
+		try {
+			if (!this.usable) throw new RuntimeError("not-ready");
+			await registerAndConfirmSource(this.options.request, this.options.source, call.deadline, call.signal);
+			const identity = await requestMutation(this.options.request, {
+				method: "POST", path: "/identity/acquire", deadline: call.deadline, ...(call.signal ? { signal: call.signal } : {}),
+				body: { session_id: binding.rootSessionId, agent_id: binding.agentId, tool_name: name,
+					agent_cli: "opencode", opencode_server_url: this.options.source.serverUrl },
+			});
+			requireDaemonOk(identity);
+			sent = true;
+			const result = await this.options.transport.call("tools/call", { name, arguments: input }, call);
+			if (!isAdmissionObject(result) || !Array.isArray(result.content)) throw new RuntimeError("protocol-invalid");
+			return result;
+		} catch (error) {
+			if (!sent && error instanceof RuntimeError && error.code === "delivery-unknown") {
+				this.usable = false;
+				safeToRelease = false;
+				await this.options.transport.close(Date.now() + 10000);
+			}
+			if (sent) {
+				this.usable = false;
+				safeToRelease = await this.options.transport.close(Date.now() + 10000);
+				if (!safeToRelease) throw new RuntimeError("delivery-unknown");
+			}
+			throw error;
+		} finally {
+			if (safeToRelease) await lease.release();
+		}
+	}
+
+	async acquireActor(binding: PersistedBinding, call: RpcOptions): Promise<void> {
+		if (!this.usable || binding.rootSessionId !== this.options.source.rootSessionId) throw new RuntimeError("not-ready");
+		await registerAndConfirmSource(this.options.request, this.options.source, call.deadline, call.signal);
+		requireDaemonOk(await requestMutation(this.options.request, { method: "POST", path: "/actor/acquire", deadline: call.deadline,
+			...(call.signal ? { signal: call.signal } : {}), body: { session_id: binding.rootSessionId, agent_id: binding.agentId } }));
+	}
+
+	async close(deadline: number): Promise<boolean> {
+		this.usable = false;
+		this.controller.abort();
+		return this.options.transport.close(deadline);
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts b/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts
