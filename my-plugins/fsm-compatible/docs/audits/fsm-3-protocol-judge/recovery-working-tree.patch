@@ -0,0 +1,26 @@
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#ifdef __APPLE__
+#include <libproc.h>
+#include <sys/proc_info.h>
+#endif
+
+int main(void) {
+#ifdef __APPLE__
+    const pid_t parent = getppid();
+    struct proc_bsdinfo info;
+    memset(&info, 0, sizeof(info));
+    if (parent <= 1 || proc_pidinfo(parent, PROC_PIDTBSDINFO, 0, &info, sizeof(info)) != sizeof(info)) return 1;
+    if (info.pbi_pid != (uint32_t)parent || info.pbi_start_tvusec >= 1000000) return 1;
+    if (info.pbi_start_tvsec > (UINT64_MAX - info.pbi_start_tvusec) / 1000000) return 1;
+    const uint64_t start = info.pbi_start_tvsec * 1000000 + info.pbi_start_tvusec;
+    if (start == 0) return 1;
+    printf("{\"pid\":%ld,\"startId\":\"%" PRIu64 "\"}\n", (long)parent, start);
+    return 0;
+#else
+    return 1;
+#endif
+}
diff --git a/my-plugins/fsm-compatible/src/runtime/host-identity.ts b/my-plugins/fsm-compatible/src/runtime/host-identity.ts
new file mode 100644
index 000000000..d21f72fbc
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/runtime/host-identity.ts
@@ -0,0 +1,38 @@
+import { readFile } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { readJsonProcess } from "../process/read-json-process.ts";
+import { RuntimeError } from "./runtime-error.ts";
+
+export interface HostIdentity {
+	readonly pid: number;
+	readonly startId: string;
+}
+
+export function parseHostIdentity(value: unknown, expectedPid: number): HostIdentity {
+	if (!isAdmissionObject(value) || value.pid !== expectedPid || !Number.isInteger(expectedPid) || expectedPid <= 1
+		|| typeof value.startId !== "string" || !/^[1-9][0-9]*$/.test(value.startId)) throw new RuntimeError("protocol-invalid");
+	if (BigInt(value.startId) > (1n << 64n) - 1n) throw new RuntimeError("protocol-invalid");
+	return Object.freeze({ pid: expectedPid, startId: value.startId });
+}
+
+export function parseLinuxHostIdentity(stat: string, expectedPid: number): HostIdentity {
+	const open = stat.indexOf("(");
+	const close = stat.lastIndexOf(")");
+	if (open < 0 || close < open || Number(stat.slice(0, open).trim()) !== expectedPid) throw new RuntimeError("protocol-invalid");
+	const fields = stat.slice(close + 1).trim().split(/\s+/);
+	return parseHostIdentity({ pid: expectedPid, startId: fields[19] }, expectedPid);
+}
+
+export async function readHostIdentity(deadline: number, signal?: AbortSignal): Promise<HostIdentity> {
+	if (signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= deadline) throw new RuntimeError("deadline-exceeded");
+	if (process.platform === "linux") {
+		const stat = await readFile(`/proc/${process.pid}/stat`, { encoding: "utf8", ...(signal ? { signal } : {}) });
+		return parseLinuxHostIdentity(stat, process.pid);
+	}
+	if (process.platform !== "darwin") throw new RuntimeError("not-ready");
+	const command = fileURLToPath(new URL("../../.runtime/bin/host-identity", import.meta.url));
+	const value = await readJsonProcess({ command, args: [], env: { ...process.env }, deadline, ...(signal ? { signal } : {}) });
+	return parseHostIdentity(value, process.pid);
+}
diff --git a/my-plugins/fsm-compatible/src/runtime/managed-bootstrap.ts b/my-plugins/fsm-compatible/src/runtime/managed-bootstrap.ts
new file mode 100644
index 000000000..256afa471
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/runtime/managed-bootstrap.ts
@@ -0,0 +1,71 @@
+import type { ExtensionAPI, ExtensionContext, ExtensionFactory } from "@earendil-works/pi-coding-agent";
+import { RootHealth, type ManagedFactoryIdentity } from "./root-health.ts";
+import { RuntimeError } from "./runtime-error.ts";
+
+export interface ManagedFactory extends ManagedFactoryIdentity {
+	readonly factory: ExtensionFactory;
+}
+
+export async function installManagedFactories(
+	pi: ExtensionAPI,
+	factories: readonly ManagedFactory[],
+	health: RootHealth,
+): Promise<void> {
+	// Step P1: install begin before every callback registered by the managed factories.
+	pi.on("session_start", (_event, ctx) => { health.begin(ctx.sessionManager.getSessionId()); });
+	for (const entry of factories) {
+		const proxy = new Proxy(pi, {
+			get(target, property, receiver): unknown {
+				if (property === "on") {
+					return (...args: unknown[]) => {
+						const [event, callback] = args;
+						if (typeof event !== "string" || typeof callback !== "function") throw new RuntimeError("protocol-invalid");
+						if (event !== "session_start") return Reflect.apply(target.on, target, args);
+						const registration = health.registerStartup(entry.id);
+						const wrapped = async (eventValue: unknown, ctx: ExtensionContext): Promise<unknown> => {
+							const epoch = health.epoch;
+							if (!epoch) throw new RuntimeError("not-ready");
+							const sessionId = ctx.sessionManager.getSessionId();
+							try {
+								const result: unknown = await Reflect.apply(callback, undefined, [eventValue, ctx]);
+								health.observe(epoch, sessionId, registration.token, true);
+								health.commit(epoch);
+								return result;
+							} catch (error) {
+								health.observe(epoch, sessionId, registration.token, false);
+								throw error;
+							}
+						};
+						const unsubscribe: unknown = Reflect.apply(target.on, target, [event, wrapped]);
+						if (typeof unsubscribe !== "function") throw new RuntimeError("protocol-invalid");
+						let active = true;
+						return () => {
+							if (!active) return;
+							active = false;
+							registration.deactivate();
+							Reflect.apply(unsubscribe, undefined, []);
+						};
+					};
+				}
+				if (property === "sendUserMessage" || property === "sendMessage") {
+					return (...args: unknown[]) => {
+						const options = args[1];
+						const triggers = property === "sendUserMessage" || (options !== null && typeof options === "object"
+							&& "triggerTurn" in options && options.triggerTurn === true);
+						if (triggers && !health.ready) throw new RuntimeError("not-ready");
+						const method: unknown = Reflect.get(target, property, receiver);
+						if (typeof method !== "function") throw new RuntimeError("protocol-invalid");
+						return Reflect.apply(method, target, args);
+					};
+				}
+				return Reflect.get(target, property, receiver);
+			},
+		});
+		try {
+			await entry.factory(proxy);
+			health.markInitialized(entry.id, true);
+		} catch {
+			health.markInitialized(entry.id, false);
+		}
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/runtime/not-ready-gate.ts b/my-plugins/fsm-compatible/src/runtime/not-ready-gate.ts
