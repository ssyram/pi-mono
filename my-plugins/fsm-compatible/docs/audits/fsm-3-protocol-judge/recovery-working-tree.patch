@@ -0,0 +1,146 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { BINDING_CUSTOM_TYPE, type BindingEntry } from "../src/binding/actor-binding.ts";
+import { bindNewChild } from "../src/binding/bind-new-child.ts";
+import { createRootBinding } from "../src/binding/create-root-binding.ts";
+import { parentDepth } from "../src/binding/parent-chain.ts";
+import { readPersistedBinding } from "../src/binding/read-persisted-binding.ts";
+import { restoreActorBinding } from "../src/binding/restore-actor-binding.ts";
+import { child, expectCode, extraExtension, pending, policy, records, root, selfExtension, unwrap } from "./admission-fixtures.ts";
+
+function entries(data: unknown): BindingEntry[] {
+	return [{ type: "custom", customType: BINDING_CUSTOM_TYPE, data }];
+}
+
+test("root binding includes the original non-secret mandatory baseline", () => {
+	const source = policy([], [selfExtension, extraExtension]);
+	const binding = createRootBinding("r", source);
+	assert.equal(binding.agentId, "main");
+	assert.equal(binding.parentSessionId, null);
+	assert.equal(binding.agentName, null);
+	assert.deepEqual(binding.requiredExtensions, [{ id: "fsm-compatible", path: "/plugin/index.ts" }, { id: "extra", path: "/plugin/extra.ts" }]);
+	assert.ok(Object.isFrozen(binding) && Object.isFrozen(binding.requiredExtensions));
+	assert.throws(() => createRootBinding(" r", source));
+});
+
+test("missing and damaged saved bindings are never conflated", () => {
+	assert.equal(unwrap(readPersistedBinding([], "r")), null);
+	assert.equal(unwrap(readPersistedBinding([{ type: "custom_message", customType: BINDING_CUSTOM_TYPE }], "r")), null);
+	const binding = root();
+	for (const key of Object.keys(binding)) {
+		const damaged: Record<string, unknown> = { ...binding };
+		delete damaged[key];
+		expectCode(readPersistedBinding(entries(damaged), "r"), "binding-mismatch");
+	}
+	for (const damaged of [null, { ...binding, version: 2 }, { ...binding, sessionId: "other" },
+		{ ...binding, requiredExtensions: [] }, { ...binding, token: "not-allowed" },
+		{ ...binding, requiredExtensions: [{ id: "fsm-compatible", path: "relative.ts" }] },
+		{ ...binding, requiredExtensions: [{ id: "fsm-compatible", path: "/a" }, { id: "fsm-compatible", path: "/b" }] }]) {
+		expectCode(readPersistedBinding(entries(damaged), "r"), "binding-mismatch");
+	}
+	assert.deepEqual(unwrap(readPersistedBinding(entries(binding), "r")), binding);
+	assert.deepEqual(unwrap(readPersistedBinding(entries(child()), "c")), child());
+	expectCode(readPersistedBinding(entries(child("r", "main")), "main"), "binding-mismatch");
+});
+
+test("only latest binding on the provided real branch is considered", () => {
+	const binding = root();
+	expectCode(readPersistedBinding([...entries(binding), ...entries({})], "r"), "binding-mismatch");
+	assert.deepEqual(unwrap(readPersistedBinding([...entries({}), ...entries(binding)], "r")), binding);
+});
+
+test("B2: legitimate root restores without child allowlist or parent lookup", () => {
+	const source = policy([], [selfExtension, extraExtension]);
+	const saved = root(source);
+	let lookups = 0;
+	const empty = { find: () => { lookups++; return undefined; } };
+	assert.deepEqual(unwrap(restoreActorBinding(source, saved, "r", "r", empty)), saved);
+	assert.equal(lookups, 0);
+	expectCode(restoreActorBinding(source, saved, "r", "other", empty), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "other", "r", empty), "restore-conflict");
+});
+
+test("B1: original mandatory deletion/replacement is rejected; additions become the next baseline", () => {
+	const original = policy([], [selfExtension, extraExtension]);
+	const saved = root(original);
+	const empty = records();
+	expectCode(restoreActorBinding(policy([]), saved, "r", "r", empty), "restore-conflict");
+	const replaced = { ...extraExtension, path: "/plugin/replaced.ts" };
+	expectCode(restoreActorBinding(policy([], [selfExtension, replaced]), saved, "r", "r", empty), "restore-conflict");
+	const added = { id: "added", path: "/plugin/added.ts", requireForAllRunners: true as const };
+	const expanded = policy([], [selfExtension, extraExtension, added]);
+	const next = unwrap(restoreActorBinding(expanded, saved, "r", "r", empty));
+	assert.equal(saved.requiredExtensions.length, 2);
+	assert.equal(next.requiredExtensions.length, 3);
+	expectCode(restoreActorBinding(original, next, "r", "r", empty), "restore-conflict");
+	const savedChild = child("r", "c", policy(["a"], [selfExtension, extraExtension]));
+	expectCode(restoreActorBinding(policy(), savedChild, "c", "r", records(root())), "restore-conflict");
+});
+
+test("child restore retains every identity field and validates actual parent/agent/depth", () => {
+	const source = policy();
+	const saved = child();
+	const tree = records(root());
+	assert.deepEqual(unwrap(restoreActorBinding(source, saved, "c", "r", tree)), saved);
+	expectCode(restoreActorBinding(policy([]), saved, "c", "r", tree), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "c", "r", records()), "restore-conflict");
+	expectCode(restoreActorBinding(source, saved, "c", "other", tree), "restore-conflict");
+	expectCode(restoreActorBinding(source, { ...saved, agentId: "new-run-id" }, "c", "r", tree), "restore-conflict");
+	const deep = child("c", "d");
+	expectCode(restoreActorBinding(policy(["a"], [selfExtension], 1), deep, "d", "r", records(root(), saved)), "restore-conflict");
+});
+
+test("C1: restoring into an existing descendant rejects the newly introduced parent cycle", () => {
+	const source = policy();
+	const current = child("r", "c", source);
+	assert.ok(current.kind === "execution-child");
+	const descendant = child("c", "d", source);
+	const tree = records(root(source), current, descendant);
+	const saved = { ...current, parentSessionId: "d" };
+	const before = structuredClone(saved);
+	assert.equal(unwrap(parentDepth("r", "d", tree)), 2);
+	expectCode(restoreActorBinding(source, saved, "c", "r", tree), "restore-conflict");
+	assert.deepEqual(saved, before);
+	assert.equal(tree.find("c")?.binding.parentSessionId, "r");
+});
+
+test("new launch binds one actual self and failure has no registration mutation", () => {
+	const source = policy();
+	const launch = pending(source);
+	const tree = records(root(source));
+	const reserved = pending(source);
+	expectCode(bindNewChild(source, reserved, "main", [], tree), "binding-mismatch");
+	assert.equal(reserved.state, "allocated");
+	const bound = unwrap(bindNewChild(source, launch, "c", [], tree));
+	assert.equal(launch.state, "registered");
+	assert.equal(launch.registeredSessionId, "c");
+	assert.equal(bound.agentId, "c");
+	assert.deepEqual(unwrap(bindNewChild(source, launch, "c", [], tree)), bound);
+	expectCode(bindNewChild(source, launch, "d", [], tree), "binding-mismatch");
+	assert.equal(launch.registeredSessionId, "c");
+	for (const run of [pending(source), { ...pending(source), state: "cancelled" as const }]) {
+		const before = { ...run };
+		const result = bindNewChild(source, run, "c", entries({}), tree);
+		assert.equal(result.ok, false);
+		assert.deepEqual(run, before);
+	}
+});
+
+test("existing saved binding goes through restore, never new fallback", () => {
+	const source = policy();
+	const launch = pending(source);
+	const saved = child();
+	assert.deepEqual(unwrap(bindNewChild(source, launch, "c", entries(saved), records(root()))), saved);
+	const different = pending(source);
+	expectCode(bindNewChild(source, different, "c", entries({ ...saved, parentSessionId: "missing" }), records(root())), "binding-mismatch");
+	assert.equal(different.state, "allocated");
+});
+
+test("finite parent chains terminate on missing, cross-root and cycles", () => {
+	assert.equal(unwrap(parentDepth("r", "r", records(root()))), 0);
+	assert.equal(unwrap(parentDepth("r", "d", records(root(), child(), child("c", "d")))), 2);
+	expectCode(parentDepth("r", "missing", records(root())), "parent-not-found");
+	expectCode(parentDepth("other", "c", records(root(), child())), "binding-mismatch");
+	expectCode(parentDepth("r", "main", records(root(), child("r", "main"))), "binding-mismatch");
+	expectCode(parentDepth("r", "c", records(child("d", "c"), child("c", "d"))), "parent-cycle");
+});
diff --git a/my-plugins/fsm-compatible/test/admission-binding-schema.test.ts b/my-plugins/fsm-compatible/test/admission-binding-schema.test.ts
new file mode 100644
index 000000000..d48da42d2
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/admission-binding-schema.test.ts
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { Ajv } from "ajv";
+import { parsePolicyInput } from "../src/admission/parse-policy-input.ts";
+import { BINDING_CUSTOM_TYPE } from "../src/binding/actor-binding.ts";
+import { readPersistedBinding } from "../src/binding/read-persisted-binding.ts";
+import { child, root } from "./admission-fixtures.ts";
+
+const schema = JSON.parse(readFileSync(new URL("../docs/design/fsm-compatibility/subplans/fsm-1-admission-binding.schema.json", import.meta.url), "utf8"));
+const ajv = new Ajv({ strict: true, allErrors: true });
+ajv.addSchema(schema);
+const policySchema = ajv.getSchema(`${schema.$id}#/definitions/PolicyInput`);
+const launchSchema = ajv.getSchema(`${schema.$id}#/definitions/LaunchRequest`);
+const bindingSchema = ajv.getSchema(`${schema.$id}#/definitions/PersistedBinding`);
+assert.ok(policySchema && launchSchema && bindingSchema);
+
+test("shape schema and policy parser reject the same authority field errors", () => {
+	const valid = { allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 };
+	const cases = [valid, { ...valid, allowedAgentNames: [] }, null, [], { ...valid, allowedAgentNames: ["a", "a"] },
+		{ ...valid, allowedAgentNames: [" a"] }, { ...valid, maxDepth: 0 }, { ...valid, maxDepth: 1.5 },
+		{ ...valid, internal: true }, { ...valid, requiredExtensions: [{ id: "a", path: "" }] }];
+	for (const value of cases) assert.equal(parsePolicyInput(value).ok, policySchema(value), JSON.stringify(value));
+});
+
+test("launch shape rejects all model-controlled authority fields", () => {
+	const valid = { agentName: "a", executionMode: "async" };
+	assert.equal(launchSchema(valid), true);
+	for (const key of ["rootSessionId", "callerSessionId", "internal", "runner", "extensions", "policy"]) {
+		assert.equal(launchSchema({ ...valid, [key]: true }), false);
+	}
+	assert.equal(launchSchema({ ...valid, executionMode: "external" }), false);
+});
+
+test("binding shape requires root/child variants and original mandatory baseline", () => {
+	for (const binding of [root(), child()]) {
+		assert.equal(bindingSchema(binding), true);
+		const entries = [{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: binding }];
+		assert.equal(readPersistedBinding(entries, binding.sessionId).ok, true);
+		for (const key of Object.keys(binding)) {
+			const damaged: Record<string, unknown> = { ...binding };
+			delete damaged[key];
+			assert.equal(bindingSchema(damaged), false, key);
+			assert.equal(readPersistedBinding([{ ...entries[0], type: "custom", data: damaged }], binding.sessionId).ok, false, key);
+		}
+	}
+	assert.equal(bindingSchema({ ...root(), requiredExtensions: [] }), false);
+	assert.equal(bindingSchema({ ...root(), requiredExtensions: [{ id: "other", path: "/other.ts" }] }), false);
+	assert.equal(bindingSchema({ ...root(), parentSessionId: "p" }), false);
+});
+
+test("shape success does not replace identity, duplicate-path or absolute-path semantics", () => {
+	const wrongSelf = { ...root(), sessionId: "other" };
+	assert.equal(bindingSchema(wrongSelf), true);
+	assert.equal(readPersistedBinding([{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: wrongSelf }], "other").ok, false);
+	const relative = { ...root(), requiredExtensions: [{ id: "fsm-compatible", path: "relative.ts" }] };
+	assert.equal(bindingSchema(relative), true);
+	assert.equal(readPersistedBinding([{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: relative }], "r").ok, false);
+});
diff --git a/my-plugins/fsm-compatible/test/admission-fixtures.ts b/my-plugins/fsm-compatible/test/admission-fixtures.ts
new file mode 100644
index 000000000..68274b850
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/admission-fixtures.ts
@@ -0,0 +1,75 @@
+import assert from "node:assert/strict";
+import type { AdmissionPolicy, PolicyInput, RequiredExtension, ResolvedAgent } from "../src/admission/admission-policy.ts";
+import type { AdmissionErrorCode, AdmissionResult } from "../src/admission/admission-result.ts";
+import { buildAdmissionPolicy } from "../src/admission/build-admission-policy.ts";
+import type { BindingRecords, PendingLaunch, PersistedBinding } from "../src/binding/actor-binding.ts";
+import { createRootBinding } from "../src/binding/create-root-binding.ts";
+
+export const selfExtension: RequiredExtension = Object.freeze({ id: "fsm-compatible", path: "/plugin/index.ts", requireForAllRunners: true });
+export const extraExtension: RequiredExtension = Object.freeze({ id: "extra", path: "/plugin/extra.ts", requireForAllRunners: true });
+
+export function unwrap<T>(result: AdmissionResult<T>): T {
+	assert.ok(result.ok, JSON.stringify(result));
+	return result.value;
+}
+
+export function expectCode(result: AdmissionResult<unknown>, code: AdmissionErrorCode): void {
+	assert.deepEqual(result, { ok: false, code });
+}
+
+export function agent(name: string, ceiling: readonly string[] | null = null): ResolvedAgent {
+	return {
+		canonicalName: name,
+		runtimeName: `fsm-${name}`,
+		definitionSnapshot: { systemPrompt: name, tools: ["read"] },
+		declaredToolCeiling: ceiling,
+	};
+}
+
+export function policy(names: readonly string[] = ["a"], extensions: readonly RequiredExtension[] = [selfExtension], maxDepth = 8): AdmissionPolicy {
+	const input: PolicyInput = { allowedAgentNames: names, requiredExtensions: [], maxDepth };
+	return unwrap(buildAdmissionPolicy(input, names.map((name) => agent(name)), extensions));
+}
+
+export function records(...bindings: PersistedBinding[]): BindingRecords {
+	const data = new Map(bindings.map((binding) => [binding.sessionId, { binding }]));
+	return { find: (sessionId) => data.get(sessionId) };
+}
+
+export function child(parentSessionId = "r", sessionId = "c", source = policy()): PersistedBinding {
+	return {
+		version: 1,
+		rootSessionId: "r",
+		sessionId,
+		agentId: sessionId,
+		kind: "execution-child",
+		parentSessionId,
+		agentName: "a",
+		bootstrapRef: "/plugin/bootstrap-ref",
+		requiredExtensions: source.requiredExtensions.map(({ id, path }) => ({ id, path })),
+	};
+}
+
+export function pending(source = policy()): PendingLaunch {
+	return {
+		rootSessionId: "r",
+		callerSessionId: "r",
+		agentName: "a",
+		bootstrapRef: "/plugin/bootstrap-ref",
+		policy: source,
+		state: "allocated",
+		registeredSessionId: null,
+	};
+}
+
+export function root(source = policy()): PersistedBinding {
+	return createRootBinding("r", source);
+}
+
+export function subsets<T>(values: readonly T[]): T[][] {
+	const result: T[][] = [];
+	for (let mask = 0; mask < 2 ** values.length; mask++) {
+		result.push(values.filter((_value, index) => Boolean(mask & (1 << index))));
+	}
+	return result;
+}
diff --git a/my-plugins/fsm-compatible/test/admission-policy.test.ts b/my-plugins/fsm-compatible/test/admission-policy.test.ts
new file mode 100644
index 000000000..cbb4cf079
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/admission-policy.test.ts
@@ -0,0 +1,139 @@
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { join } from "node:path";
+import test from "node:test";
+import type { RequiredExtension } from "../src/admission/admission-policy.ts";
+import { admitChildLaunch } from "../src/admission/admit-child-launch.ts";
+import { buildAdmissionPolicy } from "../src/admission/build-admission-policy.ts";
+import { canonicalizeRequiredExtensions } from "../src/admission/canonicalize-required-extensions.ts";
+import { narrowAdmissionPolicy } from "../src/admission/narrow-admission-policy.ts";
+import { parsePolicyInput } from "../src/admission/parse-policy-input.ts";
+import { snapshotAgentDefinition } from "../src/admission/snapshot-agent-definition.ts";
+import { agent, child, expectCode, extraExtension, policy, records, root, selfExtension, subsets, unwrap } from "./admission-fixtures.ts";
+
+const tools = { availableToolNames: ["read", "bash", "fsm_agent", "mcp__fsm__fsm_get_state"], requiredToolNames: ["fsm_agent", "mcp__fsm__fsm_get_state"] };
+const caller = { rootSessionId: "r", sessionId: "r" };
+const request = { agentName: "a", executionMode: "sync" };
+
+test("strict policy input rejects unknown, duplicate, whitespace, unsafe, accessor and sparse inputs", () => {
+	const input = { allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 };
+	assert.equal(parsePolicyInput(input).ok, true);
+	for (const value of [null, [], { ...input, internal: true }, { ...input, maxDepth: 0 }, { ...input, maxDepth: Infinity },
+		{ ...input, allowedAgentNames: ["a", "a"] }, { ...input, allowedAgentNames: [" a"] },
+		{ ...input, allowedAgentNames: ["a\0"] }, { ...input, allowedAgentNames: new Array(1) },
+		{ ...input, requiredExtensions: [{ id: "self", path: "/a", requireForAllRunners: true }] }]) {
+		expectCode(parsePolicyInput(value), "invalid-input");
+	}
+	let called = false;
+	const accessor = Object.defineProperty({}, "allowedAgentNames", { enumerable: true, get: () => { called = true; return []; } });
+	expectCode(parsePolicyInput(accessor), "invalid-input");
+	assert.equal(called, false);
+});
+
+test("canonical mandatory snapshot inspects real files but never executes extensions", () => {
+	const tempBase = fileURLToPath(new URL("./.tmp/", import.meta.url));
+	mkdirSync(tempBase, { recursive: true });
+	const dir = mkdtempSync(join(tempBase, "required-"));
+	try {
+		const self = join(dir, "self.ts");
+		const extra = join(dir, "extra.ts");
+		writeFileSync(self, "throw new Error('must not execute')\n");
+		writeFileSync(extra, "throw new Error('must not execute')\n");
+		const alias = join(dir, "alias.ts");
+		symlinkSync(extra, alias);
+		const snapshot = unwrap(canonicalizeRequiredExtensions([{ id: "x", path: alias }], self));
+		assert.deepEqual(snapshot, [{ id: "x", path: extra, requireForAllRunners: true }, { id: "fsm-compatible", path: self, requireForAllRunners: true }]);
+		assert.ok(Object.isFrozen(snapshot) && snapshot.every(Object.isFrozen));
+		expectCode(canonicalizeRequiredExtensions([{ id: "fsm-compatible", path: extra }], self), "required-extension-mismatch");
+		expectCode(canonicalizeRequiredExtensions([{ id: "x", path: alias }, { id: "y", path: extra }], self), "required-extension-mismatch");
+		expectCode(canonicalizeRequiredExtensions([{ id: "x", path: dir }], self), "required-extension-mismatch");
+		expectCode(canonicalizeRequiredExtensions([{ id: "x", path: join(dir, "missing") }], self), "required-extension-mismatch");
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+});
+
+test("mandatory limit applies after adding self", () => {
+	const files = { realpath: (path: string) => path, isFile: () => true };
+	const input = Array.from({ length: 32 }, (_value, index) => ({ id: `x${index}`, path: `/x${index}.ts` }));
+	expectCode(canonicalizeRequiredExtensions(input, "/self.ts", files), "required-extension-mismatch");
+	assert.equal(unwrap(canonicalizeRequiredExtensions(input.slice(1), "/self.ts", files)).length, 32);
+});
+
+test("only exact canonical native agent definitions enter a fixed snapshot", () => {
+	const input = { allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 };
+	const selected = unwrap(buildAdmissionPolicy(input, [agent("a"), agent("discovered")], [selfExtension]));
+	assert.deepEqual(selected.agents.map((item) => item.canonicalName), ["a"]);
+	for (const invalid of [{ ...agent("a"), runnerType: "external-cli" }, { ...agent("a"), machine: "remote" },
+		{ ...agent("a"), definitionSnapshot: { runner: { type: "external-cli" } } }]) {
+		expectCode(buildAdmissionPolicy(input, [invalid], [selfExtension]), "runner-not-admitted");
+	}
+	expectCode(buildAdmissionPolicy(input, [agent("other")], [selfExtension]), "agent-not-admitted");
+	expectCode(buildAdmissionPolicy(input, [agent("a"), agent("a")], [selfExtension]), "agent-not-admitted");
+	assert.equal(policy([]).agents.length, 0);
+});
+
+test("public definition snapshots are deep frozen copies and malformed JSON is rejected", () => {
+	const definition = { nested: { flag: true }, values: ["read"] };
+	const source = { ...agent("a"), definitionSnapshot: definition };
+	const fixed = unwrap(buildAdmissionPolicy({ allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 }, [source], [selfExtension]));
+	definition.nested.flag = false;
+	definition.values.push("bash");
+	assert.deepEqual(fixed.agents[0]?.definitionSnapshot, { nested: { flag: true }, values: ["read"] });
+	assert.ok(Object.isFrozen(fixed.agents[0]?.definitionSnapshot.nested));
+	assert.equal(Reflect.set(fixed.agents, "0", agent("x")), false);
+	assert.equal(fixed.agents[0]?.canonicalName, "a");
+	const cycle: Record<string, unknown> = {};
+	cycle.self = cycle;
+	for (const value of [cycle, { value: Infinity }, { value: undefined }, { value: new Date() }, { values: new Array(1) }]) {
+		expectCode(snapshotAgentDefinition(value), "invalid-input");
+	}
+	const custom = ["read"];
+	Object.defineProperty(custom, "00", { value: "hidden", enumerable: true });
+	expectCode(snapshotAgentDefinition({ tools: custom }), "invalid-input");
+});
+
+test("all finite parent/descendant subsets obey admission monotonicity", () => {
+	for (const parentNames of subsets(["a", "b", "c"])) {
+		for (const childNames of subsets(["a", "b", "c"])) {
+			const result = narrowAdmissionPolicy(policy(parentNames), { allowedAgentNames: childNames, requiredExtensions: [], maxDepth: 8 }, [selfExtension]);
+			assert.equal(result.ok, childNames.every((name) => parentNames.includes(name)), JSON.stringify({ parentNames, childNames }));
+			if (result.ok) assert.deepEqual(result.value.agents.map((item) => item.canonicalName), childNames);
+		}
+	}
+});
+
+test("descendants cannot remove or replace mandatory extensions or increase depth", () => {
+	const source = policy(["a"], [selfExtension, extraExtension]);
+	const wanted = { allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 };
+	for (const extensionSet of subsets([selfExtension, extraExtension])) {
+		const result = narrowAdmissionPolicy(source, wanted, extensionSet);
+		assert.equal(result.ok, extensionSet.length === 2);
+	}
+	const replaced: RequiredExtension = { ...extraExtension, path: "/plugin/replaced.ts" };
+	expectCode(narrowAdmissionPolicy(source, wanted, [selfExtension, replaced]), "policy-widened");
+	expectCode(narrowAdmissionPolicy(source, { ...wanted, maxDepth: 9 }, source.requiredExtensions), "policy-widened");
+	assert.equal(unwrap(narrowAdmissionPolicy(source, { ...wanted, maxDepth: 1 }, source.requiredExtensions)).maxDepth, 1);
+});
+
+test("launch validates actual caller, namespace, depth and required tools without effects", () => {
+	const source = policy();
+	const tree = records(root(source));
+	const admitted = unwrap(admitChildLaunch(source, caller, request, tree, tools));
+	assert.equal(admitted.callerSessionId, "r");
+	assert.equal(admitted.bootstrapRef, null);
+	assert.deepEqual(admitted.allowedToolNames, tools.availableToolNames);
+	for (const field of ["rootSessionId", "callerSessionId", "internal", "runner", "extensions", "policy"]) {
+		expectCode(admitChildLaunch(source, caller, { ...request, [field]: true }, tree, tools), "invalid-input");
+	}
+	expectCode(admitChildLaunch(source, caller, { ...request, agentName: "alias" }, tree, tools), "agent-not-admitted");
+	expectCode(admitChildLaunch(policy([]), caller, request, tree, tools), "agent-not-admitted");
+	expectCode(admitChildLaunch(source, { ...caller, sessionId: "missing" }, request, tree, tools), "parent-not-found");
+	expectCode(admitChildLaunch(source, { ...caller, rootSessionId: "other" }, request, tree, tools), "binding-mismatch");
+	const depthPolicy = policy(["a"], [selfExtension], 1);
+	expectCode(admitChildLaunch(depthPolicy, { ...caller, sessionId: "c" }, request, records(root(depthPolicy), child("r", "c", depthPolicy)), tools), "depth-exceeded");
+	const ceiling = unwrap(buildAdmissionPolicy({ allowedAgentNames: ["a"], requiredExtensions: [], maxDepth: 8 }, [agent("a", ["read"])], [selfExtension]));
+	expectCode(admitChildLaunch(ceiling, caller, request, tree, tools), "policy-widened");
+	expectCode(admitChildLaunch(source, caller, { ...request, resumeSessionFile: "/saved.jsonl" }, tree, tools), "restore-conflict");
+});
diff --git a/my-plugins/fsm-compatible/test/broker-cancellation.test.ts b/my-plugins/fsm-compatible/test/broker-cancellation.test.ts
