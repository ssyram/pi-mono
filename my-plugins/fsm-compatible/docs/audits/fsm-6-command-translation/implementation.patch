index 000000000..bcf9afeca
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/capture-turn.ts
@@ -0,0 +1,54 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { ValidateFunction } from "ajv";
+
+export interface StructuredCapture {
+	readonly toolCallId: string;
+	readonly value: Record<string, unknown>;
+	readonly time: { readonly start: number; readonly end: number };
+}
+export interface FailedCapture {
+	readonly toolCallId: string;
+	readonly input: Record<string, unknown>;
+	readonly error: string;
+	readonly time: { readonly start: number; readonly end: number };
+}
+export interface CaptureOutcome {
+	readonly kind: "captured" | "invalid";
+	readonly content: string;
+	readonly terminate: boolean;
+	readonly failed: FailedCapture | undefined;
+}
+
+/** One judge turn's StructuredOutput ledger. Conflict material is kept, never overwritten. */
+export class CaptureTurn {
+	private captured: readonly StructuredCapture[] = [];
+	private failures: readonly FailedCapture[] = [];
+	private validate: ValidateFunction;
+
+	constructor(validate: ValidateFunction) {
+		this.validate = validate;
+	}
+
+	get captures(): readonly StructuredCapture[] { return this.captured; }
+
+	get failedAttempts(): readonly FailedCapture[] { return this.failures; }
+
+	reset(validate: ValidateFunction = this.validate): void {
+		this.validate = validate;
+		this.captured = [];
+		this.failures = [];
+	}
+
+	capture(toolCallId: string, input: Record<string, unknown>): CaptureOutcome {
+		if (!toolCallId) throw new RuntimeError("protocol-invalid");
+		const start = Date.now();
+		if (!this.validate(input)) {
+			const failed: FailedCapture = { toolCallId, input, error: "structured output failed schema validation",
+				time: { start, end: Date.now() } };
+			this.failures = [...this.failures, failed];
+			return { kind: "invalid", content: failed.error, terminate: false, failed };
+		}
+		this.captured = [...this.captured, { toolCallId, value: structuredClone(input), time: { start, end: Date.now() } }];
+		return { kind: "captured", content: JSON.stringify(input), terminate: true, failed: undefined };
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-agent-tools.ts b/my-plugins/fsm-compatible/src/judge/judge-agent-tools.ts
new file mode 100644
index 000000000..86f9fbaa7
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-agent-tools.ts
@@ -0,0 +1,56 @@
+import type { AgentTool } from "@earendil-works/pi-agent-core";
+import { Type } from "typebox";
+import type { CaptureTurn } from "./capture-turn.ts";
+import { createJudgeFileTools, type JudgeToolResult } from "./judge-file-tools.ts";
+import type { JudgeToolPolicy } from "./judge-tool-policy.ts";
+
+function toToolResult(resolved: JudgeToolResult): { content: { type: "text"; text: string }[]; isError?: boolean; details?: unknown } {
+	return { content: [{ type: "text", text: resolved.content }], ...(resolved.isError ? { isError: true } : {}),
+		...(resolved.details !== undefined ? { details: resolved.details } : {}) };
+}
+
+function simpleTool(
+	name: string,
+	schema: object,
+	run: (input: unknown, signal?: AbortSignal) => JudgeToolResult | Promise<JudgeToolResult>,
+): AgentTool {
+	return {
+		name,
+		label: name,
+		parameters: schema as never,
+		// Step P3: wrappers carry the per-turn policy; execution stays within the judge cwd rules.
+		async execute(_id: string, params: unknown, signal?: AbortSignal) {
+			return toToolResult(await run(params, signal));
+		},
+	} as unknown as AgentTool;
+}
+
+const READ = Type.Object({ filePath: Type.String(), offset: Type.Optional(Type.Number()), limit: Type.Optional(Type.Number()) });
+const GREP = Type.Object({ pattern: Type.String(), path: Type.Optional(Type.String()), include: Type.Optional(Type.String()) });
+const GLOB = Type.Object({ pattern: Type.String(), path: Type.Optional(Type.String()) });
+const BASH = Type.Object({ command: Type.String(), timeout: Type.Optional(Type.Number()), workdir: Type.Optional(Type.String()) });
+const EDIT = Type.Object({ filePath: Type.String(), oldString: Type.String(), newString: Type.String(), replaceAll: Type.Optional(Type.Boolean()) });
+
+export function structuredOutputSystemSuffix(schema: Record<string, unknown>): string {
+	return `Your StructuredOutput tool input must exactly match this JSON schema:\n${JSON.stringify(schema)}`;
+}
+
+export function buildJudgeAgentTools(cwd: string, policy: JudgeToolPolicy, turn: CaptureTurn): AgentTool[] {
+	const files = createJudgeFileTools(cwd, policy.externalDirectory);
+	const tools: AgentTool[] = [];
+	if (policy.allowed.has("read")) tools.push(simpleTool("read", READ, (input, signal) => files.read(input, signal)));
+	if (policy.allowed.has("grep")) tools.push(simpleTool("grep", GREP, (input, signal) => files.grep(input, signal)));
+	if (policy.allowed.has("glob")) tools.push(simpleTool("glob", GLOB, (input, signal) => files.glob(input, signal)));
+	if (policy.allowed.has("bash")) tools.push(simpleTool("bash", BASH, (input, signal) => files.bash(input, signal)));
+	if (policy.allowed.has("edit")) tools.push(simpleTool("edit", EDIT, (input, signal) => files.edit(input, signal)));
+	tools.push({
+		name: "StructuredOutput",
+		label: "StructuredOutput",
+		parameters: Type.Object({}, { additionalProperties: true }) as never,
+		async execute(toolCallId: string, params: unknown) {
+			const outcome = turn.capture(toolCallId, (params ?? {}) as Record<string, unknown>);
+			return { content: [{ type: "text", text: outcome.content }], ...(outcome.kind === "invalid" ? { isError: true } : { terminate: true }) };
+		},
+	} as unknown as AgentTool);
+	return tools;
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-directory-read.ts b/my-plugins/fsm-compatible/src/judge/judge-directory-read.ts
new file mode 100644
index 000000000..8fafa2097
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-directory-read.ts
@@ -0,0 +1,55 @@
+import { readdir, stat } from "node:fs/promises";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface DirectoryWindow {
+	readonly path: string;
+	readonly offset: number;
+	readonly entries: readonly string[];
+	readonly totalEntries: number;
+	readonly truncated: boolean;
+	readonly output: string;
+	readonly preview: string;
+}
+
+const DEFAULT_LIMIT = 2000;
+
+async function entryName(directory: string, item: { name: string; isDirectory(): boolean; isSymbolicLink(): boolean }): Promise<string> {
+	if (!item.isSymbolicLink()) return item.isDirectory() ? `${item.name}/` : item.name;
+	try {
+		const target = await stat(join0(directory, item.name));
+		return target.isDirectory() ? `${item.name}/` : item.name;
+	} catch {
+		return item.name;
+	}
+}
+
+function join0(directory: string, name: string): string {
+	return `${directory.replace(/\/+$/, "")}/${name}`;
+}
+
+/** OC directory read: full real listing, sorted, 1-indexed window. Never paginates an already-truncated view. */
+export async function readDirectoryWindow(path: string, offsetInput: number | undefined, limitInput: number | undefined): Promise<DirectoryWindow> {
+	if (offsetInput !== undefined && (!Number.isSafeInteger(offsetInput) || offsetInput < 0)) throw new RuntimeError("protocol-invalid");
+	if (limitInput !== undefined && (!Number.isSafeInteger(limitInput) || limitInput < 0)) throw new RuntimeError("protocol-invalid");
+	const items = await readdir(path, { withFileTypes: true });
+	const names: string[] = [];
+	for (const item of items) names.push(await entryName(path, item));
+	names.sort((left, right) => left.localeCompare(right));
+	const offset = offsetInput || 1;
+	const limit = limitInput ?? DEFAULT_LIMIT;
+	const start = offset - 1;
+	const sliced = names.slice(start, start + limit);
+	const truncated = start + sliced.length < names.length;
+	const output = [
+		`<path>${path}</path>`,
+		"<type>directory</type>",
+		"<entries>",
+		sliced.join("\n"),
+		truncated
+			? `\n(Showing ${sliced.length} of ${names.length} entries. Use 'offset' parameter to read beyond entry ${offset + sliced.length})`
+			: `\n(${names.length} entries)`,
+		"</entries>",
+	].join("\n");
+	return { path, offset, entries: Object.freeze(sliced), totalEntries: names.length, truncated, output,
+		preview: sliced.slice(0, 20).join("\n") };
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-envelope.ts b/my-plugins/fsm-compatible/src/judge/judge-envelope.ts
new file mode 100644
index 000000000..a0a1e9ee0
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-envelope.ts
@@ -0,0 +1,33 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { OcPart } from "../records/oc-shapes.ts";
+import type { CaptureTurn } from "./capture-turn.ts";
+
+export function structuredOutputParts(turn: CaptureTurn, sessionId: string, messageEntryId: string): readonly OcPart[] {
+	// Step P3: every real capture and failed attempt becomes a part; the driver judges conflicts.
+	const parts: OcPart[] = [];
+	let index = 0;
+	for (const failure of turn.failedAttempts) {
+		parts.push({ type: "tool", id: `prt_${messageEntryId}_so_${index++}`, sessionID: sessionId,
+			messageID: `msg_${messageEntryId}`, tool: "StructuredOutput", callID: failure.toolCallId,
+			state: { input: failure.input, status: "error", error: failure.error, time: failure.time } });
+	}
+	for (const capture of turn.captures) {
+		parts.push({ type: "tool", id: `prt_${messageEntryId}_so_${index++}`, sessionID: sessionId,
+			messageID: `msg_${messageEntryId}`, tool: "StructuredOutput", callID: capture.toolCallId,
+			state: { input: capture.value, status: "completed", output: JSON.stringify(capture.value),
+				time: capture.time } });
+	}
+	return parts;
+}
+
+export function conflictSnapshot(turn: CaptureTurn): { readonly conflicting: boolean; readonly distinctValues: number } {
+	const values = new Set<string>();
+	for (const capture of turn.captures) values.add(JSON.stringify(capture.value));
+	return { conflicting: values.size > 1, distinctValues: values.size };
+}
+
+export function requireCaptureInput(value: unknown): Record<string, unknown> {
+	if (!isAdmissionObject(value)) throw new RuntimeError("protocol-invalid");
+	return value;
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-file-tools.ts b/my-plugins/fsm-compatible/src/judge/judge-file-tools.ts
new file mode 100644
index 000000000..d44cd0f7f
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-file-tools.ts
@@ -0,0 +1,122 @@
+import { mkdir, readFile, stat, writeFile } from "node:fs/promises";
+import { dirname } from "node:path";
+import {
+	createBashTool, createEditTool, createFindTool, createGrepTool, createReadTool, withFileMutationQueue,
+} from "@earendil-works/pi-coding-agent";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { readDirectoryWindow } from "./judge-directory-read.ts";
+import { resolveScopedPath } from "./judge-path-scope.ts";
+
+export interface JudgeToolResult {
+	readonly content: string;
+	readonly isError: boolean;
+	readonly details?: unknown;
+}
+type Signal = AbortSignal | undefined;
+type SdkTool = { execute: (id: string, params: unknown, signal?: AbortSignal) => Promise<{ content: { type: string; text?: string }[] }> };
+
+async function runSdk(tool: SdkTool, params: unknown, signal?: Signal): Promise<JudgeToolResult> {
+	try {
+		const result = await tool.execute("judge", params, signal);
+		return { content: result.content.map((block) => block.text ?? "").join("\n"), isError: false };
+	} catch (error) {
+		return { content: error instanceof Error ? error.message : "tool failed", isError: true };
+	}
+}
+
+function requireString(value: unknown, field: string): string {
+	if (typeof value !== "string" || !value) throw new RuntimeError("protocol-invalid");
+	return value;
+}
+function optionalIndex(value: unknown): number | undefined {
+	return value === undefined ? undefined : (() => { if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) throw new RuntimeError("protocol-invalid"); return value; })();
+}
+
+export function createJudgeFileTools(cwd: string, allowExternal: boolean) {
+	const read = createReadTool(cwd);
+	const grep = createGrepTool(cwd);
+	const find = createFindTool(cwd);
+	const edit = createEditTool(cwd);
+
+	return {
+		async read(input: unknown, signal?: Signal): Promise<JudgeToolResult> {
+			if (!isAdmissionObject(input)) throw new RuntimeError("protocol-invalid");
+			const target = resolveScopedPath(cwd, requireString(input.filePath, "filePath"), allowExternal);
+			const offset = optionalIndex(input.offset);
+			const limit = optionalIndex(input.limit);
+			const info = await stat(target).catch(() => undefined);
+			if (info?.isDirectory()) {
+				const window = await readDirectoryWindow(target, offset, limit);
+				return { content: window.output, isError: false, details: { type: "directory", path: window.path,
+					entries: window.entries, offset: window.offset, totalEntries: window.totalEntries, truncated: window.truncated,
+					preview: window.preview } };
+			}
+			return runSdk(read as unknown as SdkTool, { path: target, offset: offset || 1, limit }, signal);
+		},
+		async grep(input: unknown, signal?: Signal): Promise<JudgeToolResult> {
+			if (!isAdmissionObject(input)) throw new RuntimeError("protocol-invalid");
+			const pattern = requireString(input.pattern, "pattern");
+			const path = input.path === undefined ? cwd : resolveScopedPath(cwd, requireString(input.path, "path"), allowExternal);
+			return runSdk(grep as unknown as SdkTool, { pattern, path,
+				glob: input.include === undefined ? undefined : requireString(input.include, "include"), limit: 100 }, signal);
+		},
+		async glob(input: unknown, signal?: Signal): Promise<JudgeToolResult> {
+			if (!isAdmissionObject(input)) throw new RuntimeError("protocol-invalid");
+			const pattern = requireString(input.pattern, "pattern");
+			const path = input.path === undefined ? cwd : resolveScopedPath(cwd, requireString(input.path, "path"), allowExternal);
+			return runSdk(find as unknown as SdkTool, { pattern, path, limit: 100 }, signal);
+		},
+		async bash(input: unknown, signal?: Signal): Promise<JudgeToolResult> {
+			if (!isAdmissionObject(input)) throw new RuntimeError("protocol-invalid");
+			const command = requireString(input.command, "command");
+			const workdir = input.workdir === undefined ? cwd : resolveScopedPath(cwd, requireString(input.workdir, "workdir"), allowExternal);
+			let timeoutSeconds: number | undefined;
+			if (input.timeout !== undefined) {
+				if (typeof input.timeout !== "number" || !Number.isSafeInteger(input.timeout) || input.timeout <= 0) throw new RuntimeError("protocol-invalid");
+				timeoutSeconds = input.timeout / 1000;
+			}
+			const tool = createBashTool(workdir);
+			return runSdk(tool as unknown as SdkTool, { command, ...(timeoutSeconds === undefined ? {} : { timeout: timeoutSeconds }) }, signal);
+		},
+		async edit(input: unknown, signal?: Signal): Promise<JudgeToolResult> {
+			if (!isAdmissionObject(input)) throw new RuntimeError("protocol-invalid");
+			const filePath = requireString(input.filePath, "filePath");
+			if (typeof input.oldString !== "string" || typeof input.newString !== "string") throw new RuntimeError("protocol-invalid");
+			const oldString = input.oldString;
+			const newString = input.newString;
+			if (oldString === newString) return { content: "oldString and newString are identical", isError: true };
+			const target = resolveScopedPath(cwd, filePath, allowExternal);
+			if (oldString !== "" && input.replaceAll !== true) {
+				return runSdk(edit as unknown as SdkTool, { path: target, edits: [{ oldText: oldString, newText: newString }] }, signal);
+			}
+			return withFileMutationQueue(target, async () => {
+				if (signal?.aborted) throw new RuntimeError("cancelled");
+				const exists = await stat(target).then(() => true, () => false);
+				if (signal?.aborted) throw new RuntimeError("cancelled");
+				if (oldString === "") {
+					if (exists) return { content: "oldString cannot be empty when editing an existing file", isError: true };
+					await mkdir(dirname(target), { recursive: true });
+					if (signal?.aborted) throw new RuntimeError("cancelled");
+					await writeFile(target, newString, { flag: "wx" });
+					return { content: `created ${target}`, isError: false };
+				}
+				const raw = await readFile(target, "utf8");
+				if (signal?.aborted) throw new RuntimeError("cancelled");
+				if (!raw.includes(oldString)) return { content: "oldString not found; no replacement made", isError: true };
+				let updated = "";
+				let cursor = 0;
+				for (;;) {
+					const hit = raw.indexOf(oldString, cursor);
+					if (hit < 0) break;
+					updated += raw.slice(cursor, hit) + newString;
+					cursor = hit + oldString.length;
+				}
+				updated += raw.slice(cursor);
+				if (signal?.aborted) throw new RuntimeError("cancelled");
+				await writeFile(target, updated, "utf8");
+				return { content: `replaced all occurrences in ${target}`, isError: false };
+			});
+		},
+	};
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-input.ts b/my-plugins/fsm-compatible/src/judge/judge-input.ts
new file mode 100644
index 000000000..7553f0350
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-input.ts
@@ -0,0 +1,55 @@
+import { Ajv, type ValidateFunction } from "ajv";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface JudgeInput {
+	readonly system: string;
+	readonly tools: Readonly<Record<string, boolean>>;
+	readonly schema: Record<string, unknown>;
+	readonly user: string;
+	readonly validate: ValidateFunction;
+}
+
+function parseTools(value: unknown): Readonly<Record<string, boolean>> {
+	if (!isAdmissionObject(value)) throw new RuntimeError("protocol-invalid");
+	const tools: Record<string, boolean> = {};
+	for (const [name, enabled] of Object.entries(value)) {
+		if (!name || typeof enabled !== "boolean") throw new RuntimeError("protocol-invalid");
+		tools[name] = enabled;
+	}
+	return Object.freeze(tools);
+}
+
+function parseUser(value: unknown): string {
+	if (!Array.isArray(value) || !value.length) throw new RuntimeError("protocol-invalid");
+	const texts: string[] = [];
+	for (const part of value) {
+		if (!isAdmissionObject(part) || part.type !== "text" || typeof part.text !== "string") throw new RuntimeError("protocol-invalid");
+		texts.push(part.text);
+	}
+	return texts.join("\n");
+}
+
+export function parseJudgeInput(body: unknown): JudgeInput {
+	// Step P3: one request -> one turn; nothing here touches a model or session.
+	if (!isAdmissionObject(body)) throw new RuntimeError("protocol-invalid");
+	const known = new Set(["system", "tools", "format", "parts"]);
+	for (const key of Object.keys(body)) {
+		if (!known.has(key)) throw new RuntimeError("protocol-invalid");
+	}
+	if (typeof body.system !== "string" || !body.system) throw new RuntimeError("protocol-invalid");
+	const tools = parseTools(body.tools);
+	if (!isAdmissionObject(body.format) || body.format.type !== "json_schema" || !isAdmissionObject(body.format.schema)) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	const schema = structuredClone(body.format.schema);
+	const schemaVersion = schema.$schema;
+	if (schemaVersion !== undefined && typeof schemaVersion !== "string") throw new RuntimeError("protocol-invalid");
+	const engine = typeof schemaVersion === "string" && schemaVersion.includes("2020-12")
+		? new Ajv2020({ strict: false, allErrors: true, validateFormats: false })
+		: new Ajv({ strict: false, allErrors: true, validateFormats: false });
+	let validate: ValidateFunction;
+	try { validate = engine.compile(schema); } catch { throw new RuntimeError("protocol-invalid"); }
+	return Object.freeze({ system: body.system, tools, schema, user: parseUser(body.parts), validate });
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-path-scope.ts b/my-plugins/fsm-compatible/src/judge/judge-path-scope.ts
new file mode 100644
index 000000000..434810daf
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-path-scope.ts
@@ -0,0 +1,27 @@
+import { existsSync, realpathSync } from "node:fs";
+import { basename, dirname, isAbsolute, join, sep } from "node:path";
+import { resolve } from "node:path";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+/** Resolve a judge tool path against cwd; outside access requires the external_directory grant. */
+export function resolveScopedPath(cwd: string, raw: string, allowExternal: boolean): string {
+	if (typeof raw !== "string" || !raw) throw new RuntimeError("protocol-invalid");
+	const absolute = isAbsolute(raw) ? raw : resolve(cwd, raw);
+	const realCwd = realpathSync(cwd);
+	if (allowExternal) return absolute;
+	const target = existsSync(absolute) ? realpathSync(absolute) : joinNearest(absolute);
+	if (target !== realCwd && !target.startsWith(`${realCwd}${sep}`)) throw new RuntimeError("protocol-invalid");
+	return target;
+}
+
+function joinNearest(absolute: string): string {
+	let probe = absolute;
+	const missing: string[] = [];
+	for (;;) {
+		if (existsSync(probe)) return join(realpathSync(probe), ...missing.reverse());
+		const parent = dirname(probe);
+		missing.push(basename(probe));
+		if (parent === probe) return join(realpathSync(probe), ...missing.reverse());
+		probe = parent;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-session.ts b/my-plugins/fsm-compatible/src/judge/judge-session.ts
new file mode 100644
index 000000000..97db4fd0c
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-session.ts
@@ -0,0 +1,143 @@
+import { randomUUID } from "node:crypto";
+import { Agent } from "@earendil-works/pi-agent-core";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { Model } from "@earendil-works/pi-ai";
+import type { SessionEntry } from "@earendil-works/pi-coding-agent";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { projectOcMessages } from "../records/oc-messages.ts";
+import type { OcMessage } from "../records/oc-shapes.ts";
+import type { RecordStore } from "../records/record-store.ts";
+import { CaptureTurn } from "./capture-turn.ts";
+import { buildJudgeAgentTools, structuredOutputSystemSuffix } from "./judge-agent-tools.ts";
+import type { JudgeInput } from "./judge-input.ts";
+import { resolveJudgeToolPolicy } from "./judge-tool-policy.ts";
+import { structuredOutputParts } from "./judge-envelope.ts";
+
+export interface JudgeModelSource {
+	readonly model: Model<any>;
+	getApiKey(): string | undefined;
+	// Step P3: streaming goes through the same provider path as the real host.
+	readonly streamFn: unknown;
+}
+
+interface JudgeEntry {
+	transcript: AgentMessage[];
+	agent: Agent | undefined;
+}
+
+function judgeEntries(messages: readonly AgentMessage[]): SessionEntry[] {
+	return messages.map((message, index) => {
+		const timestamp = typeof (message as { timestamp?: number }).timestamp === "number"
+			? (message as { timestamp: number }).timestamp : 0;
+		return { type: "message", id: `jm${index}`, parentId: index > 0 ? `jm${index - 1}` : null,
+			timestamp: new Date(timestamp).toISOString(), message } as SessionEntry;
+	});
+}
+
+async function waitForIdleBounded(agent: Agent, budgetMs: number): Promise<boolean> {
+	return Promise.race([
+		agent.waitForIdle().then(() => true),
+		new Promise<boolean>((resolve) => {
+			const timer = setTimeout(() => resolve(false), budgetMs);
+			timer.unref();
+		}),
+	]);
+}
+
+/** Judge sessions per OC contract: one real transcript per sid, one turn per POST message. */
+export class JudgeSessions {
+	private readonly entries = new Map<string, JudgeEntry>();
+	private readonly store: RecordStore;
+	private readonly cwd: string;
+	private readonly source: JudgeModelSource;
+	private readonly maxJudges: number;
+
+	constructor(store: RecordStore, cwd: string, source: JudgeModelSource, maxJudges = 64) {
+		if (!store || !cwd || !source?.model || typeof source.getApiKey !== "function" || !source.streamFn
+			|| !Number.isSafeInteger(maxJudges) || maxJudges < 1) throw new RuntimeError("not-ready");
+		this.store = store;
+		this.cwd = cwd;
+		this.source = source;
+		this.maxJudges = maxJudges;
+	}
+
+	create(): string {
+		if (this.entries.size >= this.maxJudges) throw new RuntimeError("queue-full");
+		const sessionId = randomUUID();
+		this.entries.set(sessionId, { transcript: [], agent: undefined });
+		this.store.registerJudge({ sessionId, title: "fsm-gate", createdAt: Date.now(), updatedAt: Date.now(),
+			sessionFile: null, lifecycle: "idle" });
+		return sessionId;
+	}
+
+	async run(sessionId: string, input: JudgeInput): Promise<OcMessage> {
+		const entry = this.entries.get(sessionId);
+		if (!entry) throw new RuntimeError("not-ready");
+		if (entry.agent) throw new RuntimeError("queue-full");
+		const policy = resolveJudgeToolPolicy(input.tools);
+		// Step P3: web factories are wired by the install unit; requesting them stays explicit not-ready.
+		if (policy.allowed.has("webfetch") || policy.allowed.has("websearch")) throw new RuntimeError("not-ready");
+		this.store.updateJudge(sessionId, "busy", Date.now());
+		const capture = new CaptureTurn(input.validate);
+		let agent: Agent | undefined;
+		try {
+			const tools = buildJudgeAgentTools(this.cwd, policy, capture);
+			agent = new Agent({
+				getApiKey: () => this.source.getApiKey(),
+				streamFn: this.source.streamFn as never,
+				initialState: { model: this.source.model,
+					systemPrompt: `${input.system}\n\n${structuredOutputSystemSuffix(input.schema)}`,
+					tools, messages: structuredClone(entry.transcript) },
+				finishTurn: async (turn: unknown): Promise<{ action: "continue" | "end" } | undefined> => {
+					const stopReason = (turn as { message?: { stopReason?: string } }).message?.stopReason;
+					if (stopReason === "error" || stopReason === "aborted" || stopReason === "length") return undefined;
+					if (capture.captures.length > 0) return { action: "end" };
+					return undefined;
+				},
+			});
+			entry.agent = agent;
+			await agent.prompt(input.user);
+			await agent.waitForIdle();
+			const updated = agent.state.messages;
+			entry.transcript = [...updated];
+			const envelope = this.terminalEnvelope(sessionId, updated, capture);
+			this.store.updateJudge(sessionId, "idle", Date.now());
+			return envelope;
+		} finally {
+			entry.agent = undefined;
+		}
+	}
+
+	// Step P4: true means generation actually stopped; unconfirmed aborts stay not-ready.
+	async abort(sessionId: string): Promise<true> {
+		const entry = this.entries.get(sessionId);
+		if (!entry) throw new RuntimeError("not-ready");
+		const agent = entry.agent;
+		if (!agent) {
+			this.store.updateJudge(sessionId, "idle", Date.now());
+			return true;
+		}
+		agent.abort();
+		const idle = await waitForIdleBounded(agent, 10000);
+		if (!idle) throw new RuntimeError("not-ready");
+		this.store.updateJudge(sessionId, "idle", Date.now());
+		return true;
+	}
+
+	close(): void {
+		for (const entry of this.entries.values()) entry.agent?.abort();
+		this.entries.clear();
+	}
+
+	private terminalEnvelope(sessionId: string, messages: readonly AgentMessage[], capture: CaptureTurn): OcMessage {
+		const projected = projectOcMessages({ sessionId, branch: judgeEntries(messages) });
+		const index = projected.findLastIndex((message) => message.info.role === "assistant");
+		if (index < 0) throw new RuntimeError("protocol-invalid");
+		const last = projected[index]!;
+		const transcriptIndex = messages.findLastIndex((message) => (message as { role?: string }).role === "assistant");
+		if (transcriptIndex < 0) throw new RuntimeError("protocol-invalid");
+		const soParts = structuredOutputParts(capture, sessionId, `jm${transcriptIndex}`);
+		const parts = last.parts.filter((part) => !(part.type === "tool" && part.tool === "StructuredOutput"));
+		return { info: last.info, parts: [...parts, ...soParts], ...(last.metadata ? { metadata: last.metadata } : {}) };
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/judge/judge-tool-policy.ts b/my-plugins/fsm-compatible/src/judge/judge-tool-policy.ts
new file mode 100644
index 000000000..b9da060fb
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/judge/judge-tool-policy.ts
@@ -0,0 +1,30 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+const BASE_TOOLS = ["read", "grep", "glob"] as const;
+const EXTRA_TOOLS = ["bash", "edit", "webfetch", "websearch"] as const;
+const DENY_ALIASES = new Set(["write", "apply_patch", "list_mcp_resources", "list_mcp_resource_templates", "read_mcp_resource"]);
+const ALL_KNOWN = new Set<string>([...BASE_TOOLS, ...EXTRA_TOOLS, "external_directory", "StructuredOutput"]);
+
+export interface JudgeToolPolicy {
+	readonly allowed: ReadonlySet<string>;
+	readonly externalDirectory: boolean;
+}
+
+export function resolveJudgeToolPolicy(tools: Readonly<Record<string, boolean>>): JudgeToolPolicy {
+	// Step P3: wildcard deny with an explicit allow list; unknown names never enable anything.
+	if (tools["*"] !== false) throw new RuntimeError("protocol-invalid");
+	if (tools.StructuredOutput !== true) throw new RuntimeError("protocol-invalid");
+	const allowed = new Set<string>(BASE_TOOLS);
+	let externalDirectory = false;
+	for (const [name, enabled] of Object.entries(tools)) {
+		if (name === "*" || name === "StructuredOutput") continue;
+		if (!ALL_KNOWN.has(name) || DENY_ALIASES.has(name)) {
+			if (enabled) throw new RuntimeError("protocol-invalid");
+			continue;
+		}
+		if (!enabled) continue;
+		if (name === "external_directory") { externalDirectory = true; continue; }
+		allowed.add(name);
+	}
+	return Object.freeze({ allowed, externalDirectory });
+}
diff --git a/my-plugins/fsm-compatible/src/process/owned-process.ts b/my-plugins/fsm-compatible/src/process/owned-process.ts
new file mode 100644
index 000000000..3f920fec1
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/process/owned-process.ts
@@ -0,0 +1,53 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+
+export interface ProcessExit {
+	readonly code: number | null;
+	readonly signal: NodeJS.Signals | null;
+	readonly spawnFailed: boolean;
+}
+export interface OwnedProcess {
+	readonly child: ChildProcessWithoutNullStreams;
+	readonly closed: Promise<ProcessExit>;
+	close(deadline: number): Promise<boolean>;
+}
+
+export function startOwnedProcess(command: string, args: readonly string[], env: NodeJS.ProcessEnv, cwd?: string): OwnedProcess {
+	const child = spawn(command, [...args], { env, ...(cwd ? { cwd } : {}), stdio: ["pipe", "pipe", "pipe"], shell: false });
+	let ended = false;
+	let spawnFailed = false;
+	child.on("error", () => { spawnFailed = true; });
+	const closed = new Promise<ProcessExit>((resolve) => {
+		child.once("close", (code, signal) => {
+			ended = true;
+			resolve(Object.freeze({ code, signal, spawnFailed }));
+		});
+	});
+	let closing: Promise<boolean> | undefined;
+	return {
+		child,
+		closed,
+		close(deadline) {
+			if (ended) return Promise.resolve(true);
+			if (closing) return closing;
+			closing = new Promise<boolean>((resolve) => {
+				let complete = false;
+				const finish = (value: boolean) => {
+					if (complete) return;
+					complete = true;
+					clearTimeout(killTimer);
+					clearTimeout(limitTimer);
+					resolve(value);
+				};
+				child.stdin.end();
+				child.kill("SIGTERM");
+				const remaining = Math.max(0, deadline - Date.now());
+				const killTimer = setTimeout(() => { if (!ended) child.kill("SIGKILL"); }, Math.min(250, remaining));
+				const limitTimer = setTimeout(() => finish(false), remaining);
+				killTimer.unref();
+				limitTimer.unref();
+				void closed.then(() => finish(true));
+			});
+			return closing;
+		},
+	};
+}
diff --git a/my-plugins/fsm-compatible/src/process/read-json-process.ts b/my-plugins/fsm-compatible/src/process/read-json-process.ts
new file mode 100644
index 000000000..9a8e22521
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/process/read-json-process.ts
@@ -0,0 +1,52 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { startOwnedProcess } from "./owned-process.ts";
+
+export interface JsonProcessOptions {
+	readonly command: string;
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly cwd?: string;
+	readonly deadline: number;
+	readonly input?: unknown;
+	readonly signal?: AbortSignal;
+	readonly maxBytes?: number;
+}
+
+export async function readJsonProcess(options: JsonProcessOptions): Promise<unknown> {
+	if (options.signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= options.deadline) throw new RuntimeError("deadline-exceeded");
+	const owned = startOwnedProcess(options.command, options.args, options.env, options.cwd);
+	const chunks: Buffer[] = [];
+	let bytes = 0;
+	let failure: RuntimeError | undefined;
+	const abort = (code: "cancelled" | "deadline-exceeded" | "protocol-invalid") => {
+		failure ??= new RuntimeError(code);
+		owned.child.kill("SIGKILL");
+	};
+	const onAbort = () => abort("cancelled");
+	const timeout = setTimeout(() => abort("deadline-exceeded"), Math.max(0, options.deadline - Date.now()));
+	timeout.unref();
+	options.signal?.addEventListener("abort", onAbort, { once: true });
+	owned.child.stdout.on("data", (chunk: Buffer) => {
+		bytes += chunk.length;
+		if (bytes > (options.maxBytes ?? 1024 * 1024)) abort("protocol-invalid");
+		else chunks.push(chunk);
+	});
+	owned.child.stderr.resume();
+	owned.child.stdin.on("error", () => { failure ??= new RuntimeError("transport-failed"); });
+	try {
+		owned.child.stdin.end(options.input === undefined ? undefined : JSON.stringify(options.input));
+		const exit = await owned.closed;
+		if (failure) throw failure;
+		if (exit.spawnFailed || exit.code !== 0 || exit.signal !== null) throw new RuntimeError("transport-failed");
+		try {
+			return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+		} catch {
+			throw new RuntimeError("protocol-invalid");
+		}
+	} finally {
+		clearTimeout(timeout);
+		options.signal?.removeEventListener("abort", onAbort);
+		if (!(await owned.close(Date.now() + 10000))) throw new RuntimeError("transport-failed");
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/protocol/oc-handlers.ts b/my-plugins/fsm-compatible/src/protocol/oc-handlers.ts
new file mode 100644
index 000000000..6bd815986
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/protocol/oc-handlers.ts
@@ -0,0 +1,100 @@
+import { OcHttpError } from "./oc-route.ts";
+import type { OcHandlers } from "./oc-server.ts";
+import type { RecordStore } from "../records/record-store.ts";
+import { projectOcMessages } from "../records/oc-messages.ts";
+import { projectOcRoster, projectOcStatuses } from "../records/oc-roster.ts";
+import type { JudgeSessions } from "../judge/judge-session.ts";
+import { parseJudgeInput } from "../judge/judge-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { ExecutionRecord } from "../records/session-record.ts";
+import type { AdvisoryQueue } from "../watch/advisory-queue.ts";
+
+function requireExecution(store: RecordStore, sessionId: string): ExecutionRecord {
+	const record = store.getExecution(sessionId);
+	if (!record) {
+		if (store.getJudge(sessionId)) throw new OcHttpError(403);
+		throw new OcHttpError(404);
+	}
+	return record;
+}
+function requireJudge(store: RecordStore, sessionId: string): void {
+	if (store.getExecution(sessionId)) throw new OcHttpError(403);
+	if (!store.getJudge(sessionId)) throw new OcHttpError(404);
+}
+
+/** Wires the OC HTTP surface to the real record store and judge sessions. */
+export function createOcHandlers(store: RecordStore, judges: JudgeSessions, extras?: {
+	launchAck?: (bootstrapRef: string, childSessionId: string) => void;
+	advisories?: AdvisoryQueue;
+}): OcHandlers {
+	return {
+		roster: () => projectOcRoster(store),
+		statuses: () => Object.fromEntries(projectOcStatuses(store)),
+		session: (id) => {
+			const roster = projectOcRoster(store).find((session) => session.id === id);
+			if (roster) return roster;
+			requireExecution(store, id);
+			throw new OcHttpError(404);
+		},
+		children: (id) => {
+			if (store.getJudge(id) && !store.getExecution(id)) return [];
+			requireExecution(store, id);
+			return projectOcRoster(store)
+				.filter((session) => session.parentID === id)
+				.map((session) => ({ id: session.id }));
+		},
+		messages: (id) => projectOcMessages(requireExecution(store, id)),
+		async createSession(body) {
+			if (typeof body !== "object" || body === null || Array.isArray(body)
+				|| (body as { title?: unknown }).title !== "fsm-gate"
+				|| Object.keys(body).length !== 1) throw new OcHttpError(400);
+			try {
+				return { id: judges.create() };
+			} catch (error) {
+				if (error instanceof RuntimeError && error.code === "queue-full") throw new OcHttpError(503);
+				throw error;
+			}
+		},
+		async postMessage(id, body) {
+			requireJudge(store, id);
+			let input;
+			try {
+				input = parseJudgeInput(body);
+			} catch (error) {
+				if (error instanceof RuntimeError && error.code === "protocol-invalid") throw new OcHttpError(400);
+				throw error;
+			}
+			try {
+				return await judges.run(id, input);
+			} catch (error) {
+				if (error instanceof RuntimeError && error.code === "queue-full") throw new OcHttpError(409);
+				throw error;
+			}
+		},
+		async abort(id) {
+			requireJudge(store, id);
+			return judges.abort(id);
+		},
+		async promptAsync(id, body) {
+			requireExecution(store, id);
+			if (!extras?.advisories) throw new RuntimeError("not-ready");
+			try {
+				extras.advisories.accept(id, body);
+			} catch (error) {
+				if (error instanceof RuntimeError && error.code === "protocol-invalid") throw new OcHttpError(400);
+				throw error;
+			}
+		},
+		...(extras?.launchAck ? { launchAck: (body: unknown) => {
+			if (typeof body !== "object" || body === null || typeof (body as { bootstrapRef?: unknown }).bootstrapRef !== "string"
+				|| typeof (body as { sessionId?: unknown }).sessionId !== "string") throw new OcHttpError(400);
+			try {
+				extras.launchAck?.((body as { bootstrapRef: string }).bootstrapRef, (body as { sessionId: string }).sessionId);
+				return { ok: true };
+			} catch (error) {
+				if (error instanceof RuntimeError && error.code === "not-ready") throw new OcHttpError(404);
+				throw error;
+			}
+		} } : {}),
+	};
+}
diff --git a/my-plugins/fsm-compatible/src/protocol/oc-route.ts b/my-plugins/fsm-compatible/src/protocol/oc-route.ts
new file mode 100644
index 000000000..58e612624
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/protocol/oc-route.ts
@@ -0,0 +1,58 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export class OcHttpError extends Error {
+	readonly status: number;
+	constructor(status: number) {
+		super(`oc-http-${status}`);
+		this.status = status;
+	}
+}
+
+export type OcRoute =
+	| { readonly kind: "roster" }
+	| { readonly kind: "status" }
+	| { readonly kind: "create-session" }
+	| { readonly kind: "session"; readonly id: string; readonly leaf: "meta" | "children" | "message" | "message-post" | "abort" | "prompt-async" };
+
+function decodeSegment(segment: string): string {
+	if (segment.includes("%")) {
+		try { segment = decodeURIComponent(segment); } catch { throw new OcHttpError(404); }
+	}
+	if (!segment) throw new OcHttpError(404);
+	return segment;
+}
+
+export function parseOcRoute(method: string, pathname: string): OcRoute {
+	if (pathname === "/session") {
+		if (method === "GET") return { kind: "roster" };
+		if (method === "POST") return { kind: "create-session" };
+		throw new OcHttpError(405);
+	}
+	if (pathname === "/session/status") {
+		if (method !== "GET") throw new OcHttpError(405);
+		return { kind: "status" };
+	}
+	const segments = pathname.split("/").filter((segment) => segment.length > 0);
+	if (segments[0] !== "session" || segments.length < 2) throw new OcHttpError(404);
+	const id = decodeSegment(segments[1]!);
+	const leaf = segments.length === 2 ? "meta" : `${segments[2]}`;
+	if (segments.length > 3) throw new OcHttpError(404);
+	if (leaf === "meta" && method === "GET") return { kind: "session", id, leaf: "meta" };
+	if (leaf === "children" && method === "GET" && segments.length === 3) return { kind: "session", id, leaf: "children" };
+	if (leaf === "message" && segments.length === 3) {
+		return { kind: "session", id, leaf: method === "GET" ? "message" : method === "POST" ? "message-post" : (() => { throw new OcHttpError(405); })() };
+	}
+	if (leaf === "abort" && method === "POST" && segments.length === 3) return { kind: "session", id, leaf: "abort" };
+	if (leaf === "prompt_async" && method === "POST" && segments.length === 3) return { kind: "session", id, leaf: "prompt-async" };
+	throw new OcHttpError(404);
+}
+
+export function statusForError(error: unknown): number {
+	if (error instanceof OcHttpError) return error.status;
+	if (error instanceof RuntimeError) {
+		if (error.code === "not-ready" || error.code === "owner-unavailable" || error.code === "queue-full"
+			|| error.code === "deadline-exceeded" || error.code === "transport-failed" || error.code === "protocol-invalid") return 503;
+		return 500;
+	}
+	return 500;
+}
diff --git a/my-plugins/fsm-compatible/src/protocol/oc-server.ts b/my-plugins/fsm-compatible/src/protocol/oc-server.ts
new file mode 100644
index 000000000..2661b35da
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/protocol/oc-server.ts
@@ -0,0 +1,117 @@
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import { createHash, timingSafeEqual } from "node:crypto";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { OcHttpError, parseOcRoute, statusForError } from "./oc-route.ts";
+
+export interface OcHandlers {
+	roster(): unknown;
+	statuses(): unknown;
+	session(id: string): unknown;
+	children(id: string): readonly unknown[];
+	messages(id: string): readonly unknown[];
+	createSession(body: unknown): Promise<unknown>;
+	postMessage(id: string, body: unknown): Promise<unknown>;
+	abort(id: string): Promise<true>;
+	promptAsync(id: string, body: unknown): Promise<void>;
+	launchAck?(body: unknown): unknown;
+}
+
+const BODY_LIMIT = 1024 * 1024;
+
+export class OcServer {
+	private readonly server: Server;
+	private readonly handlers: OcHandlers;
+	private expectedDigest: Buffer | null = null;
+
+	constructor(handlers: OcHandlers) {
+		this.handlers = handlers;
+		this.server = createServer((request, response) => {
+			void this.handle(request, response);
+		});
+	}
+
+	setPassword(password: string): void {
+		if (!password) throw new RuntimeError("protocol-invalid");
+		const header = Buffer.from(`opencode:${password}`).toString("base64");
+		this.expectedDigest = createHash("sha256").update(header).digest();
+	}
+
+	async listen(): Promise<string> {
+		if (!this.expectedDigest) throw new RuntimeError("not-ready");
+		const address = await new Promise<{ address: string; port: number }>((resolve, reject) => {
+			this.server.once("error", reject);
+			this.server.listen(0, "127.0.0.1", () => {
+				const bound = this.server.address();
+				if (bound && typeof bound === "object") resolve({ address: bound.address, port: bound.port });
+				else reject(new RuntimeError("transport-failed"));
+			});
+		});
+		return `http://${address.address}:${address.port}`;
+	}
+
+	close(): Promise<void> {
+		return new Promise((resolve, reject) => {
+			this.server.close((error) => { if (error) reject(error); else resolve(); });
+			this.server.closeAllConnections?.();
+		});
+	}
+
+	private authorized(header: string | undefined): boolean {
+		if (!this.expectedDigest || !header?.startsWith("Basic ")) return false;
+		const actual = createHash("sha256").update(header.slice(6)).digest();
+		return actual.length === this.expectedDigest.length && timingSafeEqual(actual, this.expectedDigest);
+	}
+
+	private async handle(request: IncomingMessage, response: ServerResponse): Promise<void> {
+		const finish = (status: number, body?: unknown) => {
+			if (status === 204) { response.writeHead(204).end(); return; }
+			response.writeHead(status, { "content-type": "application/json" });
+			response.end(body === undefined ? "" : JSON.stringify(body));
+		};
+		try {
+			if (!this.authorized(request.headers.authorization)) { finish(401, { error: "unauthorized" }); return; }
+			const url = new URL(request.url ?? "/", "http://127.0.0.1");
+			if (url.pathname === "/fsm-compatible/launch-ack" && request.method === "POST") {
+				if (!this.handlers.launchAck) { finish(404); return; }
+				return finish(200, this.handlers.launchAck(await this.readBody(request)));
+			}
+			const route = parseOcRoute(request.method ?? "", url.pathname);
+			const body = request.method === "POST" ? await this.readBody(request) : undefined;
+			if (route.kind === "roster") return finish(200, this.handlers.roster());
+			if (route.kind === "status") return finish(200, this.handlers.statuses());
+			if (route.kind === "create-session") return finish(200, await this.handlers.createSession(body));
+			if (route.leaf === "meta") return finish(200, this.handlers.session(route.id));
+			if (route.leaf === "children") return finish(200, this.handlers.children(route.id));
+			if (route.leaf === "message") return finish(200, this.handlers.messages(route.id));
+			if (route.leaf === "message-post") return finish(200, await this.handlers.postMessage(route.id, body));
+			if (route.leaf === "abort") return finish(200, await this.handlers.abort(route.id));
+			await this.handlers.promptAsync(route.id, body);
+			return finish(204);
+		} catch (error) {
+			finish(statusForError(error));
+		}
+	}
+
+	private readBody(request: IncomingMessage): Promise<unknown> {
+		return new Promise((resolve, reject) => {
+			const chunks: Buffer[] = [];
+			let bytes = 0;
+			let failed = false;
+			request.on("data", (chunk: Buffer) => {
+				bytes += chunk.length;
+				if (bytes > BODY_LIMIT) {
+					if (!failed) { failed = true; reject(new OcHttpError(413)); }
+					return;
+				}
+				chunks.push(chunk);
+			});
+			request.on("end", () => {
+				if (failed) return;
+				if (chunks.length === 0) { resolve(undefined); return; }
+				try { resolve(JSON.parse(Buffer.concat(chunks).toString("utf8"))); }
+				catch { reject(new OcHttpError(400)); }
+			});
+			request.on("error", () => { if (!failed) reject(new RuntimeError("transport-failed")); });
+		});
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/records/oc-messages.ts b/my-plugins/fsm-compatible/src/records/oc-messages.ts
new file mode 100644
index 000000000..4b8195693
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/records/oc-messages.ts
@@ -0,0 +1,162 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { entryMillis, messageMillis } from "./record-time.ts";
+import type { ExecutionRecord } from "./session-record.ts";
+import type { OcMessage, OcPart } from "./oc-shapes.ts";
+import { projectToolPart, type CallSource, type ResultSource } from "./oc-tool-parts.ts";
+
+interface ToolCallBlock { type: "toolCall"; id: string; name: string; arguments: Record<string, unknown> }
+type AnyMessage = { role: string; [key: string]: unknown };
+
+function isToolCallBlock(value: unknown): value is ToolCallBlock {
+	return isAdmissionObject(value) && value.type === "toolCall" && typeof value.id === "string"
+		&& typeof value.name === "string" && isAdmissionObject(value.arguments);
+}
+
+function isTextBlock(value: unknown): value is { type: "text"; text: string } {
+	return isAdmissionObject(value) && value.type === "text" && typeof value.text === "string";
+}
+
+function isImageBlock(value: unknown): value is { type: "image"; data: string; mimeType: string } {
+	return isAdmissionObject(value) && value.type === "image" && typeof value.data === "string" && typeof value.mimeType === "string";
+}
+
+function finishFor(stopReason: string): "stop" | "tool-calls" | "length" | "error" {
+	if (stopReason === "toolUse") return "tool-calls";
+	if (stopReason === "length") return "length";
+	if (stopReason === "error" || stopReason === "aborted") return "error";
+	return "stop";
+}
+
+function errorFor(message: AnyMessage): { name: string; data: Record<string, unknown> } | undefined {
+	const reason = message.stopReason;
+	if (reason !== "error" && reason !== "aborted" && reason !== "length") return undefined;
+	const name = reason === "aborted" ? "MessageAbortedError"
+		: reason === "length" ? "MessageOutputLengthError" : "UnknownProviderError";
+	const text = typeof message.errorMessage === "string" ? message.errorMessage.slice(0, 2000) : "";
+	return { name, data: { message: text } };
+}
+
+export function projectOcMessages(record: { readonly sessionId: string; readonly branch: readonly import("@earendil-works/pi-coding-agent").SessionEntry[] }): readonly OcMessage[] {
+	const sessionId = record.sessionId;
+	const calls = new Map<string, { block: ToolCallBlock; source: CallSource }>();
+	const results = new Map<string, ResultSource>();
+	const messages: OcMessage[] = [];
+	// Step P1: index real calls and results first; association failures reject the whole snapshot.
+	for (const entry of record.branch) {
+		if (entry.type !== "message") continue;
+		const message = entry.message as AnyMessage;
+		const fallback = entryMillis(entry);
+		if (message.role === "assistant") {
+			const created = messageMillis(message as { timestamp?: number }, fallback);
+			for (const block of message.content as unknown[]) {
+				if (!isToolCallBlock(block)) continue;
+				if (calls.has(block.id)) throw new RuntimeError("protocol-invalid");
+				calls.set(block.id, { block, source: { name: block.name, arguments: structuredClone(block.arguments), observedStart: created } });
+			}
+		}
+		if (message.role === "toolResult") {
+			const toolCallId = message.toolCallId;
+			if (typeof toolCallId !== "string" || !toolCallId || results.has(toolCallId)) throw new RuntimeError("protocol-invalid");
+			const content = message.content;
+			if (!Array.isArray(content)) throw new RuntimeError("protocol-invalid");
+			const texts = content.filter(isTextBlock).map((block) => block.text);
+			const images = content.filter(isImageBlock).map((block) => ({ data: block.data, mimeType: block.mimeType }));
+			results.set(toolCallId, {
+				toolName: typeof message.toolName === "string" ? message.toolName : "",
+				texts, images,
+				isError: message.isError === true,
+				end: messageMillis(message as { timestamp?: number }, fallback),
+				details: message.details,
+				nested: message.nestedCalls,
+			});
+		}
+	}
+	for (const [toolCallId] of results) {
+		if (!calls.has(toolCallId)) throw new RuntimeError("protocol-invalid");
+	}
+	for (const entry of record.branch) {
+		if (entry.type !== "message" && entry.type !== "custom_message") continue;
+		const message = entry.type === "message"
+			? entry.message as AnyMessage
+			: { role: "custom", customType: entry.customType, content: entry.content, details: entry.details } as AnyMessage;
+		const fallback = entryMillis(entry);
+		const created = messageMillis(message as { timestamp?: number }, fallback);
+		const push = (role: "user" | "assistant", parts: readonly OcPart[], extra?: Record<string, unknown>) => {
+			messages.push({ info: { role, id: `msg_${entry.id}`, sessionID: sessionId, time: { created } },
+				parts, ...(extra ? { metadata: { pi: Object.freeze(extra) } } : {}) });
+		};
+		if (message.role === "user" || message.role === "system" || message.role === "custom") {
+			const content = message.content;
+			const parts: OcPart[] = [];
+			if (typeof content === "string") {
+				parts.push({ type: "text", id: `prt_${entry.id}_0`, sessionID: sessionId, messageID: `msg_${entry.id}`, text: content });
+			} else if (Array.isArray(content)) {
+				for (const [index, block] of content.entries()) {
+					const id = { id: `prt_${entry.id}_${index}`, sessionID: sessionId, messageID: `msg_${entry.id}` };
+					if (isTextBlock(block)) parts.push({ type: "text", ...id, text: block.text });
+					else if (isImageBlock(block)) parts.push({ type: "file", ...id, mime: block.mimeType, url: `data:${block.mimeType};base64,${block.data}` });
+					else throw new RuntimeError("protocol-invalid");
+				}
+			} else throw new RuntimeError("protocol-invalid");
+			const extra: Record<string, unknown> = {};
+			if (message.role === "system") extra.role = "system";
+			if (message.role === "custom") {
+				extra.customType = message.customType;
+			if (message.details !== undefined) extra.details = message.details;
+			}
+			push("user", parts, extra);
+			continue;
+		}
+		if (message.role === "bashExecution") {
+			const cancelled = message.cancelled === true;
+			const exitCode = typeof message.exitCode === "number" ? message.exitCode : undefined;
+			const ok = exitCode === 0 && !cancelled;
+			const output = typeof message.output === "string" ? message.output : "";
+			const command = typeof message.command === "string" ? message.command : "";
+			const part: OcPart = { type: "tool", id: `prt_${entry.id}_0`, sessionID: sessionId,
+				messageID: `msg_${entry.id}`, tool: "bash", callID: `bash_${entry.id}`,
+				state: { input: { command }, status: ok ? "completed" : "error",
+					...(ok ? { output } : { error: output || `bash failed (exit ${String(exitCode)})` }),
+					time: { start: created } },
+				metadata: { pi: { bashExecution: { command, output, exitCode, cancelled,
+						truncated: message.truncated === true } } } };
+			const info: OcMessage["info"] = { role: "assistant", id: `msg_${entry.id}`, sessionID: sessionId,
+				time: { created }, finish: "stop" };
+			messages.push({ info, parts: [part] });
+			continue;
+		}
+		if (message.role !== "assistant") continue;
+		const parts: OcPart[] = [];
+		let end = created;
+		let allCallsResolved = true;
+		for (const block of message.content as unknown[]) {
+			if (isTextBlock(block)) {
+				parts.push({ type: "text", id: `prt_${entry.id}_${parts.length}`, sessionID: sessionId, messageID: `msg_${entry.id}`, text: block.text });
+				continue;
+			}
+			if (isAdmissionObject(block) && block.type === "thinking" && typeof block.thinking === "string") {
+				parts.push({ type: "reasoning", id: `prt_${entry.id}_${parts.length}`, sessionID: sessionId, messageID: `msg_${entry.id}`, text: block.thinking });
+				continue;
+			}
+			if (isToolCallBlock(block)) {
+				const call = calls.get(block.id);
+				if (!call) throw new RuntimeError("protocol-invalid");
+				const result = results.get(block.id);
+				if (result) end = Math.max(end, result.end);
+				else allCallsResolved = false;
+				parts.push(projectToolPart(sessionId, entry.id, parts.length, block.id, call.source, result));
+			}
+		}
+		const stopReason = typeof message.stopReason === "string" ? message.stopReason : "stop";
+		const complete = stopReason !== "pending" && (parts.every((part) => part.type !== "tool") || allCallsResolved);
+		const error = errorFor(message);
+		const info: OcMessage["info"] = { role: "assistant", id: `msg_${entry.id}`, sessionID: sessionId,
+			time: { created, ...(complete ? { completed: Math.max(created, end) } : {}) }, finish: finishFor(stopReason),
+			...(error ? { error } : {}) };
+		const extra: Record<string, unknown> = { stopReason };
+		if (typeof message.model === "string") extra.model = message.model;
+		messages.push({ info, parts, metadata: { pi: Object.freeze(extra) } });
+	}
+	return messages;
+}
diff --git a/my-plugins/fsm-compatible/src/records/oc-roster.ts b/my-plugins/fsm-compatible/src/records/oc-roster.ts
new file mode 100644
index 000000000..c62deddce
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/records/oc-roster.ts
@@ -0,0 +1,61 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { RecordStore } from "./record-store.ts";
+import { normalizeIsoTimestamp } from "./record-time.ts";
+import type { ExecutionRecord } from "./session-record.ts";
+
+export interface OcSession {
+	readonly id: string;
+	readonly parentID: string | null;
+	readonly title: string;
+	readonly time: { readonly created: number; readonly updated: number };
+}
+export type OcStatusType = "busy" | "retry" | "idle";
+export interface OcStatus { readonly type: OcStatusType }
+
+function sessionOf(record: ExecutionRecord): OcSession {
+	// Step P1: created comes from the real persisted header when it exists.
+	const created = record.header ? normalizeIsoTimestamp(record.header.timestamp) : record.updatedAt;
+	return { id: record.sessionId, parentID: record.parentSessionId, title: record.title,
+		time: { created, updated: record.updatedAt } };
+}
+
+function lifecycleStatus(lifecycle: ExecutionRecord["lifecycle"]): OcStatusType {
+	if (lifecycle === "starting" || lifecycle === "running" || lifecycle === "settling") return "busy";
+	if (lifecycle === "retrying") return "retry";
+	if (lifecycle === "idle" || lifecycle === "failed" || lifecycle === "aborted") return "idle";
+	throw new RuntimeError("not-ready");
+}
+
+export function projectOcRoster(store: RecordStore): readonly OcSession[] {
+	const sessions: OcSession[] = [];
+	const seen = new Set<string>();
+	const queue: string[] = [store.rootId];
+	while (queue.length) {
+		const current = queue.shift();
+		if (!current || seen.has(current)) throw new RuntimeError("protocol-invalid");
+		seen.add(current);
+		const record = store.getExecution(current);
+		if (record) sessions.push(sessionOf(record));
+		const children = store.executionChildren(current)
+			.map((child) => child.sessionId)
+			.sort((left, right) => (left < right ? -1 : 1));
+		queue.push(...children);
+	}
+	for (const judge of store.listJudges()) {
+		sessions.push({ id: judge.sessionId, parentID: null, title: judge.title,
+			time: { created: judge.createdAt, updated: judge.updatedAt } });
+	}
+	return sessions;
+}
+
+export function projectOcStatuses(store: RecordStore): ReadonlyMap<string, OcStatus> {
+	const statuses = new Map<string, OcStatus>();
+	for (const record of store.listExecutions()) {
+		statuses.set(record.sessionId, { type: lifecycleStatus(record.lifecycle) });
+	}
+	for (const judge of store.listJudges()) {
+		if (judge.lifecycle === "unavailable") throw new RuntimeError("not-ready");
+		statuses.set(judge.sessionId, { type: judge.lifecycle === "busy" ? "busy" : "idle" });
+	}
+	return statuses;
+}
