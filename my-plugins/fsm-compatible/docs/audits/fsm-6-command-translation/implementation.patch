+});
+
+test("source read-back failure prevents identity or MCP mutation", async (t) => {
+	const scope = join(await protocolDirectory(t), "coord");
+	const seen: string[] = [];
+	const request: DaemonRequester = async (input): Promise<DaemonReply> => {
