@@ -0,0 +1,14 @@
+export const RUNTIME_ERROR_CODES = [
+	"not-ready", "owner-unavailable", "queue-full", "deadline-exceeded",
+	"transport-failed", "protocol-invalid", "delivery-unknown", "cancelled",
+] as const;
+export type RuntimeErrorCode = (typeof RUNTIME_ERROR_CODES)[number];
+
+export class RuntimeError extends Error {
+	readonly code: RuntimeErrorCode;
+	constructor(code: RuntimeErrorCode) {
+		super(code);
+		this.name = "RuntimeError";
+		this.code = code;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/runtime/runtime-resources.ts b/my-plugins/fsm-compatible/src/runtime/runtime-resources.ts
new file mode 100644
index 000000000..da6872018
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/runtime/runtime-resources.ts
@@ -0,0 +1,36 @@
+import { RuntimeError } from "./runtime-error.ts";
+
+export type ResourceDisposer = (deadline: number) => void | Promise<void>;
+
+export class RuntimeResources {
+	private readonly disposers: ResourceDisposer[] = [];
+	private closing: Promise<void> | undefined;
+	private active = true;
+	readonly signal: AbortSignal;
+	private readonly controller = new AbortController();
+
+	constructor() { this.signal = this.controller.signal; }
+
+	own(disposer: ResourceDisposer): void {
+		if (!this.active) throw new RuntimeError("owner-unavailable");
+		this.disposers.push(disposer);
+	}
+
+	get open(): boolean { return this.active; }
+
+	close(deadline: number): Promise<void> {
+		if (this.closing) return this.closing;
+		// Step P4: revoke admission before closing resources in reverse acquisition order.
+		this.active = false;
+		this.controller.abort();
+		const disposers = this.disposers.splice(0).reverse();
+		this.closing = (async () => {
+			const failures: unknown[] = [];
+			for (const dispose of disposers) {
+				try { await dispose(deadline); } catch (error) { failures.push(error); }
+			}
+			if (failures.length) throw new AggregateError(failures, "FSM resource shutdown failed");
+		})();
+		return this.closing;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/watch/advisory-queue.ts b/my-plugins/fsm-compatible/src/watch/advisory-queue.ts
new file mode 100644
index 000000000..c9b93954d
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/watch/advisory-queue.ts
@@ -0,0 +1,75 @@
+import { randomUUID } from "node:crypto";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface AdvisoryDelivery {
+	readonly deliveryId: string;
+	readonly targetSessionId: string;
+	readonly text: string;
+	readonly at: number;
+	state: "accepted" | "scheduled" | "consumed" | "failed";
+}
+
+/** Session-owned bounded Watcher receiver queue. 204 semantics only mean accepted. */
+export class AdvisoryQueue {
+	private readonly items: AdvisoryDelivery[] = [];
+	private closed = false;
+	private readonly capacity: number;
+
+	constructor(capacity: number) {
+		this.capacity = capacity;
+		if (!Number.isSafeInteger(capacity) || capacity < 1) throw new RuntimeError("protocol-invalid");
+	}
+
+	accept(targetSessionId: string, body: unknown): AdvisoryDelivery {
+		if (this.closed) throw new RuntimeError("owner-unavailable");
+		if (!isAdmissionObject(body) || !Array.isArray(body.parts)) throw new RuntimeError("protocol-invalid");
+		const texts: string[] = [];
+		for (const part of body.parts) {
+			if (!isAdmissionObject(part) || part.type !== "text" || typeof part.text !== "string") throw new RuntimeError("protocol-invalid");
+			texts.push(part.text);
+		}
+		if (this.items.length >= this.capacity) throw new RuntimeError("queue-full");
+		const delivery: AdvisoryDelivery = { deliveryId: randomUUID(), targetSessionId, text: texts.join("\n"),
+			at: Date.now(), state: "accepted" };
+		this.items.push(delivery);
+		return delivery;
+	}
+
+	peek(): AdvisoryDelivery | undefined { return this.items[0]; }
+
+	markScheduled(deliveryId: string): void {
+		const item = this.items.find((entry) => entry.deliveryId === deliveryId);
+		if (!item || item.state !== "accepted") throw new RuntimeError("not-ready");
+		item.state = "scheduled";
+	}
+
+	markConsumed(deliveryId: string): void {
+		const item = this.items.find((entry) => entry.deliveryId === deliveryId);
+		if (!item) throw new RuntimeError("not-ready");
+		item.state = "consumed";
+		this.evict(deliveryId);
+	}
+
+	markFailed(deliveryId: string): void {
+		const item = this.items.find((entry) => entry.deliveryId === deliveryId);
+		if (!item) return;
+		item.state = "failed";
+		this.evict(deliveryId);
+	}
+
+	remove(deliveryId: string): void { this.evict(deliveryId); }
+
+	snapshot(): readonly AdvisoryDelivery[] { return [...this.items]; }
+
+	failAll(): void {
+		for (const item of this.items) item.state = "failed";
+	}
+
+	close(): void { this.closed = true; this.failAll(); }
+
+	private evict(deliveryId: string): void {
+		const index = this.items.findIndex((entry) => entry.deliveryId === deliveryId);
+		if (index >= 0) this.items.splice(index, 1);
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/watch/ask-tool.ts b/my-plugins/fsm-compatible/src/watch/ask-tool.ts
new file mode 100644
index 000000000..b554dd006
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/watch/ask-tool.ts
@@ -0,0 +1,90 @@
+import { Type } from "typebox";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import type { DaemonRequester } from "../broker/daemon-request.ts";
+import { moveGate } from "../gates/gate-moves.ts";
+import type { GateBinding } from "../gates/permission-gate.ts";
+
+export interface WaitState {
+	active: boolean;
+	since: number;
+	question: string;
+}
+
+export function createWaitState(): WaitState {
+	return { active: false, since: 0, question: "" };
+}
+
+export interface AskToolDeps {
+	readonly request: DaemonRequester;
+	readonly binding: () => GateBinding | undefined;
+	readonly waitState: WaitState;
+	readonly timeoutMs: number;
+}
+
+interface AskParams {
+	question: string;
+	options?: readonly string[];
+	header?: string;
+}
+
+function isAskParams(value: unknown): value is AskParams {
+	if (!value || typeof value !== "object") return false;
+	const record = value as Record<string, unknown>;
+	if (typeof record.question !== "string" || !record.question) return false;
+	if (record.options !== undefined && (!Array.isArray(record.options)
+		|| record.options.some((option) => typeof option !== "string"))) return false;
+	if (record.header !== undefined && typeof record.header !== "string") return false;
+	return true;
+}
+
+/**
+ * The FSM question tool. The main-gate suppress already happened at the
+ * permission verdict (bisection); this tool only owns the wait state and the
+ * ask-end release when the answer (or cancellation) arrives.
+ */
+export function registerAskTool(pi: ExtensionAPI, deps: AskToolDeps): () => void {
+	let registered = true;
+	pi.registerTool({
+		name: "AskUserQuestion",
+		label: "AskUserQuestion",
+		description: "Ask the human a task question and wait for the answer.",
+		parameters: Type.Object({
+			question: Type.String(),
+			options: Type.Optional(Type.Array(Type.String())),
+			header: Type.Optional(Type.String()),
+		}),
+		async execute(_id: string, params: unknown, _signal: AbortSignal | undefined, _onUpdate: undefined, ctx: ExtensionContext) {
+			if (!registered) throw new Error("ask tool disabled");
+			if (!isAskParams(params)) throw new Error("invalid AskUserQuestion input");
+			const current = deps.binding();
+			if (!current) throw new Error("runtime not ready");
+			const dialog = ctx.ui;
+			if (!dialog || typeof dialog.select !== "function" || typeof dialog.input !== "function") {
+				return { content: [{ type: "text" as const, text: "AskUserQuestion unavailable: no interactive UI in this mode." }], isError: true };
+			}
+			// Step P1: wait state is set before the human dialog; the verdict-time suppress already happened.
+			deps.waitState.active = true;
+			deps.waitState.since = Date.now();
+			deps.waitState.question = params.question;
+			try {
+				let answer: string;
+				if (params.options && params.options.length > 0) {
+					const selected = await dialog.select(params.header ?? "Choose", [...params.options]);
+					answer = typeof selected === "string" ? selected : String(selected ?? "");
+				} else {
+					const typed = await dialog.input(params.header ?? "Answer", "");
+					answer = typeof typed === "string" ? typed : String(typed ?? "");
+				}
+				return { content: [{ type: "text" as const, text: answer }] };
+			} catch (error) {
+				return { content: [{ type: "text" as const, text: `question cancelled: ${error instanceof Error ? error.message : "unknown"}` }], isError: true };
+			} finally {
+				// Step P1 (release): after the real answer/cancellation.
+				deps.waitState.active = false;
+				// ask-end release (best-effort) once the answer/cancellation is real.
+				void moveGate(deps.request, current, false, "ask-end", Date.now() + deps.timeoutMs);
+			}
+		},
+	} as never);
+	return () => { registered = false; };
+}
diff --git a/my-plugins/fsm-compatible/src/watch/drain-advisories.ts b/my-plugins/fsm-compatible/src/watch/drain-advisories.ts
new file mode 100644
index 000000000..f6bb191a9
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/watch/drain-advisories.ts
@@ -0,0 +1,32 @@
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import type { AdvisoryQueue } from "./advisory-queue.ts";
+
+export interface DrainLookup {
+	/** Real idle producer: the target session's isIdle()/waitForIdle() outcome. */
+	isIdle(sessionId: string): boolean;
+	/** True when the watcher custom message for this delivery is visible in the target's real branch. */
+	consumed(deliveryId: string, sessionId: string): boolean;
+}
+
+/**
+ * One drain pass: mark consumed entries first (real branch evidence), then
+ * schedule accepted deliveries for idle targets via a turn-triggering custom
+ * message. Never guesses consumption from model output.
+ */
+export function drainOnce(pi: ExtensionAPI, queue: AdvisoryQueue, lookup: DrainLookup): void {
+	// Step P3: consumption evidence first, then scheduling for idle targets.
+	for (const item of queue.snapshot()) {
+		if (item.state === "scheduled" && lookup.consumed(item.deliveryId, item.targetSessionId)) {
+			queue.markConsumed(item.deliveryId);
+			continue;
+		}
+		if (item.state !== "accepted" || !lookup.isIdle(item.targetSessionId)) continue;
+		try {
+			pi.sendMessage({ customType: "fsm-compatible:watcher", content: item.text,
+				details: { deliveryId: item.deliveryId }, display: true }, { triggerTurn: true });
+			queue.markScheduled(item.deliveryId);
+		} catch {
+			queue.markFailed(item.deliveryId);
+		}
+	}
+}
diff --git a/my-plugins/fsm-compatible/test/actor-binding.test.ts b/my-plugins/fsm-compatible/test/actor-binding.test.ts
new file mode 100644
index 000000000..c4fdacd4f
