@@ -0,0 +1,81 @@
+import assert from "node:assert/strict";
+import { join } from "node:path";
+import test from "node:test";
+import type { ExtensionAPI, ExtensionToolContext, ToolDefinition } from "@earendil-works/pi-coding-agent";
+import { FsmBroker } from "../src/broker/fsm-broker.ts";
+import { registerProjectedTools } from "../src/broker/fsm-tools.ts";
+import { projectMcpToolResult } from "../src/broker/mcp-tool-result.ts";
+import { root } from "./admission-fixtures.ts";
+import { fakeDaemon, fakeTransport, protocolDirectory } from "./broker-fixtures.ts";
+
+function toolPi(existing: string[] = []) {
+	const definitions = new Map<string, ToolDefinition>();
+	const pi = {
+		getAllTools: () => existing.map((name) => ({ name })),
+		registerTool: (definition: ToolDefinition) => { definitions.set(definition.name, definition); },
+	} as unknown as ExtensionAPI;
+	return { pi, definitions };
+}
+
+async function toolOwner(t: { after(callback: () => Promise<void> | void): void }, mode = "normal") {
+	const scope = join(await protocolDirectory(t), "coord");
+	const daemon = fakeDaemon();
+	const { transport, catalog } = await fakeTransport(t, mode);
+	const broker = new FsmBroker({ host: { pid: process.pid, startId: "100" }, source: {
+		rootSessionId: "r", pid: process.pid, cwd: "/work", serverUrl: "http://127.0.0.1:9001",
+	}, scope, request: daemon.request, transport, catalog });
+	return { broker, catalog, timeoutMs: 1000, ready: () => true, binding: () => root() };
+}
+
+test("projection preserves text/images, structured data, errors and unknown MCP blocks in details", () => {
+	const raw = { content: [{ type: "text", text: "blocked", annotations: { priority: 1 } },
+		{ type: "image", data: "aGVsbG8=", mimeType: "image/png" },
+		{ type: "resource", resource: { uri: "file:///a", text: "value" } }], structuredContent: { verdict: "block" }, isError: true };
+	const projected = projectMcpToolResult(raw);
+	assert.equal(projected.isError, true);
+	assert.deepEqual(projected.structuredContent, raw.structuredContent);
+	assert.deepEqual(projected.details, raw);
+	assert.notEqual(projected.details, raw);
+	assert.deepEqual(projected.content[1], raw.content[1]);
+	assert.equal(projected.content[2]?.type, "text");
+	for (const invalid of [{ content: [{}] }, { content: [], isError: "yes" }, { content: [], structuredContent: [] }]) {
+		assert.throws(() => projectMcpToolResult(invalid), { code: "protocol-invalid" });
+	}
+});
+
+test("registered execute uses canonical identity and returns complete results/progress", async (t) => {
+	const owner = await toolOwner(t, "progress");
+	const { pi, definitions } = toolPi();
+	const deactivate = registerProjectedTools(pi, owner);
+	assert.deepEqual([...definitions.keys()], ["mcp__fsm__fsm_get_state", "mcp__fsm__fsm_set_var"]);
+	const tool = definitions.get("mcp__fsm__fsm_get_state")!;
+	const ctx = { sessionManager: { getSessionId: () => "r" } } as unknown as ExtensionToolContext;
+	const progress: unknown[] = [];
+	const result = await tool.execute("call", {}, undefined, (value) => progress.push(value), ctx);
+	assert.equal(progress.length, 1);
+	assert.deepEqual(result.structuredContent, { tool: "fsm_get_state" });
+	assert.equal(result.isError, false);
+	deactivate();
+	await assert.rejects(tool.execute("call", {}, undefined, undefined, ctx), { code: "not-ready" });
+});
+
+test("not-ready or foreign session cannot reach the broker", async (t) => {
+	const owner = await toolOwner(t);
+	let ready = false;
+	const { pi, definitions } = toolPi();
+	registerProjectedTools(pi, { ...owner, ready: () => ready });
+	const tool = definitions.get("mcp__fsm__fsm_get_state")!;
+	const ctx = { sessionManager: { getSessionId: () => "foreign" } } as unknown as ExtensionToolContext;
+	await assert.rejects(tool.execute("call", {}, undefined, undefined, ctx), { code: "not-ready" });
+	ready = true;
+	await assert.rejects(tool.execute("call", {}, undefined, undefined, ctx), { code: "owner-unavailable" });
+});
+
+test("native/projected FSM tool conflicts are rejected without replacing existing tools", async (t) => {
+	const owner = await toolOwner(t);
+	for (const name of ["fsm_get_state", "mcp__fsm__fsm_get_state", "mcp__other__fsm_get_state"]) {
+		const { pi, definitions } = toolPi([name]);
+		assert.throws(() => registerProjectedTools(pi, owner), { code: "not-ready" });
+		assert.equal(definitions.size, 0);
+	}
+});
diff --git a/my-plugins/fsm-compatible/test/gate-moves.test.ts b/my-plugins/fsm-compatible/test/gate-moves.test.ts
new file mode 100644
index 000000000..0c73699bb
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/gate-moves.test.ts
@@ -0,0 +1,101 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { AdvisoryQueue } from "../src/watch/advisory-queue.ts";
+import { gateShouldSuppress, moveGate } from "../src/gates/gate-moves.ts";
+import type { DaemonReply, DaemonRequester } from "../src/broker/daemon-request.ts";
+import { installPermissionGate } from "../src/gates/permission-gate.ts";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+
+function fakePi() {
+	const handlers = new Map<string, (event: unknown, ctx: ExtensionContext) => unknown>();
+	const pi = { on(event: string, handler: (event: unknown, ctx: ExtensionContext) => unknown) {
+		handlers.set(event, handler);
+		return () => handlers.delete(event);
+	} } as unknown as ExtensionAPI;
+	return { pi, handlers };
+}
+
+function ctx(): ExtensionContext {
+	return { signal: undefined, ui: { notify: () => {} } } as unknown as ExtensionContext;
+}
+
+test("gate bisection: only an allowed AskUserQuestion suppresses; everything else releases", () => {
+	assert.equal(gateShouldSuppress(true, "AskUserQuestion"), true);
+	assert.equal(gateShouldSuppress(false, "AskUserQuestion"), false);
+	assert.equal(gateShouldSuppress(true, "bash"), false);
+	assert.equal(gateShouldSuppress(false, "read"), false);
+});
+
+test("permission verdicts ride the main gate best-effort; children and failures never move it", async () => {
+	const { pi, handlers } = fakePi();
+	const posts: Array<{ path: string; body: unknown }> = [];
+	const request: DaemonRequester = async (input): Promise<DaemonReply> => {
+		if (input.path === "/gate/suppress" || input.path === "/gate/release") {
+			posts.push({ path: input.path, body: input.body });
+			return { status: 200, body: { ok: true } };
+		}
+		if (input.path === "/check-permission") return { status: 200, body: { ok: true, allowed: true } };
+		if (input.path === "/check-permission-denied") return { status: 200, body: { ok: true, allowed: false } };
+		throw new Error("unexpected route");
+	};
+	installPermissionGate(pi, request, () => ({ sessionId: "r", agentId: "main" }), 5000);
+	const gate = handlers.get("tool_call")!;
+	assert.equal(await gate({ toolName: "AskUserQuestion", input: { question: "q" } }, ctx()), undefined);
+	assert.equal(await gate({ toolName: "bash", input: { command: "ls" } }, ctx()), undefined);
+	await new Promise((resolve) => setTimeout(resolve, 20));
+	assert.deepEqual(posts, [
+		{ path: "/gate/suppress", body: { session_id: "r", agent_id: "main", reason: "ask-start" } },
+		{ path: "/gate/release", body: { session_id: "r", agent_id: "main", reason: "main-tool-start" } },
+	]);
+	const failing: DaemonRequester = async (input): Promise<DaemonReply> => {
+		if (input.path === "/gate/suppress") throw new Error("gate down");
+		if (input.path === "/gate/release") throw new Error("gate down");
+		return { status: 200, body: { ok: true, allowed: true } };
+	};
+	const { pi: p2, handlers: h2 } = fakePi();
+	installPermissionGate(p2, failing, () => ({ sessionId: "r", agentId: "main" }), 5000);
+	assert.equal(await h2.get("tool_call")!({ toolName: "AskUserQuestion", input: {} }, ctx()), undefined);
+	const childRequest: DaemonRequester = async (input): Promise<DaemonReply> => {
+		if (input.path.startsWith("/gate/")) throw new Error("child must not move the main gate");
+		return { status: 200, body: { ok: true, allowed: true } };
+	};
+	const { pi: p3, handlers: h3 } = fakePi();
+	installPermissionGate(p3, childRequest, () => ({ sessionId: "c", agentId: "child-1" }), 5000);
+	assert.equal(await h3.get("tool_call")!({ toolName: "AskUserQuestion", input: {} }, ctx()), undefined);
+	assert.equal(await handlers.get("tool_call")!({ toolName: "mcp__fsm__fsm_get_state", input: {} }, ctx()), undefined);
+});
+
+test("moveGate maps main-only and swallows transport failures", async () => {
+	const posts: string[] = [];
+	const request: DaemonRequester = async (input): Promise<DaemonReply> => {
+		posts.push(input.path);
+		return { status: 200, body: { ok: true } };
+	};
+	await moveGate(request, { sessionId: "r", agentId: "main" }, true, "ask-start", Date.now() + 1000);
+	await moveGate(request, { sessionId: "c", agentId: "child" }, true, "ask-start", Date.now() + 1000);
+	const broken: DaemonRequester = async () => { throw new Error("down"); };
+	await moveGate(broken, { sessionId: "r", agentId: "main" }, false, "ask-end", Date.now() + 1000);
+	assert.deepEqual(posts, ["/gate/suppress"]);
+});
+
+test("advisory queue keeps 204 semantics: accept, deliver lifecycle, bounds and owner close", () => {
+	const queue = new AdvisoryQueue(2);
+	const first = queue.accept("r", { parts: [{ type: "text", text: "hello" }, { type: "text", text: "world" }] });
+	assert.equal(first.text, "hello\nworld");
+	assert.equal(first.state, "accepted");
+	queue.markScheduled(first.deliveryId);
+	assert.throws(() => queue.markScheduled(first.deliveryId), { code: "not-ready" });
+	queue.markConsumed(first.deliveryId);
+	assert.equal(queue.snapshot().length, 0);
+	const second = queue.accept("r", { parts: [{ type: "text", text: "x" }] });
+	const third = queue.accept("r", { parts: [{ type: "text", text: "y" }] });
+	assert.ok(second && third);
+	assert.throws(() => queue.accept("r", { parts: [{ type: "text", text: "z" }] }), { code: "queue-full" });
+	assert.throws(() => queue.accept("r", { parts: [{ type: "image" }] }), { code: "protocol-invalid" });
+	queue.markFailed(second.deliveryId);
+	const fourth = queue.accept("r", { parts: [{ type: "text", text: "w" }] });
+	assert.ok(fourth);
+	queue.close();
+	assert.deepEqual(queue.snapshot().map((item) => item.state), ["failed", "failed"]);
+	assert.throws(() => queue.accept("r", { parts: [{ type: "text", text: "late" }] }), { code: "owner-unavailable" });
+});
diff --git a/my-plugins/fsm-compatible/test/gates.test.ts b/my-plugins/fsm-compatible/test/gates.test.ts
new file mode 100644
index 000000000..729e73f3b
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/gates.test.ts
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import type { DaemonReply, DaemonRequester } from "../src/broker/daemon-request.ts";
+import { installPermissionGate } from "../src/gates/permission-gate.ts";
+import { installStopGate } from "../src/gates/stop-gate.ts";
+
+type Handler = (event: unknown, ctx: ExtensionContext) => unknown;
+
+function fakePi() {
+	const handlers = new Map<string, Handler>();
+	const pi = { on(event: string, handler: Handler) { handlers.set(event, handler); return () => handlers.delete(event); } } as unknown as ExtensionAPI;
+	return { pi, handlers };
+}
+
+function fakeCtx(): ExtensionContext {
+	return { signal: undefined, ui: { notify: () => {} } } as unknown as ExtensionContext;
+}
+
+function requester(script: Record<string, unknown | Error>): { request: DaemonRequester; seen: string[]; bodies: unknown[] } {
+	const seen: string[] = [];
+	const bodies: unknown[] = [];
+	const request: DaemonRequester = async (input): Promise<DaemonReply> => {
+		seen.push(`${input.method} ${input.path}`);
+		bodies.push(input.body);
+		const reply = script[`${input.method} ${input.path}`];
+		if (reply instanceof Error) throw reply;
+		return reply as DaemonReply;
+	};
+	return { request, seen, bodies };
+}
+
+const ok = (body: unknown): DaemonReply => ({ status: 200, body: { ok: true, ...(body as object) } });
+
+test("permission gate maps allow/deny verbatim, fails closed, checks exactly once per call", async () => {
+	const { pi, handlers } = fakePi();
+	const { request, seen, bodies } = requester({ "POST /check-permission": ok({ allowed: true }) });
+	let binding = { sessionId: "r", agentId: "main" };
+	const off = installPermissionGate(pi, request, () => binding, 5000);
+	const gate = handlers.get("tool_call")!;
+	assert.deepEqual(await gate({ toolName: "read", input: { path: "/a" } }, fakeCtx()), undefined);
+	assert.deepEqual(bodies, [{ session_id: "r", agent_id: "main", tool_name: "read", tool_input: { filePath: "/a" } }]);
+	const deniedRequest = requester({ "POST /check-permission": ok({ allowed: false, reason: "state blocks read" }) }).request;
+	const { handlers: h2 } = fakePi();
+	installPermissionGate(piAs(h2), deniedRequest, () => binding, 5000);
+	const deniedGate = h2.get("tool_call")!;
+	assert.deepEqual(await deniedGate({ toolName: "read", input: { path: "/a" } }, fakeCtx()),
+		{ block: true, reason: "state blocks read" });
+	const broken = requester({ "POST /check-permission": new Error("down") }).request;
+	const { handlers: h3 } = fakePi();
+	installPermissionGate(piAs(h3), broken, () => binding, 5000);
+	const brokenGate = h3.get("tool_call")!;
+	const result = await brokenGate({ toolName: "bash", input: { command: "ls" } }, fakeCtx());
+	assert.deepEqual(result, { block: true, reason: "FSM 门禁：check-permission 不可达，按 fail-close 拒绝。" });
+	const fsmRequest = requester({}).request;
+	const { handlers: h4 } = fakePi();
+	installPermissionGate(piAs(h4), fsmRequest, () => binding, 5000);
+	assert.equal(await h4.get("tool_call")!({ toolName: "mcp__fsm__fsm_get_state", input: {} }, fakeCtx()), undefined);
+	assert.equal(seen.length, 1);
+	assert.equal(seen[0], "POST /check-permission");
+	binding = undefined as never;
+	const notReady = await handlers.get("tool_call")!({ toolName: "read", input: {} }, fakeCtx());
+	assert.deepEqual(notReady, { block: true, reason: "fsm-compatible runtime not ready" });
+	off();
+});
+
+function piAs(handlers: Map<string, Handler>): ExtensionAPI {
+	return { on(event: string, handler: Handler) { handlers.set(event, handler); return () => handlers.delete(event); } } as unknown as ExtensionAPI;
+}
+
+test("stop gate blocks with a continuation draft and soft-gates transport failures", async () => {
+	const { pi, handlers } = fakePi();
+	const { request } = requester({ "POST /stop-check": ok({ allowed: false, reason: "review pending" }) });
+	installStopGate(pi, request, () => ({ sessionId: "r", agentId: "main" }), 5000);
+	const gate = handlers.get("agent_before_settle")!;
+	const completed = { outcome: "completed", continue: false,
+		context: { contextMessages: [{ role: "assistant", content: [{ type: "text", text: "turn output" }] }] } };
+	assert.deepEqual(await gate(completed, fakeCtx()), { entries: [{ type: "custom_message",
+		customType: "fsm-compatible:stop", content: "review pending", display: true }], continue: true });
+	const { request: allowed } = requester({ "POST /stop-check": ok({ allowed: true }) });
+	const { handlers: h2 } = fakePi();
+	installStopGate(piAs(h2), allowed, () => ({ sessionId: "r", agentId: "main" }), 5000);
+	assert.equal(await h2.get("agent_before_settle")!(completed, fakeCtx()), undefined);
+	const { request: down } = requester({ "POST /stop-check": new Error("down") });
+	const { handlers: h3 } = fakePi();
+	installStopGate(piAs(h3), down, () => ({ sessionId: "r", agentId: "main" }), 5000);
+	assert.equal(await h3.get("agent_before_settle")!(completed, fakeCtx()), undefined);
+	assert.equal(await handlers.get("agent_before_settle")!({ outcome: "aborted", continue: false, context: { contextMessages: [] } }, fakeCtx()), undefined);
+	assert.equal(await handlers.get("agent_before_settle")!({ outcome: "completed", continue: true, context: { contextMessages: [] } }, fakeCtx()), undefined);
+});
