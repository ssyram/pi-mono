+++ b/my-plugins/fsm-compatible/test/oc-roster.test.ts
@@ -0,0 +1,58 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { SessionEntry, SessionHeader } from "@earendil-works/pi-coding-agent";
+import type { PersistedBinding } from "../src/binding/actor-binding.ts";
+import { projectOcRoster, projectOcStatuses } from "../src/records/oc-roster.ts";
+import { RecordStore } from "../src/records/record-store.ts";
+import type { RecordFacts } from "../src/records/session-record.ts";
+
+function binding(sessionId: string, rootSessionId: string, parent: string | null): PersistedBinding {
+	return parent === null
+		? { version: 1, rootSessionId, sessionId, parentSessionId: null, agentId: "main",
+			kind: "execution-root", agentName: null, bootstrapRef: null, requiredExtensions: [] }
+		: { version: 1, rootSessionId, sessionId, parentSessionId: parent, agentId: sessionId,
+			kind: "execution-child", agentName: "worker", bootstrapRef: "boot", requiredExtensions: [] };
+}
+
+function facts(lifecycle: RecordFacts["lifecycle"], created: string, sessionId: string): RecordFacts {
+	const header = { type: "session", version: 3, id: sessionId, timestamp: created, cwd: "/work" } as SessionHeader;
+	return { title: "session", lifecycle, updatedAt: Date.parse(created) + 5000, header,
+		branch: [] as SessionEntry[], sessionFile: null, errorMessage: null };
+}
+
+const ROOT = "2026-10-14T10:00:00.000Z";
+
+test("roster is a real BFS of the execution tree with judges as separate roots", () => {
+	const store = new RecordStore(binding("root", "root", null));
+	store.publishExecution(binding("root", "root", null), facts("running", ROOT, "root"));
+	store.publishExecution(binding("child-b", "root", "root"), facts("idle", "2026-10-14T10:01:00.000Z", "child-b"));
+	store.publishExecution(binding("child-a", "root", "root"), facts("running", "2026-10-14T10:02:00.000Z", "child-a"));
+	store.publishExecution(binding("grand", "root", "child-a"), facts("settling", "2026-10-14T10:03:00.000Z", "grand"));
+	store.publishExecution(binding("orphan", "root", "missing-parent"), facts("running", "2026-10-14T10:04:00.000Z", "orphan"));
+	store.registerJudge({ sessionId: "judge-1", title: "fsm-gate", createdAt: Date.parse(ROOT) + 10,
+		updatedAt: Date.parse(ROOT) + 20, sessionFile: null, lifecycle: "busy" });
+	const roster = projectOcRoster(store);
+	assert.deepEqual(roster.map((session) => session.id), ["root", "child-a", "child-b", "grand", "judge-1"]);
+	assert.equal(roster[0]?.parentID, null);
+	assert.equal(roster[3]?.parentID, "child-a");
+	assert.equal(roster[4]?.parentID, null);
+	assert.deepEqual(roster[0]?.time, { created: Date.parse(ROOT), updated: Date.parse(ROOT) + 5000 });
+});
+
+test("statuses map real lifecycles and never hide unavailable facts as idle", () => {
+	const store = new RecordStore(binding("root", "root", null));
+	store.publishExecution(binding("root", "root", null), facts("retrying", ROOT, "root"));
+	store.publishExecution(binding("done", "root", "root"), facts("aborted", "2026-10-14T10:01:00.000Z", "done"));
+	store.registerJudge({ sessionId: "judge-1", title: "fsm-gate", createdAt: 1, updatedAt: 2,
+		sessionFile: null, lifecycle: "idle" });
+	assert.deepEqual(projectOcStatuses(store), new Map([["root", { type: "retry" }], ["done", { type: "idle" }], ["judge-1", { type: "idle" }]]));
+	const hidden = new RecordStore(binding("root2", "root2", null));
+	hidden.publishExecution(binding("root2", "root2", null), facts("running", ROOT, "root2"));
+	hidden.publishExecution(binding("lost", "root2", "root2"), facts("unavailable", "2026-10-14T10:01:00.000Z", "lost"));
+	assert.throws(() => projectOcStatuses(hidden), { code: "not-ready" });
+	const judgeLost = new RecordStore(binding("root3", "root3", null));
+	judgeLost.publishExecution(binding("root3", "root3", null), facts("idle", ROOT, "root3"));
+	judgeLost.registerJudge({ sessionId: "judge-x", title: "fsm-gate", createdAt: 1, updatedAt: 2,
+		sessionFile: null, lifecycle: "unavailable" });
+	assert.throws(() => projectOcStatuses(judgeLost), { code: "not-ready" });
+});
diff --git a/my-plugins/fsm-compatible/test/oc-server.test.ts b/my-plugins/fsm-compatible/test/oc-server.test.ts
new file mode 100644
index 000000000..af1750295
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/oc-server.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { OcHttpError } from "../src/protocol/oc-route.ts";
+import { OcServer, type OcHandlers } from "../src/protocol/oc-server.ts";
+import { RuntimeError } from "../src/runtime/runtime-error.ts";
+
+function handlers(overrides: Partial<OcHandlers> = {}): OcHandlers {
+	const judges = new Set<string>(["judge-1"]);
+	return {
+		roster: () => [{ id: "root", parentID: null }],
+		statuses: () => ({ root: { type: "busy" } }),
+		session: (id) => judges.has(id) || id === "root" ? { id, parentID: null } : (() => { throw new OcHttpError(404); })(),
+		children: (id) => id === "root" ? [{ id: "child" }] : (() => { throw new OcHttpError(404); })(),
+		messages: (id) => id === "root" ? [{ info: { role: "user" }, parts: [] }] : (() => { throw new OcHttpError(404); })(),
+		createSession: async (body) => {
+			if (typeof body !== "object" || body === null || (body as { title?: unknown }).title !== "fsm-gate") throw new OcHttpError(400);
+			return { id: "judge-2" };
+		},
+		postMessage: async (id, body) => {
+			if (id !== "judge-1") throw new OcHttpError(404);
+			if (typeof body !== "object" || body === null || !("system" in body)) throw new OcHttpError(400);
+			return { info: { role: "assistant", sessionID: id }, parts: [] };
+		},
+		abort: async (id) => { if (id !== "judge-1") throw new OcHttpError(404); return true; },
+		promptAsync: async (id, body) => {
+			if (id !== "root") throw new OcHttpError(404);
+			if (typeof body !== "object" || body === null) throw new OcHttpError(400);
+		},
+		...overrides,
+	};
+}
+
+interface Harness {
+	get(path: string): Promise<Response>;
+	post(path: string, body?: string): Promise<Response>;
+	put(path: string): Promise<Response>;
+	close(): Promise<void>;
+}
+
+async function withServer(overrides: Partial<OcHandlers> = {}): Promise<Harness> {
+	const server = new OcServer(handlers(overrides));
+	server.setPassword("secret-pass");
+	const base = await server.listen();
+	const authorization = `Basic ${Buffer.from("opencode:secret-pass").toString("base64")}`;
+	return {
+		get: (path: string) => fetch(`${base}${path}`, { headers: { authorization } }),
+		post: (path: string, body = "{}") => fetch(`${base}${path}`, { method: "POST", headers: { authorization }, body }),
+		put: (path: string) => fetch(`${base}${path}`, { method: "PUT", headers: { authorization } }),
+		close: () => server.close(),
+	};
+}
+
+test("basic auth gates every route; correct password passes", async (t) => {
+	const server = new OcServer(handlers());
+	server.setPassword("secret-pass");
+	const base = await server.listen();
+	t.after(() => server.close());
+	const good = `Basic ${Buffer.from("opencode:secret-pass").toString("base64")}`;
+	assert.equal((await fetch(`${base}/session`)).status, 401);
+	assert.equal((await fetch(`${base}/session`, { headers: { authorization: `Basic ${Buffer.from("opencode:nope").toString("base64")}` } })).status, 401);
+	assert.equal((await fetch(`${base}/session`, { headers: { authorization: good } })).status, 200);
+});
+
+test("GET routes serve roster/status/session/children/messages with real failures", async (t) => {
+	const harness = await withServer();
+	t.after(harness.close);
+	assert.deepEqual(await (await harness.get("/session")).json(), [{ id: "root", parentID: null }]);
+	assert.deepEqual(await (await harness.get("/session/status")).json(), { root: { type: "busy" } });
+	assert.equal((await harness.get("/session/root/message")).status, 200);
+	assert.equal((await harness.get("/session/ghost/message")).status, 404);
+	assert.equal((await harness.get("/session/ghost")).status, 404);
+	assert.equal((await harness.get("/entirely/unknown")).status, 404);
+	assert.equal((await harness.get("/session/root/children/extra")).status, 404);
+	assert.equal((await harness.put("/session")).status, 405);
+});
+
+test("POST create/message/abort/prompt_async semantics including strict 204", async (t) => {
+	const harness = await withServer();
+	t.after(harness.close);
+	const created = await harness.post("/session", JSON.stringify({ title: "fsm-gate" }));
+	assert.deepEqual(await created.json(), { id: "judge-2" });
+	assert.equal((await harness.post("/session", JSON.stringify({ title: "other" }))).status, 400);
+	const posted = await harness.post("/session/judge-1/message", JSON.stringify({ system: "s" }));
+	assert.equal((await posted.json()).info.sessionID, "judge-1");
+	assert.deepEqual(await (await harness.post("/session/judge-1/abort")).json(), true);
+	const emptyBodyAbort = await harness.post("/session/judge-1/abort", "");
+	assert.equal(emptyBodyAbort.status, 200);
+	assert.deepEqual(await emptyBodyAbort.json(), true);
+	const async204 = await harness.post("/session/root/prompt_async", JSON.stringify({ parts: [{ type: "text", text: "hi" }] }));
+	assert.equal(async204.status, 204);
+	assert.equal(await async204.text(), "");
+	assert.equal((await harness.post("/session/root/prompt_async", "{not-json")).status, 400);
+});
+
+test("unavailable facts surface as 503 and oversized bodies are rejected before handlers run", async (t) => {
+	const harness = await withServer({ statuses: () => { throw new RuntimeError("not-ready"); } });
+	t.after(harness.close);
+	assert.equal((await harness.get("/session/status")).status, 503);
+	assert.equal((await harness.post("/session/root/prompt_async", "x".repeat(1024 * 1024 + 10))).status, 413);
+});
diff --git a/my-plugins/fsm-compatible/test/root-health.test.ts b/my-plugins/fsm-compatible/test/root-health.test.ts
new file mode 100644
index 000000000..d922766d4
--- /dev/null
+++ b/my-plugins/fsm-compatible/test/root-health.test.ts
@@ -0,0 +1,148 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { installManagedFactories, type ManagedFactory } from "../src/runtime/managed-bootstrap.ts";
+import { RootHealth } from "../src/runtime/root-health.ts";
+
+type Handler = (event: unknown, ctx: ExtensionContext) => unknown;
+function fakePi() {
+	const handlers = new Map<string, Handler[]>();
+	const messages: unknown[] = [];
+	const pi = {
+		on(event: string, handler: Handler) {
+			const list = handlers.get(event) ?? [];
+			list.push(handler);
+			handlers.set(event, list);
+			return () => { const index = list.indexOf(handler); if (index >= 0) list.splice(index, 1); };
+		},
+		sendMessage: (message: unknown) => messages.push(message),
+		sendUserMessage: (message: unknown) => messages.push(message),
+	} as unknown as ExtensionAPI;
+	return {
+		pi, messages,
+		async startup(sessionId: string) {
+			const ctx = { sessionManager: { getSessionId: () => sessionId } } as unknown as ExtensionContext;
+			const snapshot = [...(handlers.get("session_start") ?? [])];
+			const errors: unknown[] = [];
+			for (const handler of snapshot) { try { await handler({}, ctx); } catch (error) { errors.push(error); } }
+			return errors;
+		},
+	};
+}
+function preparedFactory(health: RootHealth, callback?: () => void): ManagedFactory {
+	return { id: "self", canonicalPath: "/self.ts", factory(api) {
+		api.on("session_start", (_event, ctx) => {
+			const epoch = health.epoch;
+			assert.ok(epoch);
+			callback?.();
+			health.markPrepared(epoch, ctx.sessionManager.getSessionId());
+		});
+	} };
+}
+
+test("root ready requires actual initialization and every current startup callback", async () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }, { id: "extra", canonicalPath: "/extra.ts" }]);
+	const sdk = fakePi();
+	let sawNotReady = false;
+	await installManagedFactories(sdk.pi, [preparedFactory(health), { id: "extra", canonicalPath: "/extra.ts", factory(api) {
+		api.on("session_start", () => { sawNotReady = !health.ready; });
+	} }], health);
+	assert.equal(health.ready, false);
+	assert.deepEqual(await sdk.startup("r"), []);
+	assert.equal(sawNotReady, true);
+	assert.equal(health.ready, true);
+	assert.equal(health.commit(health.epoch!), false);
+});
+
+test("initialization and startup failures never become ready", async () => {
+	for (const duringStartup of [false, true]) {
+		const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }, { id: "extra", canonicalPath: "/extra.ts" }]);
+		const sdk = fakePi();
+		await installManagedFactories(sdk.pi, [preparedFactory(health), { id: "extra", canonicalPath: "/extra.ts", factory(api) {
+			if (!duringStartup) throw new Error("initialize");
+			api.on("session_start", () => { throw new Error("startup"); });
+		} }], health);
+		await sdk.startup("r");
+		assert.equal(health.ready, false);
+		await sdk.startup("new-root");
+		assert.equal(health.ready, false);
+	}
+});
+
+test("D2-2: off before dispatch removes both the real handler and its future obligation", async () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }, { id: "extra", canonicalPath: "/extra.ts" }]);
+	const sdk = fakePi();
+	let called = false;
+	await installManagedFactories(sdk.pi, [preparedFactory(health), { id: "extra", canonicalPath: "/extra.ts", factory(api) {
+		const off = api.on("session_start", () => { called = true; });
+		off(); off();
+	} }], health);
+	await sdk.startup("r");
+	assert.equal(called, false);
+	assert.equal(health.ready, true);
+});
+
+test("D2-2: off during the event does not erase its already captured callback", async () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }, { id: "extra", canonicalPath: "/extra.ts" }]);
+	const sdk = fakePi();
+	let off = () => {};
+	let calls = 0;
+	await installManagedFactories(sdk.pi, [preparedFactory(health, () => { off(); assert.equal(health.ready, false); }),
+		{ id: "extra", canonicalPath: "/extra.ts", factory(api) { off = api.on("session_start", () => { calls++; }); } }], health);
+	await sdk.startup("r");
+	assert.equal(calls, 1);
+	assert.equal(health.ready, true);
+	await sdk.startup("r2");
+	assert.equal(calls, 1);
+	assert.equal(health.ready, true);
+});
+
+test("D2-2: on during startup belongs only to the next snapshot", async () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }, { id: "extra", canonicalPath: "/extra.ts" }]);
+	const sdk = fakePi();
+	let extraApi: ExtensionAPI | undefined;
+	let registered = false;
+	let calls = 0;
+	await installManagedFactories(sdk.pi, [preparedFactory(health, () => {
+		if (registered) return;
+		registered = true;
+		assert.ok(extraApi);
+		extraApi.on("session_start", () => { calls++; });
+	}), { id: "extra", canonicalPath: "/extra.ts", factory(api) { extraApi = api; } }], health);
+	await sdk.startup("r");
+	assert.equal(calls, 0);
+	assert.equal(health.ready, true);
+	await sdk.startup("r2");
+	assert.equal(calls, 1);
+	assert.equal(health.ready, true);
+});
+
+test("old epoch acknowledgments and incomplete resources cannot commit", () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }]);
+	health.markInitialized("self", true);
+	const { token } = health.registerStartup("self");
+	const old = health.begin("r");
+	const current = health.begin("r2");
+	health.observe(old, "r", token, true);
+	health.markPrepared(old, "r");
+	assert.equal(health.commit(current), false);
+	health.observe(current, "r2", token, true);
+	assert.equal(health.commit(current), false);
+	health.markPrepared(current, "r2");
+	assert.equal(health.commit(current), true);
+	health.close();
+	assert.equal(health.ready, false);
+});
+
+test("managed factories cannot start model turns before ready; diagnostics remain explicit", async () => {
+	const health = new RootHealth([{ id: "self", canonicalPath: "/self.ts" }]);
+	const sdk = fakePi();
+	await installManagedFactories(sdk.pi, [{ id: "self", canonicalPath: "/self.ts", factory(api) {
+		assert.throws(() => api.sendUserMessage("not ready"));
+		assert.throws(() => api.sendMessage({ customType: "x", content: "x", display: true }, { triggerTurn: true }));
+		api.sendMessage({ customType: "x", content: "diagnostic", display: true }, { triggerTurn: false });
+	} }], health);
+	assert.equal(sdk.messages.length, 1);
+	await sdk.startup("r");
+	assert.equal(health.ready, false);
+});
diff --git a/my-plugins/fsm-compatible/test/runtime-resources.test.ts b/my-plugins/fsm-compatible/test/runtime-resources.test.ts
