+++ b/my-plugins/fsm-compatible/src/binding/create-root-binding.ts
@@ -0,0 +1,19 @@
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { isAdmissionIdentifier } from "../admission/parse-policy-input.ts";
+import type { RootBinding } from "./actor-binding.ts";
+
+export function createRootBinding(sessionId: string, policy: AdmissionPolicy): RootBinding {
+	// Step P6: root has no child allowlist or parent requirement.
+	if (!isAdmissionIdentifier(sessionId)) throw new Error("Invalid root session identifier");
+	return Object.freeze({
+		version: 1,
+		rootSessionId: sessionId,
+		sessionId,
+		agentId: "main",
+		kind: "execution-root",
+		parentSessionId: null,
+		agentName: null,
+		bootstrapRef: null,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+	});
+}
diff --git a/my-plugins/fsm-compatible/src/binding/parent-chain.ts b/my-plugins/fsm-compatible/src/binding/parent-chain.ts
new file mode 100644
index 000000000..2a3176326
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/parent-chain.ts
@@ -0,0 +1,29 @@
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import type { BindingRecords } from "./actor-binding.ts";
+
+export function parentDepth(
+	rootSessionId: string,
+	sessionId: string,
+	records: BindingRecords,
+	forbiddenSessionId?: string,
+): AdmissionResult<number> {
+	const seen = new Set<string>(forbiddenSessionId === undefined ? [] : [forbiddenSessionId]);
+	let current = sessionId;
+	let depth = 0;
+	for (;;) {
+		if (seen.has(current)) return rejected("parent-cycle");
+		seen.add(current);
+		const record = records.find(current);
+		if (!record) return rejected("parent-not-found");
+		const binding = record.binding;
+		if (binding.sessionId !== current || binding.rootSessionId !== rootSessionId) return rejected("binding-mismatch");
+		if (binding.kind === "execution-root") {
+			return current === rootSessionId && binding.agentId === "main" && binding.parentSessionId === null
+				? admitted(depth)
+				: rejected("binding-mismatch");
+		}
+		if (binding.agentId !== current || binding.agentId === "main" || current === rootSessionId) return rejected("binding-mismatch");
+		current = binding.parentSessionId;
+		depth++;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts b/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts
new file mode 100644
index 000000000..d08bce8cb
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/read-persisted-binding.ts
@@ -0,0 +1,64 @@
+import { isAbsolute } from "node:path";
+import { FSM_COMPATIBLE_EXTENSION_ID, MAX_REQUIRED_EXTENSIONS, REQUIRED_EXTENSION_ID_PATTERN } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { isAdmissionIdentifier, isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { isDataArray } from "../admission/data-array.ts";
+import { BINDING_CUSTOM_TYPE, type BindingEntry, type PersistedBinding } from "./actor-binding.ts";
+
+export function readPersistedBinding(
+	entries: readonly BindingEntry[],
+	actualSessionId: string,
+): AdmissionResult<PersistedBinding | null> {
+	// Step P7: absence and corruption are distinct, including the original mandatory baseline.
+	let found = false;
+	let data: unknown;
+	for (const entry of entries) {
+		if (entry.type === "custom" && entry.customType === BINDING_CUSTOM_TYPE) {
+			found = true;
+			data = entry.data;
+		}
+	}
+	if (!found) return admitted(null);
+	if (!isAdmissionObject(data)) return rejected("binding-mismatch");
+	const keys = ["version", "rootSessionId", "sessionId", "parentSessionId", "agentId", "kind", "agentName", "bootstrapRef", "requiredExtensions"];
+	if (Object.keys(data).some((key) => !keys.includes(key)) || data.version !== 1) return rejected("binding-mismatch");
+	if (!isAdmissionIdentifier(data.rootSessionId) || !isAdmissionIdentifier(data.sessionId) || !isAdmissionIdentifier(data.agentId)) {
+		return rejected("binding-mismatch");
+	}
+	if (data.sessionId !== actualSessionId || !isDataArray(data.requiredExtensions)
+		|| data.requiredExtensions.length < 1 || data.requiredExtensions.length > MAX_REQUIRED_EXTENSIONS) return rejected("binding-mismatch");
+	const extensions: { readonly id: string; readonly path: string }[] = [];
+	const ids = new Set<string>();
+	const paths = new Set<string>();
+	for (const item of data.requiredExtensions) {
+		if (!isAdmissionObject(item) || Object.keys(item).some((key) => key !== "id" && key !== "path")) return rejected("binding-mismatch");
+		if (!isAdmissionIdentifier(item.id) || !REQUIRED_EXTENSION_ID_PATTERN.test(item.id)
+			|| !isAdmissionIdentifier(item.path) || !isAbsolute(item.path) || ids.has(item.id) || paths.has(item.path)) return rejected("binding-mismatch");
+		ids.add(item.id);
+		paths.add(item.path);
+		extensions.push(Object.freeze({ id: item.id, path: item.path }));
+	}
+	if (!ids.has(FSM_COMPATIBLE_EXTENSION_ID)) return rejected("binding-mismatch");
+	const identity = {
+		version: 1 as const,
+		rootSessionId: data.rootSessionId,
+		sessionId: data.sessionId,
+		agentId: data.agentId,
+		requiredExtensions: Object.freeze(extensions),
+	};
+	if (data.kind === "execution-root") {
+		if (data.sessionId !== data.rootSessionId || data.agentId !== "main" || data.parentSessionId !== null
+			|| data.agentName !== null || data.bootstrapRef !== null) return rejected("binding-mismatch");
+		return admitted(Object.freeze({ ...identity, kind: "execution-root", parentSessionId: null, agentName: null, bootstrapRef: null }));
+	}
+	if (data.kind !== "execution-child" || data.agentId !== data.sessionId || data.agentId === "main" || data.sessionId === data.rootSessionId
+		|| !isAdmissionIdentifier(data.parentSessionId) || data.parentSessionId === data.sessionId
+		|| !isAdmissionIdentifier(data.agentName) || !isAdmissionIdentifier(data.bootstrapRef)) return rejected("binding-mismatch");
+	return admitted(Object.freeze({
+		...identity,
+		kind: "execution-child",
+		parentSessionId: data.parentSessionId,
+		agentName: data.agentName,
+		bootstrapRef: data.bootstrapRef,
+	}));
+}
diff --git a/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts b/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts
new file mode 100644
index 000000000..fe0ed05cf
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/binding/restore-actor-binding.ts
@@ -0,0 +1,33 @@
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import { admitted, rejected, type AdmissionResult } from "../admission/admission-result.ts";
+import { BINDING_CUSTOM_TYPE, type BindingRecords, type PersistedBinding } from "./actor-binding.ts";
+import { parentDepth } from "./parent-chain.ts";
+import { readPersistedBinding } from "./read-persisted-binding.ts";
+
+export function restoreActorBinding(
+	policy: AdmissionPolicy,
+	saved: PersistedBinding,
+	actualSessionId: string,
+	callerRoot: string,
+	records: BindingRecords,
+): AdmissionResult<PersistedBinding> {
+	// Step P7: validate the saved baseline, never derive it from the current policy.
+	const checked = readPersistedBinding([{ type: "custom", customType: BINDING_CUSTOM_TYPE, data: saved }], actualSessionId);
+	if (!checked.ok || !checked.value || checked.value.rootSessionId !== callerRoot) return rejected("restore-conflict");
+	const binding = checked.value;
+	for (const original of binding.requiredExtensions) {
+		if (!policy.requiredExtensions.some((item) => item.id === original.id && item.path === original.path && item.requireForAllRunners === true)) {
+			return rejected("restore-conflict");
+		}
+	}
+	if (binding.kind === "execution-child") {
+		if (!policy.agents.some((agent) => agent.canonicalName === binding.agentName)) return rejected("restore-conflict");
+		const depth = parentDepth(callerRoot, binding.parentSessionId, records, actualSessionId);
+		if (!depth.ok || depth.value >= policy.maxDepth) return rejected("restore-conflict");
+	}
+	// Root does not have a child agentName or parent; its identity was checked above.
+	return admitted(Object.freeze({
+		...binding,
+		requiredExtensions: Object.freeze(policy.requiredExtensions.map(({ id, path }) => Object.freeze({ id, path }))),
+	}));
+}
diff --git a/my-plugins/fsm-compatible/src/broker/broker-channel.ts b/my-plugins/fsm-compatible/src/broker/broker-channel.ts
new file mode 100644
index 000000000..83ad6a06a
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/broker-channel.ts
@@ -0,0 +1,65 @@
+import { RuntimeResources } from "../runtime/runtime-resources.ts";
+import { readHostIdentity } from "../runtime/host-identity.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requireDaemonCapabilities, type DaemonCapabilities } from "./daemon-capabilities.ts";
+import { createDaemonRequester, type DaemonRequester } from "./daemon-request.ts";
+import { FsmBroker } from "./fsm-broker.ts";
+import { discoverFsmTools, type FsmTool } from "./fsm-catalog.ts";
+import { McpTransport } from "./mcp-transport.ts";
+import { registerAndConfirmSource } from "./register-source.ts";
+
+export interface BrokerChannelConfig {
+	readonly rootSessionId: string;
+	readonly cwd: string;
+	readonly serverUrl: string;
+	readonly dataDir: string;
+	readonly clientCommand: string;
+	readonly clientArgs: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly capacity: number;
+	readonly scope?: string;
+}
+export interface BrokerChannel {
+	readonly broker: FsmBroker;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly capabilities: DaemonCapabilities;
+	readonly signal: AbortSignal;
+	close(deadline: number): Promise<void>;
+}
+
+export async function prepareBrokerChannel(
+	config: BrokerChannelConfig,
+	deadline: number,
+	signal?: AbortSignal,
+	request: DaemonRequester = createDaemonRequester(config.dataDir),
+): Promise<BrokerChannel> {
+	if (!config.rootSessionId || !config.cwd || !config.clientCommand || !config.dataDir
+		|| !Number.isInteger(config.capacity) || config.capacity < 1) throw new RuntimeError("protocol-invalid");
+	if (signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= deadline) throw new RuntimeError("deadline-exceeded");
+	const resources = new RuntimeResources();
+	const cancel = () => { void resources.close(Date.now() + 10000).catch(() => undefined); };
+	signal?.addEventListener("abort", cancel, { once: true });
+	resources.own(() => { signal?.removeEventListener("abort", cancel); });
+	const call = { deadline, signal: resources.signal };
+	try {
+		const capabilities = requireDaemonCapabilities(await request({ method: "GET", path: "/capabilities", ...call }));
+		const host = await readHostIdentity(deadline, resources.signal);
+		const source = { rootSessionId: config.rootSessionId, pid: host.pid, cwd: config.cwd, serverUrl: config.serverUrl };
+		await registerAndConfirmSource(request, source, deadline, resources.signal);
+		if (!resources.open) throw new RuntimeError("cancelled");
+		const transport = new McpTransport(config.clientCommand, config.clientArgs, { ...config.env, FSM_DATA_DIR: config.dataDir }, config.capacity);
+		resources.own(async (limit) => { if (!(await transport.close(limit))) throw new RuntimeError("delivery-unknown"); });
+		await transport.initialize(call);
+		const catalog = await discoverFsmTools(transport, call);
+		const broker = new FsmBroker({ host, source, request, transport, catalog, capacity: config.capacity,
+			...(config.scope ? { scope: config.scope } : {}) });
+		resources.own(async (limit) => { if (!(await broker.close(limit))) throw new RuntimeError("delivery-unknown"); });
+		if (!resources.open) throw new RuntimeError("cancelled");
+		return Object.freeze({ broker, catalog, capabilities, signal: resources.signal,
+			close: (limit: number) => resources.close(limit) });
+	} catch (error) {
+		await resources.close(Date.now() + 10000);
+		throw error;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts b/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts
new file mode 100644
index 000000000..b7e6595f9
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-capabilities.ts
@@ -0,0 +1,26 @@
+import { isDataArray } from "../admission/data-array.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { DaemonReply } from "./daemon-request.ts";
+
+export interface DaemonCapabilities {
+	readonly serverVersion: string;
+	readonly wireContractVersion: 2;
+	readonly skillSchemaVersion: 2;
+	readonly features: readonly string[];
+}
+
+export function requireDaemonCapabilities(reply: DaemonReply): DaemonCapabilities {
+	const body = reply.body;
+	if (reply.status !== 200 || !isAdmissionObject(body) || typeof body.server_version !== "string"
+		|| !body.server_version || body.wire_contract_version !== 2 || body.skill_schema_version !== 2
+		|| !isDataArray(body.features)) throw new RuntimeError("not-ready");
+	const features = body.features;
+	if (!features.every((item): item is string => typeof item === "string" && item.length > 0)
+		|| new Set(features).size !== features.length) throw new RuntimeError("not-ready");
+	if (!["dispatch_state_admission_v1", "typed_input_exact_v1"].every((name) => features.includes(name))) {
+		throw new RuntimeError("not-ready");
+	}
+	return Object.freeze({ serverVersion: body.server_version, wireContractVersion: 2, skillSchemaVersion: 2,
+		features: Object.freeze([...features]) });
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-request.mjs b/my-plugins/fsm-compatible/src/broker/daemon-request.mjs
new file mode 100644
index 000000000..325d72cca
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-request.mjs
@@ -0,0 +1,57 @@
+import { readFile } from 'node:fs/promises';
+import { request } from 'node:http';
+import { resolve } from 'node:path';
+
+const limit = 1024 * 1024;
+try {
+  let input = '';
+  for await (const chunk of process.stdin) {
+    input += chunk.toString();
+    if (Buffer.byteLength(input) > limit) throw new Error('input-limit');
+  }
+  const payload = JSON.parse(input);
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) throw new Error('bad-input');
+  const allowed = new Map([
+    ['/health', 'GET'], ['/capabilities', 'GET'], ['/session/source', 'GET'],
+    ['/session/register', 'POST'], ['/identity/acquire', 'POST'], ['/actor/acquire', 'POST'], ['/evidence/source-auth', 'POST'],
+    ['/check-permission', 'POST'], ['/stop-check', 'POST'], ['/gate/suppress', 'POST'], ['/gate/release', 'POST'],
+  ]);
+  if (typeof payload.dataDir !== 'string' || typeof payload.path !== 'string' || typeof payload.method !== 'string'
+      || !Number.isFinite(payload.deadline) || payload.deadline <= Date.now()) throw new Error('bad-input');
+  const url = new URL(payload.path, 'http://localhost');
+  if (url.origin !== 'http://localhost' || allowed.get(url.pathname) !== payload.method || url.hash) throw new Error('bad-route');
+  if (url.pathname === '/session/source') {
+    if ([...url.searchParams.keys()].length !== 1 || !url.searchParams.get('session')) throw new Error('bad-query');
+  } else if (url.search) throw new Error('bad-query');
+  const dataDir = resolve(payload.dataDir);
+  const token = (await readFile(resolve(dataDir, 'auth.token'), 'utf8')).trim();
+  const body = payload.method === 'POST' ? JSON.stringify(payload.body) : '';
+  if (body === undefined || Buffer.byteLength(body) > limit || !token) throw new Error('bad-input');
+  const response = await new Promise((accept, reject) => {
+    const req = request({ socketPath: resolve(dataDir, 'server.sock'), path: `${url.pathname}${url.search}`,
+      method: payload.method, headers: { 'x-fsm-auth': token, 'content-type': 'application/json' } });
+    const timer = setTimeout(() => req.destroy(new Error('deadline')), payload.deadline - Date.now());
+    timer.unref();
+    req.on('error', reject);
+    req.on('close', () => clearTimeout(timer));
+    req.on('response', (res) => {
+      const chunks = [];
+      let bytes = 0;
+      res.on('data', (chunk) => {
+        bytes += chunk.length;
+        if (bytes > limit) { req.destroy(new Error('body-limit')); res.destroy(); }
+        else chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('aborted', () => reject(new Error('aborted')));
+      res.on('end', () => {
+        try { accept({ status: res.statusCode, body: JSON.parse(Buffer.concat(chunks).toString('utf8')) }); }
+        catch { reject(new Error('bad-json')); }
+      });
+    });
+    req.end(body);
+  });
+  process.stdout.write(`${JSON.stringify(response)}\n`);
+} catch {
+  process.exitCode = 1;
+}
diff --git a/my-plugins/fsm-compatible/src/broker/daemon-request.ts b/my-plugins/fsm-compatible/src/broker/daemon-request.ts
new file mode 100644
index 000000000..c283db006
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/daemon-request.ts
@@ -0,0 +1,46 @@
+import { fileURLToPath } from "node:url";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { readJsonProcess } from "../process/read-json-process.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface DaemonRequest {
+	readonly method: "GET" | "POST";
+	readonly path: string;
+	readonly body?: unknown;
+	readonly deadline: number;
+	readonly signal?: AbortSignal;
+}
+export interface DaemonReply { readonly status: number; readonly body: unknown }
+export type DaemonRequester = (request: DaemonRequest) => Promise<DaemonReply>;
+
+export function createDaemonRequester(dataDir: string): DaemonRequester {
+	const helper = fileURLToPath(new URL("./daemon-request.mjs", import.meta.url));
+	return async (request) => {
+		const value = await readJsonProcess({
+			command: process.execPath,
+			args: [helper],
+			env: { ...process.env, FSM_DATA_DIR: dataDir },
+			deadline: request.deadline,
+			...(request.signal ? { signal: request.signal } : {}),
+			input: { dataDir, method: request.method, path: request.path, body: request.body, deadline: request.deadline },
+		});
+		if (!isAdmissionObject(value) || typeof value.status !== "number" || !Number.isInteger(value.status)
+			|| value.status < 100 || value.status > 599 || !("body" in value)) throw new RuntimeError("protocol-invalid");
+		return Object.freeze({ status: value.status, body: value.body });
+	};
+}
+
+export async function requestMutation(request: DaemonRequester, input: DaemonRequest): Promise<DaemonReply> {
+	if (input.signal?.aborted) throw new RuntimeError("cancelled");
+	if (Date.now() >= input.deadline) throw new RuntimeError("deadline-exceeded");
+	try {
+		return await request(input);
+	} catch {
+		throw new RuntimeError("delivery-unknown");
+	}
+}
+
+export function requireDaemonOk(reply: DaemonReply): void {
+	if (reply.status < 200 || reply.status >= 300) throw new RuntimeError("transport-failed");
+	if (!isAdmissionObject(reply.body) || reply.body.ok !== true) throw new RuntimeError("protocol-invalid");
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-broker.ts b/my-plugins/fsm-compatible/src/broker/fsm-broker.ts
new file mode 100644
index 000000000..a8cfc8436
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-broker.ts
@@ -0,0 +1,99 @@
+import type { PersistedBinding } from "../binding/actor-binding.ts";
+import { acquireCanonicalLease, coordinationScope } from "../coordination/canonical-lease.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import type { HostIdentity } from "../runtime/host-identity.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requestMutation, requireDaemonOk, type DaemonRequester } from "./daemon-request.ts";
+import type { FsmTool } from "./fsm-catalog.ts";
+import type { McpTransport, RpcOptions } from "./mcp-transport.ts";
+import { registerAndConfirmSource, type SourceOwner } from "./register-source.ts";
+
+export interface FsmBrokerOptions {
+	readonly host: HostIdentity;
+	readonly source: SourceOwner;
+	readonly request: DaemonRequester;
+	readonly transport: McpTransport;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly scope?: string;
+	readonly capacity?: number;
+}
+
+export class FsmBroker {
+	private readonly options: FsmBrokerOptions;
+	private usable = true;
+	private pending = 0;
+	private readonly controller = new AbortController();
+	private readonly capacity: number;
+
+	constructor(options: FsmBrokerOptions) {
+		this.capacity = options.capacity ?? 64;
+		if (options.source.pid !== options.host.pid || !Number.isInteger(this.capacity) || this.capacity < 1) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		this.options = options;
+	}
+
+	async invoke(binding: PersistedBinding, name: string, input: unknown, call: RpcOptions): Promise<Record<string, unknown>> {
+		if (!this.usable) throw new RuntimeError("not-ready");
+		if (this.pending >= this.capacity) throw new RuntimeError("queue-full");
+		this.pending++;
+		const signal = call.signal ? AbortSignal.any([call.signal, this.controller.signal]) : this.controller.signal;
+		try { return await this.invokeAdmitted(binding, name, input, { ...call, signal }); } finally { this.pending--; }
+	}
+
+	private async invokeAdmitted(binding: PersistedBinding, name: string, input: unknown, call: RpcOptions): Promise<Record<string, unknown>> {
+		// Step P3: acquire and invocation share one physical-host/canonical lease.
+		if (!this.usable || binding.rootSessionId !== this.options.source.rootSessionId) throw new RuntimeError("not-ready");
+		if ((binding.kind === "execution-root" && binding.agentId !== "main")
+			|| (binding.kind === "execution-child" && (binding.agentId !== binding.sessionId || binding.agentId === "main"))) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		const tool = this.options.catalog.get(name);
+		if (!tool || !isAdmissionObject(input) || !tool.validate(input)) throw new RuntimeError("protocol-invalid");
+		const lease = await acquireCanonicalLease(this.options.scope ?? coordinationScope(), this.options.host, name,
+			binding.rootSessionId, call.deadline, call.signal);
+		let sent = false;
+		let safeToRelease = true;
+		try {
+			if (!this.usable) throw new RuntimeError("not-ready");
+			await registerAndConfirmSource(this.options.request, this.options.source, call.deadline, call.signal);
+			const identity = await requestMutation(this.options.request, {
+				method: "POST", path: "/identity/acquire", deadline: call.deadline, ...(call.signal ? { signal: call.signal } : {}),
+				body: { session_id: binding.rootSessionId, agent_id: binding.agentId, tool_name: name,
+					agent_cli: "opencode", opencode_server_url: this.options.source.serverUrl },
+			});
+			requireDaemonOk(identity);
+			sent = true;
+			const result = await this.options.transport.call("tools/call", { name, arguments: input }, call);
+			if (!isAdmissionObject(result) || !Array.isArray(result.content)) throw new RuntimeError("protocol-invalid");
+			return result;
+		} catch (error) {
+			if (!sent && error instanceof RuntimeError && error.code === "delivery-unknown") {
+				this.usable = false;
+				safeToRelease = false;
+				await this.options.transport.close(Date.now() + 10000);
+			}
+			if (sent) {
+				this.usable = false;
+				safeToRelease = await this.options.transport.close(Date.now() + 10000);
+				if (!safeToRelease) throw new RuntimeError("delivery-unknown");
+			}
+			throw error;
+		} finally {
+			if (safeToRelease) await lease.release();
+		}
+	}
+
+	async acquireActor(binding: PersistedBinding, call: RpcOptions): Promise<void> {
+		if (!this.usable || binding.rootSessionId !== this.options.source.rootSessionId) throw new RuntimeError("not-ready");
+		await registerAndConfirmSource(this.options.request, this.options.source, call.deadline, call.signal);
+		requireDaemonOk(await requestMutation(this.options.request, { method: "POST", path: "/actor/acquire", deadline: call.deadline,
+			...(call.signal ? { signal: call.signal } : {}), body: { session_id: binding.rootSessionId, agent_id: binding.agentId } }));
+	}
+
+	async close(deadline: number): Promise<boolean> {
+		this.usable = false;
+		this.controller.abort();
+		return this.options.transport.close(deadline);
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts b/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts
new file mode 100644
index 000000000..ce6bf0a29
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-catalog.ts
@@ -0,0 +1,44 @@
+import { Ajv, type ValidateFunction } from "ajv";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { isDataArray } from "../admission/data-array.ts";
+import { isAdmissionObject, isAdmissionIdentifier } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { McpTransport, RpcOptions } from "./mcp-transport.ts";
+
+export interface FsmTool {
+	readonly name: string;
+	readonly description: string;
+	readonly inputSchema: Record<string, unknown>;
+	readonly validate: ValidateFunction;
+}
+
+export async function discoverFsmTools(transport: McpTransport, options: RpcOptions): Promise<ReadonlyMap<string, FsmTool>> {
+	const tools = new Map<string, FsmTool>();
+	const cursors = new Set<string>();
+	let cursor: string | undefined;
+	for (;;) {
+		const value = await transport.call("tools/list", cursor === undefined ? {} : { cursor }, options);
+		if (!isAdmissionObject(value) || !isDataArray(value.tools)) throw new RuntimeError("protocol-invalid");
+		for (const tool of value.tools) {
+			if (!isAdmissionObject(tool) || !isAdmissionIdentifier(tool.name) || tools.has(tool.name)
+				|| !isAdmissionObject(tool.inputSchema)) throw new RuntimeError("protocol-invalid");
+			const schema = tool.inputSchema;
+			const schemaVersion = schema.$schema;
+			if (schemaVersion !== undefined && typeof schemaVersion !== "string") throw new RuntimeError("protocol-invalid");
+			const engine = typeof schemaVersion === "string" && schemaVersion.includes("2020-12")
+				? new Ajv2020({ strict: false, allErrors: true, validateFormats: false })
+				: new Ajv({ strict: false, allErrors: true, validateFormats: false });
+			let validate: ValidateFunction;
+			try { validate = engine.compile(schema); } catch { throw new RuntimeError("protocol-invalid"); }
+			tools.set(tool.name, Object.freeze({ name: tool.name,
+				description: typeof tool.description === "string" ? tool.description : "FSM tool",
+				inputSchema: structuredClone(schema), validate }));
+		}
+		if (value.nextCursor === undefined) break;
+		if (typeof value.nextCursor !== "string" || !value.nextCursor || cursors.has(value.nextCursor)) throw new RuntimeError("protocol-invalid");
+		cursor = value.nextCursor;
+		cursors.add(cursor);
+	}
+	if (!tools.size) throw new RuntimeError("protocol-invalid");
+	return tools;
+}
diff --git a/my-plugins/fsm-compatible/src/broker/fsm-tools.ts b/my-plugins/fsm-compatible/src/broker/fsm-tools.ts
new file mode 100644
index 000000000..c5e74d7ee
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/fsm-tools.ts
@@ -0,0 +1,39 @@
+import type { ExtensionAPI, ExtensionToolContext } from "@earendil-works/pi-coding-agent";
+import type { PersistedBinding } from "../binding/actor-binding.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { FsmBroker } from "./fsm-broker.ts";
+import type { FsmTool } from "./fsm-catalog.ts";
+import { projectMcpToolResult } from "./mcp-tool-result.ts";
+
+export interface ProjectedToolOwner {
+	readonly broker: FsmBroker;
+	readonly catalog: ReadonlyMap<string, FsmTool>;
+	readonly timeoutMs: number;
+	ready(): boolean;
+	binding(ctx: ExtensionToolContext): PersistedBinding;
+}
+
+export function registerProjectedTools(pi: ExtensionAPI, owner: ProjectedToolOwner): () => void {
+	const existing = pi.getAllTools();
+	for (const name of owner.catalog.keys()) {
+		if (existing.some((tool) => tool.name === name || tool.name.endsWith(`__${name}`))) throw new RuntimeError("not-ready");
+	}
+	let active = true;
+	// Step P3: published tools can only call the broker with their actual session binding.
+	for (const tool of owner.catalog.values()) {
+		pi.registerTool({ name: `mcp__fsm__${tool.name}`, label: tool.name, description: tool.description,
+			parameters: structuredClone(tool.inputSchema),
+			async execute(_id, params, signal, onUpdate, ctx) {
+				if (!active || !owner.ready()) throw new RuntimeError("not-ready");
+				const binding = owner.binding(ctx);
+				if (binding.sessionId !== ctx.sessionManager.getSessionId()) throw new RuntimeError("owner-unavailable");
+				const result = await owner.broker.invoke(binding, tool.name, params, {
+					deadline: Date.now() + owner.timeoutMs, ...(signal ? { signal } : {}),
+					...(onUpdate ? { onProgress: (progress: unknown) => onUpdate({ content: [], details: { progress } }) } : {}),
+				});
+				return projectMcpToolResult(result);
+			},
+		});
+	}
+	return () => { active = false; };
+}
diff --git a/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts b/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts
new file mode 100644
index 000000000..5c10125fa
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/mcp-tool-result.ts
@@ -0,0 +1,36 @@
+import type { AgentToolResult } from "@earendil-works/pi-coding-agent";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+type Json = NonNullable<AgentToolResult<unknown>["structuredContent"]>;
+function isJson(value: unknown): value is Json {
+	if (value === null || typeof value === "string" || typeof value === "boolean") return true;
+	if (typeof value === "number") return Number.isFinite(value);
+	if (Array.isArray(value)) return value.every(isJson);
+	return isAdmissionObject(value) && Object.values(value).every(isJson);
+}
+
+export function projectMcpToolResult(result: Record<string, unknown>): AgentToolResult<Record<string, unknown>> {
+	if (!Array.isArray(result.content) || (result.isError !== undefined && typeof result.isError !== "boolean")) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	const content: AgentToolResult<unknown>["content"] = [];
+	for (const block of result.content) {
+		if (!isAdmissionObject(block) || typeof block.type !== "string") throw new RuntimeError("protocol-invalid");
+		if (block.type === "text") {
+			if (typeof block.text !== "string") throw new RuntimeError("protocol-invalid");
+			content.push({ type: "text", text: block.text });
+		} else if (block.type === "image") {
+			if (typeof block.data !== "string" || typeof block.mimeType !== "string") throw new RuntimeError("protocol-invalid");
+			content.push({ type: "image", data: block.data, mimeType: block.mimeType });
+		} else {
+			content.push({ type: "text", text: JSON.stringify(block) });
+		}
+	}
+	if (result.structuredContent !== undefined && (!isAdmissionObject(result.structuredContent) || !isJson(result.structuredContent))) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	return { content, details: structuredClone(result),
+		...(result.structuredContent !== undefined ? { structuredContent: structuredClone(result.structuredContent) } : {}),
+		...(typeof result.isError === "boolean" ? { isError: result.isError } : {}) };
+}
diff --git a/my-plugins/fsm-compatible/src/broker/mcp-transport.ts b/my-plugins/fsm-compatible/src/broker/mcp-transport.ts
new file mode 100644
index 000000000..c4b5a2139
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/mcp-transport.ts
@@ -0,0 +1,123 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { startOwnedProcess, type OwnedProcess } from "../process/owned-process.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+interface PendingRpc {
+	readonly onProgress?: (params: unknown) => void;
+	resolve(value: unknown): void;
+	reject(error: RuntimeError): void;
+	cleanup(): void;
+}
+export interface RpcOptions {
+	readonly deadline: number;
+	readonly signal?: AbortSignal;
+	readonly onProgress?: (params: unknown) => void;
+}
+
+export class McpTransport {
+	private readonly process: OwnedProcess;
+	private readonly pending = new Map<number, PendingRpc>();
+	private buffer = "";
+	private nextId = 0;
+	private usable = true;
+	private readonly capacity: number;
+
+	constructor(command: string, args: readonly string[], env: NodeJS.ProcessEnv, capacity = 64) {
+		if (!Number.isInteger(capacity) || capacity < 1) throw new RuntimeError("protocol-invalid");
+		this.capacity = capacity;
+		this.process = startOwnedProcess(command, args, env);
+		this.process.child.stdout.setEncoding("utf8");
+		this.process.child.stdout.on("data", (chunk: string) => this.consume(chunk));
+		this.process.child.stderr.resume();
+		this.process.child.stdin.on("error", () => this.fail());
+		void this.process.closed.then(() => this.fail());
+	}
+
+	private fail(): void {
+		this.usable = false;
+		for (const entry of this.pending.values()) { entry.cleanup(); entry.reject(new RuntimeError("delivery-unknown")); }
+		this.pending.clear();
+	}
+
+	private consume(chunk: string): void {
+		this.buffer += chunk;
+		if (Buffer.byteLength(this.buffer) > 2 * 1024 * 1024) { this.fail(); return; }
+		for (;;) {
+			const newline = this.buffer.indexOf("\n");
+			if (newline < 0) return;
+			const line = this.buffer.slice(0, newline).trim();
+			this.buffer = this.buffer.slice(newline + 1);
+			if (!line) continue;
+			let value: unknown;
+			try { value = JSON.parse(line); } catch { this.fail(); return; }
+			if (!isAdmissionObject(value) || value.jsonrpc !== "2.0") { this.fail(); return; }
+			if (typeof value.method === "string") {
+				if (value.method === "notifications/progress" && isAdmissionObject(value.params)
+					&& typeof value.params.progressToken === "number") {
+					const entry = this.pending.get(value.params.progressToken);
+					try { entry?.onProgress?.(value.params); } catch { this.fail(); return; }
+				}
+				if (value.method === "ping" && (typeof value.id === "number" || typeof value.id === "string")) {
+					this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id: value.id, result: {} })}\n`);
+				}
+				continue;
+			}
+			if (typeof value.id !== "number") { this.fail(); return; }
+			const entry = this.pending.get(value.id);
+			if (!entry) { this.fail(); return; }
+			this.pending.delete(value.id);
+			entry.cleanup();
+			if ("error" in value) entry.reject(new RuntimeError("transport-failed"));
+			else if ("result" in value) entry.resolve(value.result);
+			else { entry.reject(new RuntimeError("protocol-invalid")); this.fail(); return; }
+		}
+	}
+
+	async initialize(options: RpcOptions): Promise<void> {
+		const reply = await this.call("initialize", {
+			protocolVersion: "2025-11-25", capabilities: {}, clientInfo: { name: "fsm-compatible", version: "0.1.0" },
+		}, options);
+		if (!isAdmissionObject(reply) || !["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"].includes(String(reply.protocolVersion))) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		this.notify("notifications/initialized", {});
+	}
+
+	call(method: string, params: unknown, options: RpcOptions): Promise<unknown> {
+		if (!this.usable) return Promise.reject(new RuntimeError("not-ready"));
+		if (options.signal?.aborted) return Promise.reject(new RuntimeError("cancelled"));
+		if (Date.now() >= options.deadline) return Promise.reject(new RuntimeError("deadline-exceeded"));
+		if (this.pending.size >= this.capacity) return Promise.reject(new RuntimeError("queue-full"));
+		const id = ++this.nextId;
+		return new Promise((resolve, reject) => {
+			const abort = () => {
+				const entry = this.pending.get(id);
+				if (!entry) return;
+				this.pending.delete(id);
+				entry.cleanup();
+				this.usable = false;
+				reject(new RuntimeError("delivery-unknown"));
+			};
+			const timer = setTimeout(abort, Math.max(0, options.deadline - Date.now()));
+			timer.unref();
+			const cleanup = () => { clearTimeout(timer); options.signal?.removeEventListener("abort", abort); };
+			options.signal?.addEventListener("abort", abort, { once: true });
+			this.pending.set(id, { resolve, reject, cleanup, ...(options.onProgress ? { onProgress: options.onProgress } : {}) });
+			const requestParams = options.onProgress && isAdmissionObject(params)
+				? { ...params, _meta: { ...(isAdmissionObject(params._meta) ? params._meta : {}), progressToken: id } }
+				: params;
+			try { this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params: requestParams })}\n`); }
+			catch { abort(); }
+		});
+	}
+
+	notify(method: string, params: unknown): void {
+		if (!this.usable) throw new RuntimeError("not-ready");
+		this.process.child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", method, params })}\n`);
+	}
+
+	async close(deadline: number): Promise<boolean> {
+		this.fail();
+		return this.process.close(deadline);
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/broker/register-source.ts b/my-plugins/fsm-compatible/src/broker/register-source.ts
new file mode 100644
index 000000000..a1bb27f4e
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/broker/register-source.ts
@@ -0,0 +1,31 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { requestMutation, type DaemonRequester } from "./daemon-request.ts";
+
+export interface SourceOwner {
+	readonly rootSessionId: string;
+	readonly pid: number;
+	readonly cwd: string;
+	readonly serverUrl: string;
+}
+
+export async function registerAndConfirmSource(
+	request: DaemonRequester,
+	owner: SourceOwner,
+	deadline: number,
+	signal?: AbortSignal,
+): Promise<void> {
+	const attempted = await requestMutation(request, {
+		method: "POST", path: "/session/register", deadline, ...(signal ? { signal } : {}),
+		body: { session_id: owner.rootSessionId, cwd: owner.cwd, transcript_path: null, opencode_server_url: owner.serverUrl },
+	});
+	if (attempted.status < 200 || attempted.status >= 300) throw new RuntimeError("transport-failed");
+	if (attempted.body !== null) throw new RuntimeError("protocol-invalid");
+	const reply = await request({ method: "GET", path: `/session/source?session=${encodeURIComponent(owner.rootSessionId)}`,
+		deadline, ...(signal ? { signal } : {}) });
+	if (reply.status !== 200) throw new RuntimeError("not-ready");
+	const source = reply.body;
+	if (!isAdmissionObject(source) || source.session_id !== owner.rootSessionId || source.agent_pid !== owner.pid
+		|| source.kind !== "opencode" || source.cwd !== owner.cwd || source.opencode_server_url !== owner.serverUrl
+		|| source.transcript_path !== null) throw new RuntimeError("not-ready");
+}
diff --git a/my-plugins/fsm-compatible/src/children/child-bootstrap.ts b/my-plugins/fsm-compatible/src/children/child-bootstrap.ts
new file mode 100644
index 000000000..c31b5563e
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/children/child-bootstrap.ts
@@ -0,0 +1,66 @@
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import type { SessionEntry } from "@earendil-works/pi-coding-agent";
+import type { PersistedBinding } from "../binding/actor-binding.ts";
+import { bindNewChild } from "../binding/bind-new-child.ts";
+import { readPersistedBinding } from "../binding/read-persisted-binding.ts";
+import { restoreActorBinding } from "../binding/restore-actor-binding.ts";
+import type { AdmissionPolicy } from "../admission/admission-policy.ts";
+import type { BindingRecords, PendingLaunch } from "../binding/actor-binding.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { RootLaunches, type BootstrapPayload } from "./root-launches.ts";
+
+export type ChildGateBinding = { readonly sessionId: string; readonly agentId: string };
+
+/**
+ * Child-side session bootstrap: strips the model-invisible bootstrap prefix from
+ * the first input, then restores or binds the child identity before any task.
+ */
+export class ChildSideBootstrap {
+	private consumed = false;
+	private bootstrapRef: string | null = null;
+	private payload: BootstrapPayload | null = null;
+	binding: PersistedBinding | null = null;
+	private readonly scope: string;
+
+	constructor(scope: string) { this.scope = scope; }
+
+	inputTransformer(text: string): { action: "transform"; text: string } | undefined {
+		if (this.consumed) return undefined;
+		const split = RootLaunches.splitBootstrapTask(text);
+		if (!split) return undefined;
+		this.consumed = true;
+		this.bootstrapRef = split.bootstrapRef;
+		return { action: "transform", text: split.task };
+	}
+
+	async loadPayload(): Promise<BootstrapPayload> {
+		if (!this.bootstrapRef) throw new RuntimeError("not-ready");
+		if (!this.payload) this.payload = await RootLaunches.readBootstrap(this.scope, this.bootstrapRef);
+		return this.payload;
+	}
+
+	async initialize(actualSessionId: string, entries: readonly SessionEntry[], records: BindingRecords,
+		policy: AdmissionPolicy, pending: PendingLaunch): Promise<PersistedBinding> {
+		const saved = readPersistedBinding(entries, actualSessionId);
+		if (saved.ok && saved.value) {
+			const restored = restoreActorBinding(policy, saved.value, actualSessionId, saved.value.rootSessionId, records);
+			if (!restored.ok) throw new RuntimeError("not-ready");
+			this.binding = restored.value;
+			return restored.value;
+		}
+		if (!saved.ok) throw new RuntimeError("not-ready");
+		const bound = bindNewChild(policy, pending, actualSessionId, entries, records);
+		if (!bound.ok) throw new RuntimeError("not-ready");
+		this.binding = bound.value;
+		return bound.value;
+	}
+
+	gateBinding(): ChildGateBinding | undefined {
+		if (!this.binding) return undefined;
+		return { sessionId: this.binding.sessionId, agentId: this.binding.agentId };
+	}
+}
+
+export function installChildInputGate(pi: ExtensionAPI, bootstrap: ChildSideBootstrap): () => void {
+	return pi.on("input", (event: { text: string }) => bootstrap.inputTransformer(event.text));
+}
diff --git a/my-plugins/fsm-compatible/src/children/child-runs.ts b/my-plugins/fsm-compatible/src/children/child-runs.ts
new file mode 100644
index 000000000..7171a8df7
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/children/child-runs.ts
@@ -0,0 +1,158 @@
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { DelegationBus, DelegationCancel, DelegationResponse } from "./delegation-bus.ts";
+
+export type ChildLifecycle = "idle" | "failed" | "aborted" | "unavailable" | "busy";
+
+export function lifecycleForStatus(status: string): ChildLifecycle {
+	switch (status) {
+		case "completed": return "idle";
+		case "failed": case "timed_out": case "tool_budget_exhausted": case "structured_output_failed":
+		case "acceptance_failed": case "unavailable_context": case "invalid_request":
+			return "failed";
+		case "cancelled": case "interrupted": return "aborted";
+		default: return "unavailable";
+	}
+}
+
+export interface ChildRunInfo {
+	readonly tuple: DelegationCancel;
+	readonly callerSessionId: string;
+	readonly agentName: string;
+	childSessionId: string | null;
+	runId: string | null;
+	terminal: DelegationResponse | null;
+	unknown: boolean;
+}
+
+interface Waiting {
+	readonly nodeId: string;
+	resolve(terminal: DelegationResponse | null): void;
+}
+
+/** B7: run-key correlation and real-caller notification. No second terminal is accepted. */
+export class ChildRuns {
+	private readonly rows = new Map<string, ChildRunInfo>();
+	private readonly finished = new Map<string, ChildRunInfo>();
+	private readonly waiters = new Set<Waiting>();
+	private readonly capacity: number;
+	private readonly finishedCapacity: number;
+	private readonly notify: (callerSessionId: string, run: ChildRunInfo) => void;
+
+	constructor(capacity: number, notify: (callerSessionId: string, run: ChildRunInfo) => void, finishedCapacity = 64) {
+		if (!Number.isSafeInteger(capacity) || capacity < 1 || !Number.isSafeInteger(finishedCapacity) || finishedCapacity < 1) {
+			throw new RuntimeError("protocol-invalid");
+		}
+		this.capacity = capacity;
+		this.finishedCapacity = finishedCapacity;
+		this.notify = notify;
+	}
+
+	get activeSize(): number { return this.rows.size; }
+
+	open(tuple: DelegationCancel, callerSessionId: string, agentName: string): ChildRunInfo {
+		if (this.rows.has(tuple.nodeId)) throw new RuntimeError("queue-full");
+		if (this.rows.size >= this.capacity) throw new RuntimeError("queue-full");
+		const info: ChildRunInfo = { tuple, callerSessionId, agentName, childSessionId: null, runId: null, terminal: null, unknown: false };
+		this.rows.set(tuple.nodeId, info);
+		return info;
+	}
+
+	find(nodeId: string): ChildRunInfo | undefined { return this.rows.get(nodeId) ?? this.finished.get(nodeId); }
+
+	onStarted(tuple: DelegationCancel): void { void tuple; }
+
+	onUpdate(tuple: DelegationCancel, runId: string | undefined): void {
+		const row = this.rows.get(tuple.nodeId);
+		if (!row || row.tuple.requestId !== tuple.requestId) return;
+		if (runId) row.runId = runId;
+	}
+
+	onChildRegistered(nodeId: string, childSessionId: string): void {
+		const row = this.rows.get(nodeId);
+		if (!row) throw new RuntimeError("not-ready");
+		row.childSessionId = childSessionId;
+	}
+
+	// Step P2: one terminal per attempt; only that row's waiters are resolved.
+	onTerminal(response: DelegationResponse): void {
+		if (!response.nodeId) return;
+		const row = this.rows.get(response.nodeId);
+		if (!row) {
+			const done = this.finished.get(response.nodeId);
+			if (done && done.tuple.requestId === response.requestId) throw new RuntimeError("protocol-invalid");
+			return;
+		}
+		if (row.tuple.requestId !== response.requestId) return;
+		if (row.terminal) throw new RuntimeError("protocol-invalid");
+		row.terminal = response;
+		this.rows.delete(response.nodeId);
+		this.finished.set(response.nodeId, row);
+		while (this.finished.size > this.finishedCapacity) {
+			const oldest = this.finished.keys().next().value;
+			if (oldest === undefined) break;
+			this.finished.delete(oldest);
+		}
+		this.notify(row.callerSessionId, row);
+		for (const waiter of [...this.waiters]) {
+			if (waiter.nodeId === response.nodeId) {
+				this.waiters.delete(waiter);
+				waiter.resolve(response);
+			}
+		}
+	}
+
+	markUnknown(nodeId: string): void {
+		const row = this.rows.get(nodeId);
+		if (row) row.unknown = true;
+	}
+
+	/** A handshake abandoned without a terminal frees its capacity; the row stays queryable as unknown. */
+	forget(nodeId: string): void {
+		const row = this.rows.get(nodeId);
+		if (!row || row.terminal) return;
+		row.unknown = true;
+		this.rows.delete(nodeId);
+		this.finished.set(nodeId, row);
+	}
+
+	awaitTerminal(nodeId: string, deadline: number, signal?: AbortSignal): Promise<DelegationResponse | null> {
+		const row = this.find(nodeId);
+		if (!row) return Promise.reject(new RuntimeError("not-ready"));
+		if (row.terminal) return Promise.resolve(row.terminal);
+		if (row.unknown) return Promise.reject(new RuntimeError("delivery-unknown"));
+		return new Promise((resolve, reject) => {
+			const waiting: Waiting = { nodeId, resolve: (terminal) => {
+				clearTimeout(timer);
+				signal?.removeEventListener("abort", abort);
+				resolve(terminal);
+			} };
+			const finish = (error?: RuntimeError) => {
+				this.waiters.delete(waiting);
+				clearTimeout(timer);
+				signal?.removeEventListener("abort", abort);
+				if (error) reject(error);
+				else resolve(null);
+			};
+			const timer = setTimeout(() => {
+				const active = this.rows.get(nodeId);
+				if (active) active.unknown = true;
+				finish(new RuntimeError("delivery-unknown"));
+			}, Math.max(0, deadline - Date.now()));
+			timer.unref();
+			const abort = () => finish(new RuntimeError("cancelled"));
+			signal?.addEventListener("abort", abort, { once: true });
+			this.waiters.add(waiting);
+		});
+	}
+
+	cancel(bus: DelegationBus, nodeId: string, deadline: number, signal?: AbortSignal): Promise<DelegationResponse> {
+		const row = this.find(nodeId);
+		if (!row) return Promise.reject(new RuntimeError("not-ready"));
+		if (row.terminal) return Promise.resolve(row.terminal);
+		bus.cancel(row.tuple);
+		return this.awaitTerminal(nodeId, deadline, signal).then((terminal) => {
+			if (!terminal) { row.unknown = true; throw new RuntimeError("delivery-unknown"); }
+			return terminal;
+		});
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/children/delegation-bus.ts b/my-plugins/fsm-compatible/src/children/delegation-bus.ts
new file mode 100644
index 000000000..18e7705cd
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/children/delegation-bus.ts
@@ -0,0 +1,96 @@
+export interface EventSurface {
+	emit(event: string, payload: unknown): void;
+	on(event: string, handler: (payload: unknown) => void): () => void;
+}
+
+export const DELEGATION_REQUEST_EVENT = "prompt-template:subagent:request";
+export const DELEGATION_STARTED_EVENT = "prompt-template:subagent:started";
+export const DELEGATION_UPDATE_EVENT = "prompt-template:subagent:update";
+export const DELEGATION_RESPONSE_EVENT = "prompt-template:subagent:response";
+export const DELEGATION_CANCEL_EVENT = "prompt-template:subagent:cancel";
+
+export type DelegationStatus =
+	| "completed" | "failed" | "timed_out" | "cancelled" | "interrupted" | "tool_budget_exhausted"
+	| "structured_output_failed" | "acceptance_failed" | "invalid_request" | "unavailable_context" | "duplicate_node";
+
+export interface DelegationRequest {
+	readonly requestId: string;
+	readonly ownerRunId: string;
+	readonly nodeId: string;
+	readonly agent: string;
+	readonly task: string;
+	readonly cwd: string;
+}
+export interface DelegationCancel {
+	readonly requestId: string;
+	readonly ownerRunId: string;
+	readonly nodeId: string;
+}
+export interface DelegationResponse {
+	readonly requestId: string;
+	readonly ownerRunId?: string;
+	readonly nodeId?: string;
+	readonly status: DelegationStatus;
+	readonly error?: string;
+	readonly runId?: string;
+}
+
+export type DelegationListener = {
+	started(tuple: DelegationCancel): void;
+	update(tuple: DelegationCancel, runId: string | undefined): void;
+	response(response: DelegationResponse): void;
+};
+
+function asTuple(payload: unknown): DelegationCancel | undefined {
+	if (!payload || typeof payload !== "object") return undefined;
+	const record = payload as Record<string, unknown>;
+	if (typeof record.requestId !== "string" || typeof record.ownerRunId !== "string" || typeof record.nodeId !== "string") return undefined;
+	return { requestId: record.requestId, ownerRunId: record.ownerRunId, nodeId: record.nodeId };
+}
+
+/** Thin typed wrapper over the SA structured-delegation event family. */
+export class DelegationBus {
+	private readonly offs: Array<() => void> = [];
+	private listener: DelegationListener | undefined;
+	private readonly events: EventSurface;
+
+	constructor(events: EventSurface) {
+		this.events = events;
+	}
+
+	subscribe(listener: DelegationListener): void {
+		if (this.listener) throw new Error("delegation listener already installed");
+		this.listener = listener;
+		this.offs.push(this.events.on(DELEGATION_STARTED_EVENT, (payload) => {
+			const tuple = asTuple(payload);
+			if (tuple) this.listener?.started(tuple);
+		}));
+		this.offs.push(this.events.on(DELEGATION_UPDATE_EVENT, (payload) => {
+			const tuple = asTuple(payload);
+			const runId = (payload as { runId?: unknown } | null)?.runId;
+			if (tuple) this.listener?.update(tuple, typeof runId === "string" ? runId : undefined);
+		}));
+		this.offs.push(this.events.on(DELEGATION_RESPONSE_EVENT, (payload) => {
+			if (!payload || typeof payload !== "object") return;
+			const record = payload as Record<string, unknown>;
+			if (typeof record.requestId !== "string" || typeof record.status !== "string") return;
+			this.listener?.response({
+				requestId: record.requestId,
+				status: record.status as DelegationStatus,
+				...(typeof record.ownerRunId === "string" ? { ownerRunId: record.ownerRunId } : {}),
+				...(typeof record.nodeId === "string" ? { nodeId: record.nodeId } : {}),
+				...(typeof record.error === "string" ? { error: record.error } : {}),
+				...(typeof record.runId === "string" ? { runId: record.runId } : {}),
+			});
+		}));
+	}
+
+	request(payload: DelegationRequest): void { this.events.emit(DELEGATION_REQUEST_EVENT, payload); }
+
+	cancel(tuple: DelegationCancel): void { this.events.emit(DELEGATION_CANCEL_EVENT, tuple); }
+
+	close(): void {
+		for (const off of this.offs.splice(0)) off();
+		this.listener = undefined;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/children/launch-queue.ts b/my-plugins/fsm-compatible/src/children/launch-queue.ts
new file mode 100644
index 000000000..e1c7da7d3
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/children/launch-queue.ts
@@ -0,0 +1,10 @@
+/** FIFO serial executor for new-actor handshake segments (B6). */
+export class SerialQueue {
+	private tail: Promise<void> = Promise.resolve();
+
+	enqueue<T>(segment: () => Promise<T>): Promise<T> {
+		const run = this.tail.then(segment);
+		this.tail = run.then(() => undefined, () => undefined);
+		return run;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/children/root-launches.ts b/my-plugins/fsm-compatible/src/children/root-launches.ts
new file mode 100644
index 000000000..d9e598c3a
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/children/root-launches.ts
@@ -0,0 +1,168 @@
+import { randomUUID } from "node:crypto";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { DelegationBus } from "./delegation-bus.ts";
+import { SerialQueue } from "./launch-queue.ts";
+import type { ChildRuns } from "./child-runs.ts";
+
+export interface BootstrapPayload {
+	readonly bootstrapRef: string;
+	readonly rootSessionId: string;
+	readonly callerSessionId: string;
+	readonly agentName: string;
+	readonly bridgeUrl: string;
+	readonly bridgePassword: string;
+	readonly requiredExtensions: readonly { id: string; path: string }[];
+	readonly allowedAgents: readonly string[];
+	readonly maxDepth: number;
+}
+
+export interface LaunchPolicy {
+	readonly allowedAgents: readonly string[];
+	readonly maxDepth: number;
+	readonly requiredExtensions: readonly { id: string; path: string }[];
+}
+export interface LaunchRequest {
+	readonly agent: string;
+	readonly task: string;
+	readonly callerSessionId: string;
+	readonly policy: LaunchPolicy;
+	readonly deadline?: number;
+	readonly signal?: AbortSignal;
+}
+
+export type LaunchOutcomeCode = "not-ready" | "queue-full" | "deadline-exceeded" | "delivery-unknown" | "cancelled" | "duplicate";
+export type LaunchOutcome =
+	| { readonly ok: true; readonly nodeId: string; readonly childSessionId: string | null }
+	| { readonly ok: false; readonly code: LaunchOutcomeCode };
+
+/**
+ * B6 root launches: the FIFO serializes the handshake (bootstrap file, delegation
+ * emit, child launch-ack or failure) before the next launch proceeds.
+ */
+export class RootLaunches {
+	private readonly queue = new SerialQueue();
+	private readonly acks = new Map<string, (childSessionId: string) => void>();
+	private pending = 0;
+	private readonly bus: DelegationBus;
+	private readonly runs: ChildRuns;
+	private readonly scope: string;
+	private readonly capacity: number;
+	private readonly rootSessionId: string;
+	private readonly bridge: { url: string; password: string };
+	private readonly childStartTimeoutMs: number;
+
+	constructor(bus: DelegationBus, runs: ChildRuns, scope: string, capacity: number,
+		rootSessionId: string, bridge: { url: string; password: string }, childStartTimeoutMs = 30000) {
+		this.bus = bus;
+		this.runs = runs;
+		this.scope = scope;
+		this.capacity = capacity;
+		this.rootSessionId = rootSessionId;
+		this.bridge = bridge;
+		this.childStartTimeoutMs = childStartTimeoutMs;
+		if (!scope || !Number.isSafeInteger(capacity) || capacity < 1 || !rootSessionId
+			|| !bridge?.url || !bridge?.password) throw new RuntimeError("protocol-invalid");
+	}
+
+	static async openScope(base = tmpdir()): Promise<string> {
+		return mkdtemp(join(base, "fsm-launch-"));
+	}
+
+	async disposeScope(): Promise<void> { await rm(this.scope, { recursive: true, force: true }); }
+
+	launch(request: LaunchRequest): Promise<LaunchOutcome> {
+		if (this.pending >= this.capacity || this.runs.activeSize >= this.capacity) {
+			return Promise.resolve({ ok: false, code: "queue-full" });
+		}
+		if (request.deadline !== undefined && Date.now() >= request.deadline) {
+			return Promise.resolve({ ok: false, code: "deadline-exceeded" });
+		}
+		if (request.signal?.aborted) return Promise.resolve({ ok: false, code: "cancelled" });
+		this.pending += 1;
+		return this.queue.enqueue(async () => {
+			// fsm-4 residual: a queued launch that lost its caller while waiting stops here, before side effects.
+			if (request.signal?.aborted) return { ok: false, code: "cancelled" };
+			if (request.deadline !== undefined && Date.now() >= request.deadline) return { ok: false, code: "deadline-exceeded" };
+			const bootstrapRef = randomUUID();
+			const nodeId = `launch-${bootstrapRef}`;
+			const payload: BootstrapPayload = {
+				bootstrapRef, rootSessionId: this.rootSessionId, callerSessionId: request.callerSessionId,
+				agentName: request.agent, bridgeUrl: this.bridge.url, bridgePassword: this.bridge.password,
+				requiredExtensions: request.policy.requiredExtensions, allowedAgents: request.policy.allowedAgents,
+				maxDepth: request.policy.maxDepth,
+			};
+			const file = join(this.scope, `${bootstrapRef}.json`);
+			await writeFile(file, JSON.stringify(payload), { mode: 0o600 });
+			this.runs.open({ requestId: bootstrapRef, ownerRunId: this.rootSessionId, nodeId }, request.callerSessionId, request.agent);
+			const ack = new Promise<string>((resolve) => { this.acks.set(nodeId, resolve); });
+			try {
+				this.bus.request({ requestId: bootstrapRef, ownerRunId: this.rootSessionId, nodeId, agent: request.agent,
+					task: `[fsm-bootstrap:${bootstrapRef}]\n\n${request.task}`, cwd: process.cwd() });
+				const budget = Math.min(Date.now() + this.childStartTimeoutMs,
+					request.deadline ?? Number.MAX_SAFE_INTEGER);
+				const race = await Promise.race([
+					ack.then((childSessionId) => ({ kind: "ack" as const, childSessionId })),
+					this.runs.awaitTerminal(nodeId, budget, request.signal)
+						.then((terminal) => ({ kind: "terminal" as const, terminal })),
+				]);
+				if (race.kind === "ack") {
+					this.runs.onChildRegistered(nodeId, race.childSessionId);
+					return { ok: true, nodeId, childSessionId: race.childSessionId };
+				}
+				if (race.terminal) {
+					return race.terminal.status === "duplicate_node"
+						? { ok: false, code: "duplicate" }
+						: { ok: false, code: "not-ready" };
+				}
+				return { ok: false, code: "delivery-unknown" };
+			} catch (error) {
+				if (error instanceof RuntimeError && (error.code === "delivery-unknown" || error.code === "cancelled")) {
+					this.runs.forget(nodeId);
+				}
+				if (error instanceof RuntimeError) {
+					const code = error.code;
+					return { ok: false, code: code === "queue-full" || code === "deadline-exceeded" || code === "delivery-unknown" || code === "cancelled" ? code : "not-ready" };
+				}
+				return { ok: false, code: "not-ready" };
+			} finally {
+				this.acks.delete(nodeId);
+				this.pending -= 1;
+			}
+		});
+	}
+
+	onLaunchAck(bootstrapRef: string, childSessionId: string): void {
+		const resolve = this.acks.get(`launch-${bootstrapRef}`);
+		if (!resolve) throw new RuntimeError("not-ready");
+		resolve(childSessionId);
+	}
+
+	static bootstrapPrefixPattern(): RegExp { return /^\[fsm-bootstrap:([0-9a-f-]{36})\]\n\n/; }
+
+	static splitBootstrapTask(text: string): { bootstrapRef: string; task: string } | null {
+		const match = RootLaunches.bootstrapPrefixPattern().exec(text);
+		if (!match) return null;
+		return { bootstrapRef: match[1]!, task: text.slice(match[0].length) };
+	}
+
+	static async readBootstrap(scope: string, bootstrapRef: string): Promise<BootstrapPayload> {
+		if (!/^[0-9a-f-]{36}$/.test(bootstrapRef)) throw new RuntimeError("protocol-invalid");
+		let raw: string;
+		try {
+			raw = await readFile(join(scope, `${bootstrapRef}.json`), "utf8");
+		} catch {
+			throw new RuntimeError("not-ready");
+		}
+		let value: BootstrapPayload;
+		try {
+			value = JSON.parse(raw) as BootstrapPayload;
+		} catch {
+			throw new RuntimeError("protocol-invalid");
+		}
+		if (value.bootstrapRef !== bootstrapRef) throw new RuntimeError("protocol-invalid");
+		return value;
+	}
+}
diff --git a/my-plugins/fsm-compatible/src/commands/command-aliases.ts b/my-plugins/fsm-compatible/src/commands/command-aliases.ts
new file mode 100644
index 000000000..b163702d0
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/commands/command-aliases.ts
@@ -0,0 +1,105 @@
+import type { ExtensionAPI, ExtensionCommandContext } from "@earendil-works/pi-coding-agent";
+
+export interface UndoState {
+	previousLeaf: string | null;
+}
+
+const UNIMPLEMENTED: readonly { readonly name: string; readonly reason: string; readonly native: string }[] = [
+	{ name: "/share", reason: "公开扩展 API 无会话网络导出/上传能力", native: "使用 Pi 原生会话导出" },
+	{ name: "/models", reason: "公开扩展 API 无模型全量管理", native: "使用 Pi 原生模型切换命令" },
+];
+
+export const IMPLEMENTED_COMMANDS: readonly string[] = ["/new", "/undo", "/redo", "/usage", "/exit"];
+
+/**
+ * Step P1: every alias performs a real public action; unimplementable OC
+ * commands are reported explicitly instead of being faked.
+ */
+export function registerCommandAliases(pi: ExtensionAPI, state: UndoState = { previousLeaf: null }): UndoState {
+	pi.registerCommand("new", {
+		description: "OC alias: start a new session",
+		// Step P4: new session resets undo state; a cancelled creation is reported as-is.
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			await ctx.waitForIdle();
+			const result = await ctx.newSession();
+			if (result.cancelled) ctx.ui.notify("new session cancelled", "warning");
+			state.previousLeaf = null;
+		},
+	});
+	pi.registerCommand("undo", {
+		description: "OC alias: step back to the previous entry",
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			await ctx.waitForIdle();
+			// Step P2: leaf -> parent; a null parent is a real refusal, not a no-op.
+			const leaf = ctx.sessionManager.getLeafId();
+			const entry = leaf === null ? undefined : ctx.sessionManager.getEntry(leaf);
+			if (!entry || entry.parentId === null) {
+				ctx.ui.notify("nothing to undo: already at the first entry", "warning");
+				return;
+			}
+			const target = entry.parentId;
+			const before = leaf;
+			try {
+				const result = await ctx.navigateTree(target);
+				if (result.cancelled) ctx.ui.notify("undo cancelled", "warning");
+				else state.previousLeaf = before;
+			} catch (error) {
+				ctx.ui.notify(`undo failed: ${error instanceof Error ? error.message : "unknown"}`, "error");
+			}
+		},
+	});
+	pi.registerCommand("redo", {
+		description: "OC alias: redo the single last undo",
+		// Step P3: single-step restore of the recorded pre-undo leaf; invalid targets clear the record.
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			await ctx.waitForIdle();
+			const target = state.previousLeaf;
+			if (target === null) {
+				ctx.ui.notify("nothing to redo: no undo recorded in this session", "warning");
+				return;
+			}
+			if (!ctx.sessionManager.getEntry(target)) {
+				state.previousLeaf = null;
+				ctx.ui.notify("redo target no longer exists", "warning");
+				return;
+			}
+			try {
+				const result = await ctx.navigateTree(target);
+				if (result.cancelled) ctx.ui.notify("redo cancelled", "warning");
+				else state.previousLeaf = null;
+			} catch (error) {
+				ctx.ui.notify(`redo failed: ${error instanceof Error ? error.message : "unknown"}`, "error");
+			}
+		},
+	});
+	pi.registerCommand("usage", {
+		description: "OC alias: show current context usage",
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			const usage = ctx.getContextUsage();
+			if (!usage) {
+				ctx.ui.notify("usage: no context usage data available", "info");
+				return;
+			}
+			ctx.ui.notify(`usage: ${JSON.stringify(usage)}`, "info");
+		},
+	});
+	pi.registerCommand("exit", {
+		description: "OC alias: gracefully shut down pi",
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			await ctx.waitForIdle();
+			ctx.shutdown();
+		},
+	});
+	pi.registerCommand("fsm-commands", {
+		description: "List fsm-compatible command aliases and unsupported OC commands",
+		async handler(_args: string, ctx: ExtensionCommandContext) {
+			const lines = [
+				`implemented: ${IMPLEMENTED_COMMANDS.join(" ")}`,
+				...UNIMPLEMENTED.map((item) => `${item.name}: ${item.reason} (${item.native})`),
+				"aliases follow the host command resolution; native pi commands are unaffected",
+			];
+			ctx.ui.notify(lines.join("\n"), "info");
+		},
+	});
+	return state;
+}
diff --git a/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts b/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts
new file mode 100644
index 000000000..86eb8e792
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/coordination/canonical-lease.ts
@@ -0,0 +1,86 @@
+import { randomUUID, createHash } from "node:crypto";
+import { lstat, mkdir, readFile, rmdir, unlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import type { HostIdentity } from "../runtime/host-identity.ts";
+
+export interface CanonicalLease {
+	readonly path: string;
+	release(): Promise<void>;
+}
+
+export function coordinationScope(): string {
+	if (!process.getuid) throw new RuntimeError("not-ready");
+	return join(tmpdir(), `pi-fsm-compatible-${process.getuid()}`, "coord");
+}
+
+async function waitForLease(signal: AbortSignal | undefined, deadline: number): Promise<void> {
+	if (signal?.aborted) throw new RuntimeError("cancelled");
+	const remaining = deadline - Date.now();
+	if (remaining <= 0) throw new RuntimeError("deadline-exceeded");
+	await new Promise<void>((resolve, reject) => {
+		const finish = () => { signal?.removeEventListener("abort", abort); resolve(); };
+		const abort = () => { clearTimeout(timer); reject(new RuntimeError("cancelled")); };
+		const timer = setTimeout(finish, Math.min(20, remaining));
+		timer.unref();
+		signal?.addEventListener("abort", abort, { once: true });
+	});
+}
+
+export async function acquireCanonicalLease(
+	scope: string,
+	host: HostIdentity,
+	tool: string,
+	rootSessionId: string,
+	deadline: number,
+	signal?: AbortSignal,
+): Promise<CanonicalLease> {
+	// Step P2: a physical-host key, never an independent per-root mutex.
+	if (!tool || !rootSessionId || !Number.isInteger(host.pid) || host.pid <= 1 || !/^[1-9][0-9]*$/.test(host.startId)) {
+		throw new RuntimeError("protocol-invalid");
+	}
+	await mkdir(scope, { recursive: true, mode: 0o700 });
+	const info = await lstat(scope);
+	if (!info.isDirectory() || info.isSymbolicLink() || (process.getuid && info.uid !== process.getuid()) || (info.mode & 0o077) !== 0) {
+		throw new RuntimeError("not-ready");
+	}
+	const base = dirname(scope);
+	const baseInfo = await lstat(base);
+	if (!baseInfo.isDirectory() || baseInfo.isSymbolicLink() || (process.getuid && baseInfo.uid !== process.getuid())) {
+		throw new RuntimeError("not-ready");
+	}
+	const digest = createHash("sha256").update(tool).digest("hex");
+	const path = join(scope, `${host.pid}-${host.startId}-${digest}`);
+	const token = randomUUID();
+	for (;;) {
+		if (signal?.aborted) throw new RuntimeError("cancelled");
+		if (Date.now() >= deadline) throw new RuntimeError("deadline-exceeded");
+		try {
+			await mkdir(path, { mode: 0o700 });
+			break;
+		} catch (error) {
+			if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw new RuntimeError("transport-failed");
+			await waitForLease(signal, deadline);
+		}
+	}
+	const ownerFile = join(path, "owner.json");
+	const ownerText = JSON.stringify({ token, pid: host.pid, startId: host.startId, rootSessionId });
+	try {
+		await writeFile(ownerFile, ownerText, { flag: "wx", mode: 0o600 });
+	} catch {
+		await rmdir(path).catch(() => undefined);
+		throw new RuntimeError("transport-failed");
+	}
+	let released = false;
+	return Object.freeze({
+		path,
+		async release() {
+			if (released) return;
+			if (await readFile(ownerFile, "utf8") !== ownerText) throw new RuntimeError("protocol-invalid");
+			await unlink(ownerFile);
+			await rmdir(path);
+			released = true;
+		},
+	});
+}
diff --git a/my-plugins/fsm-compatible/src/gates/gate-moves.ts b/my-plugins/fsm-compatible/src/gates/gate-moves.ts
new file mode 100644
index 000000000..231b9e51f
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/gates/gate-moves.ts
@@ -0,0 +1,37 @@
+import type { DaemonRequester } from "../broker/daemon-request.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+const QUESTION_TOOL = "AskUserQuestion";
+
+/** Hook gate bisection (main.rs:435-449): only an allowed question tool suppresses; everything else releases. */
+export function gateShouldSuppress(allowed: boolean, toolName: string): boolean {
+	return allowed && toolName === QUESTION_TOOL;
+}
+
+export interface GateMover {
+	readonly sessionId: string;
+	readonly agentId: string;
+}
+
+/** Best-effort main-gate move: failures are abandoned (never retried, never change a verdict). */
+export async function moveGate(request: DaemonRequester, mover: GateMover, suppress: boolean, reason: string, deadline: number): Promise<void> {
+	if (mover.agentId !== "main") return;
+	try {
+		await request({ method: "POST", path: suppress ? "/gate/suppress" : "/gate/release", deadline,
+			body: { session_id: mover.sessionId, agent_id: "main", reason } });
+	} catch {
+		// best-effort: a lost suppress under-suppresses (safe); a lost release self-heals on the next main tool.
+	}
+}
+
+export function gateRoutes(): readonly string[] { return ["/gate/suppress", "/gate/release"]; }
+
+export function isQuestionToolName(toolName: string): boolean { return toolName === QUESTION_TOOL; }
+
+export function assertGateRequestShape(body: unknown): { session_id: string; agent_id: string; reason: string } {
+	if (!body || typeof body !== "object" || typeof (body as { session_id?: unknown }).session_id !== "string"
+		|| typeof (body as { agent_id?: unknown }).agent_id !== "string" || typeof (body as { reason?: unknown }).reason !== "string") {
+		throw new RuntimeError("protocol-invalid");
+	}
+	return body as { session_id: string; agent_id: string; reason: string };
+}
diff --git a/my-plugins/fsm-compatible/src/gates/permission-gate.ts b/my-plugins/fsm-compatible/src/gates/permission-gate.ts
new file mode 100644
index 000000000..83fc48ad4
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/gates/permission-gate.ts
@@ -0,0 +1,50 @@
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import type { DaemonRequester } from "../broker/daemon-request.ts";
+import { requireDaemonOk } from "../broker/daemon-request.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+import { isFsmProjectedTool, normalizeToolCall } from "./tool-normalizer.ts";
+import { gateShouldSuppress, moveGate } from "./gate-moves.ts";
+
+export interface GateBinding {
+	readonly sessionId: string;
+	readonly agentId: string;
+}
+
+function checkBody(binding: GateBinding, toolName: string, toolInput: Record<string, unknown>) {
+	return { session_id: binding.sessionId, agent_id: binding.agentId, tool_name: toolName, tool_input: toolInput };
+}
+
+async function callCheckPermission(request: DaemonRequester, body: Record<string, unknown>, deadline: number, signal?: AbortSignal): Promise<{ allowed: boolean; reason?: string }> {
+	const reply = await request({ method: "POST", path: "/check-permission", deadline,
+		...(signal ? { signal } : {}), body });
+	requireDaemonOk(reply);
+	const payload = reply.body;
+	if (!isAdmissionObject(payload) || typeof payload.allowed !== "boolean"
+		|| (payload.reason !== undefined && typeof payload.reason !== "string")) throw new RuntimeError("protocol-invalid");
+	return { allowed: payload.allowed, ...(payload.reason !== undefined ? { reason: payload.reason } : {}) };
+}
+
+/** fail-close permission gate: any transport/parse failure blocks the call. */
+export function installPermissionGate(pi: ExtensionAPI, request: DaemonRequester, binding: () => GateBinding | undefined, timeoutMs: number): () => void {
+	const off = pi.on("tool_call", async (event: { toolName: string; input: unknown }, ctx) => {
+		const current = binding();
+		if (!current) return { block: true, reason: "fsm-compatible runtime not ready" };
+		// FSM-projected tools skip both the check and the gate move (broker is the sole entry).
+		if (isFsmProjectedTool(event.toolName)) return undefined;
+		if (typeof event.toolName !== "string") return { block: true, reason: "unknown tool" };
+		try {
+			// Step P3: normalize -> real server decision -> block or allow; never a local verdict.
+			const normalized = normalizeToolCall({ toolName: event.toolName, input: event.input });
+			const verdict = await callCheckPermission(request, checkBody(current, normalized.toolName, normalized.toolInput), Date.now() + timeoutMs, ctx.signal);
+			// Step P2/fsm-5: main-gate bisection rides every verdict; best-effort, never a second verdict source.
+			const suppress = gateShouldSuppress(verdict.allowed, normalized.toolName);
+			void moveGate(request, current, suppress, suppress ? "ask-start" : "main-tool-start", Date.now() + timeoutMs);
+			if (verdict.allowed) return undefined;
+			return { block: true, reason: verdict.reason ?? `FSM 门禁：工具 ${normalized.toolName} 不允许使用。` };
+		} catch {
+			return { block: true, reason: "FSM 门禁：check-permission 不可达，按 fail-close 拒绝。" };
+		}
+	});
+	return off;
+}
diff --git a/my-plugins/fsm-compatible/src/gates/stop-gate.ts b/my-plugins/fsm-compatible/src/gates/stop-gate.ts
new file mode 100644
index 000000000..7bac1ab4c
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/gates/stop-gate.ts
@@ -0,0 +1,56 @@
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import type { DaemonRequester } from "../broker/daemon-request.ts";
+import { requireDaemonOk } from "../broker/daemon-request.ts";
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import type { GateBinding } from "./permission-gate.ts";
+
+export interface StopDecision {
+	readonly allowed: boolean;
+	readonly reason?: string;
+}
+
+function lastAssistantText(messages: readonly AgentMessage[]): string | undefined {
+	for (let index = messages.length - 1; index >= 0; index--) {
+		const message = messages[index] as { role?: string; content?: unknown };
+		if (message?.role !== "assistant") continue;
+		if (!Array.isArray(message.content)) return undefined;
+		const text = message.content.filter((block): block is { type: "text"; text: string } =>
+			isAdmissionObject(block) && block.type === "text" && typeof block.text === "string")
+			.map((block) => block.text).join("\n");
+		return text.length > 0 ? text : undefined;
+	}
+	return undefined;
+}
+
+export async function runStopCheck(request: DaemonRequester, binding: GateBinding, contextMessages: readonly AgentMessage[], deadline: number): Promise<StopDecision> {
+	const text = lastAssistantText(contextMessages);
+	const reply = await request({ method: "POST", path: "/stop-check", deadline, body: {
+		session_id: binding.sessionId, agent_id: binding.agentId,
+		...(text !== undefined ? { last_assistant_message: text } : {}),
+	} });
+	requireDaemonOk(reply);
+	const payload = reply.body;
+	if (!isAdmissionObject(payload) || typeof payload.allowed !== "boolean") throw new Error("stop-check protocol-invalid");
+	return { allowed: payload.allowed,
+		...(payload.reason !== undefined && typeof payload.reason === "string" ? { reason: payload.reason } : {}) };
+}
+
+/** soft-gate Stop: transport failure passes with a diagnostic; real blocks append a continuation entry. */
+export function installStopGate(pi: ExtensionAPI, request: DaemonRequester, binding: () => GateBinding | undefined, timeoutMs: number): () => void {
+	const off = pi.on("agent_before_settle", async (event, ctx) => {
+		const current = binding();
+		if (!current) return undefined;
+		if (event.outcome !== "completed" || event.continue) return undefined;
+		try {
+			const decision = await runStopCheck(request, current, event.context.contextMessages, Date.now() + timeoutMs);
+			if (decision.allowed) return undefined;
+			return { entries: [{ type: "custom_message" as const, customType: "fsm-compatible:stop",
+				content: decision.reason ?? "FSM Stop: continue required", display: true }], continue: true };
+		} catch {
+			ctx.ui.notify("FSM Stop gate unavailable; soft-gate pass-through", "warning");
+			return undefined;
+		}
+	});
+	return off;
+}
diff --git a/my-plugins/fsm-compatible/src/gates/tool-normalizer.ts b/my-plugins/fsm-compatible/src/gates/tool-normalizer.ts
new file mode 100644
index 000000000..dc6b8dc00
--- /dev/null
+++ b/my-plugins/fsm-compatible/src/gates/tool-normalizer.ts
@@ -0,0 +1,62 @@
+import { isAdmissionObject } from "../admission/parse-policy-input.ts";
+import { RuntimeError } from "../runtime/runtime-error.ts";
+
+export interface NormalizedToolCall {
+	readonly toolName: string;
+	readonly toolInput: Record<string, unknown>;
+}
+export type ToolCallLike = { readonly toolName: string; readonly input: unknown };
+
+function pick(source: Record<string, unknown>, key: string): Record<string, unknown> {
+	return source[key] === undefined ? {} : { [key]: source[key] };
+}
+
+/**
+ * Step P3: renames and carries fields only — never invents values, never drops
+ * the checked path. Unknown tools pass through with their real names.
+ */
+export function normalizeToolCall(call: ToolCallLike): NormalizedToolCall {
+	const name = call.toolName;
+	const input = isAdmissionObject(call.input) ? call.input : {};
+	const copy = <T>(value: T): T => structuredClone(value);
+	switch (name) {
+		case "read":
+			return { toolName: "read", toolInput: {
+				...(input.path !== undefined ? { filePath: input.path } : {}),
+				...pick(input, "offset"), ...pick(input, "limit"),
+			} };
+		case "bash":
+			return { toolName: "bash", toolInput: copy(input) };
+		case "write":
+			return { toolName: "write", toolInput: { ...(input.path !== undefined ? { filePath: input.path } : {}), ...pick(input, "content") } };
+		case "grep":
+			return { toolName: "grep", toolInput: { ...pick(input, "pattern"), ...pick(input, "path"), ...(input.glob === undefined ? {} : { include: input.glob }) } };
+		case "find":
+			return { toolName: "glob", toolInput: { ...pick(input, "pattern"), ...pick(input, "path") } };
+		case "ls":
+		case "powershell":
+			return name === "ls" ? { toolName: "ls", toolInput: copy(input) } : { toolName: "bash", toolInput: { ...pick(input, "command") } };
+		case "edit": {
+			if (Array.isArray(input.edits)) {
+				const edits = input.edits.map((entry) => {
+					if (!isAdmissionObject(entry) || typeof entry.oldText !== "string" || typeof entry.newText !== "string") {
+						throw new RuntimeError("protocol-invalid");
+					}
+					return { oldString: entry.oldText, newString: entry.newText };
+				});
+				return { toolName: "edit", toolInput: { ...(input.path !== undefined ? { filePath: input.path } : {}), edits } };
+			}
+			return { toolName: "edit", toolInput: {
+				...(input.path !== undefined ? { filePath: input.path } : {}),
+				...(typeof input.oldText === "string" ? { oldString: input.oldText } : {}),
+				...(typeof input.newText === "string" ? { newString: input.newText } : {}),
+			} };
+		}
+		default:
+			return { toolName: name, toolInput: copy(input) };
+	}
+}
+
+export function isFsmProjectedTool(toolName: string): boolean {
+	return toolName.startsWith("mcp__fsm__");
+}
