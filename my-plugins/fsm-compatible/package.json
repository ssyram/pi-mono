{
  "name": "fsm-compatible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin-only FSM compatibility for official Pi",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build:identity": "node scripts/build-host-identity.mjs",
    "test:admission": "node --test test/admission-policy.test.ts test/actor-binding.test.ts test/admission-binding-schema.test.ts",
    "test:runtime": "node --test test/root-health.test.ts test/host-identity.test.ts test/canonical-lease.test.ts test/broker-protocol.test.ts test/runtime-resources.test.ts test/fsm-tools.test.ts test/broker-channel.test.ts test/broker-cancellation.test.ts",
    "test:judge": "node --test test/judge-input.test.ts test/capture-turn.test.ts test/judge-file-tools.test.ts test/judge-session.test.ts",
    "test:gates": "node --test test/tool-normalizer.test.ts test/gates.test.ts",
    "test:protocol": "node --test test/oc-records.test.ts test/oc-roster.test.ts test/oc-server.test.ts test/oc-handlers.test.ts",
    "test:binary": "node --test test/fsm-binary-protocol.test.ts",
    "test:children": "node --test test/child-launch.test.ts test/child-bootstrap.test.ts test/agent-tool.test.ts",
    "test:watch": "node --test test/gate-moves.test.ts test/watch.test.ts",
    "test:assembly": "node --test test/assembly.test.ts",
    "test:commands": "node --test test/command-aliases.test.ts",
    "test": "npm run test:admission && npm run test:runtime && npm run test:protocol && npm run test:judge && npm run test:gates && npm run test:children && npm run test:watch && npm run test:assembly && npm run test:commands"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-codemode": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3"
  }
}
